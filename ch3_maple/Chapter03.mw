<Text-field prompt="&gt; " style="Maple Input" layout="Normal">plots[display]([linearPlot,binaryPlot],title=&quot;Average-case complexity of search algorithms&quot;,labels=[&quot;size of input list&quot;,&quot;average number of comparisons&quot;],labeldirections=[horizontal,vertical]);</Text-field>
</Input>
<Output>
<Text-field style="Maple Plot" layout="Maple Plot"><Plot height="270" type="two-dimensional" width="270" gridlinevisibility="1" legendvisibility="true"></Plot></Text-field>
</Output>
</Group></Presentation-Block><Presentation-Block>
<Group view="presentation" hide-input="false" hide-output="true" inline-output="false" labelreference="L416" drawlabel="true">
