<Group autoexecute="true" labelreference="L455" drawlabel="true">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">binaryPlot := plot(nList,binaryAverages,color=red,view=[1..100,1..102],legend=&quot;binary&quot;):</Text-field>
</Input>
