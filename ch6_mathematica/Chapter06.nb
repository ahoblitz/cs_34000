Cell["\<\
The reader is left to apply the function to the cases called for in the \
problem and to conjecture a general formula.\
\>", "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["Computations and Explorations 3", "Subsection",
 CellTags->"SolutionsCE3"],

Cell[TextData[{
 "Verify that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"C", "(", 
    RowBox[{
     RowBox[{"2", "n"}], ",", "n"}], ")"}], TraditionalForm]]],
 " is divisible by the square of a prime, when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"n", "\[NotEqual]", "1"}], ",", "2", ",", " ", 
    RowBox[{"or", " ", "4"}]}], TraditionalForm]]],
 ", for as many positive integers ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " as you can. [The theorem that tells that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"C", "(", 
    RowBox[{
     RowBox[{"2", "n"}], ",", "n"}], ")"}], TraditionalForm]]],
 " is divisible by the square of a prime for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"n", "\[NotEqual]", "1"}], ",", "2", ",", 
    RowBox[{"or", " ", "4"}]}], TraditionalForm]]],
 " was proved in 1996 by Andrew Granville and Olivier Ramar\[EAcute]. Their \
proof settled a conjecture made in 1980 by Paul Erd\[ODoubleDot]s and Ron \
Graham.]"
}], "Problem"],

Cell[TextData[{
 StyleBox["Solution:",
  FontSlant->"Italic"],
 " We will first consider one example to see exactly what we need to do. Then \
we will write a general function. Consider ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", "3"}], TraditionalForm]]],
 ", the smallest ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " for which the theorem is true."
}], "Text"],

Cell[TextData[{
 "First, compute ",
 Cell[BoxData[
  FormBox[
   RowBox[{"C", "(", 
    RowBox[{
     RowBox[{"2", "n"}], ",", "n"}], ")"}], TraditionalForm]]],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", "3"}], TraditionalForm]]],
 "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"c3", "=", 
  RowBox[{"Binomial", "[", 
   RowBox[{"6", ",", "3"}], "]"}]}]], "Input",
 InitializationCell->True],

Cell[BoxData["20"], "Output"]
}, Open  ]],

Cell[TextData[{
 "To determine whether or not ",
 Cell[BoxData[
  FormBox[
   RowBox[{"C", "(", 
    RowBox[{
     RowBox[{"2", "n"}], ",", "n"}], ")"}], TraditionalForm]]],
 " is divisible by the square of a prime, we could look at its prime \
factorization. If any of the exponents in the prime factorization are 2 or \
greater, then we know the number is divisible by the square of the \
corresponding prime."
}], "Text"],

Cell[TextData[{
 "We can use the function ",
 StyleBox[ButtonBox["FactorInteger",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/FactorInteger"], "FunctionLink"],
 " (first discussed in Section 4.3 of this manual). The ",
 StyleBox[ButtonBox["FactorInteger",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/FactorInteger"], "FunctionLink"],
 " function requires one argument, an integer. Its output is a list of the \
form ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["p", "1"], ",", 
       SubscriptBox["e", "1"]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["p", "2"], ",", 
       SubscriptBox["e", "2"]}], "}"}], ",", "\[Ellipsis]", ",", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["p", "m"], ",", 
       SubscriptBox["e", "m"]}], "}"}]}], "}"}], TraditionalForm]]],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["p", "1"], ",", 
    SubscriptBox["p", "2"], ",", "\[Ellipsis]", ",", 
    SubscriptBox["p", "m"]}], TraditionalForm]]],
 " are the primes in the prime factorization and the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["e", "1"], ",", 
    SubscriptBox["e", "2"], ",", "\[Ellipsis]", ",", 
    SubscriptBox["e", "m"]}], TraditionalForm]]],
 " are the corresponding exponents."
}], "Text"],

Cell[TextData[{
 "Apply ",
 StyleBox[ButtonBox["FactorInteger",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/FactorInteger"], "FunctionLink"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"C", "(", 
    RowBox[{"6", ",", "3"}], ")"}], TraditionalForm]]],
 "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FactorInteger", "[", "c3", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"5", ",", "1"}], "}"}]}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "The result tells us that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"C", "(", 
     RowBox[{"6", ",", "3"}], ")"}], "=", 
    RowBox[{
     SuperscriptBox["2", "2"], "\[CenterDot]", 
     SuperscriptBox["5", "1"]}]}], TraditionalForm]]],
 "."
}], "Text"],

Cell[TextData[{
 "We are interested in the exponents of the primes. To extract the second \
element of each pair, we can apply the ",
 StyleBox[ButtonBox["Part",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Part"], "FunctionLink"],
 " (",
 StyleBox["[[\[Ellipsis]]]", "Input"],
 ") operator with the part specification ",
 StyleBox["All,2", "Input"],
 "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"FactorInteger", "[", "c3", "]"}], "[", 
  RowBox[{"[", 
   RowBox[{"All", ",", "2"}], "]"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "1"}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "Given the list of exponents, determining whether or not ",
 Cell[BoxData[
  FormBox[
   RowBox[{"C", "(", 
    RowBox[{"6", ",", "3"}], ")"}], TraditionalForm]]],
 " is divisible by the square of a prime just amounts to checking whether the \
list contains a value greater than 1. "
}], "Text"],

Cell[TextData[{
 "As is so often the case, ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " provides a shortcut. The function ",
 StyleBox[ButtonBox["SquareFreeQ",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/SquareFreeQ"], "FunctionLink"],
 ", applied to an integer, outputs ",
 StyleBox[ButtonBox["True",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/True"], "FunctionLink"],
 " if the integer is not divisible by the square of a number and it returns \
",
 StyleBox[ButtonBox["False",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/False"], "FunctionLink"],
 " if the integer is divisible by a square. "
}], "Text"],

Cell[TextData[{
 "For the example ",
 Cell[BoxData[
  FormBox[
   RowBox[{"C", "(", 
    RowBox[{"6", ",", "3"}], ")"}], TraditionalForm]]],
 ", ",
 StyleBox[ButtonBox["SquareFreeQ",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/SquareFreeQ"], "FunctionLink"],
 " will output ",
 StyleBox[ButtonBox["False",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/False"], "FunctionLink"],
 " since 20 is divisible by ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "2"], TraditionalForm]]],
 "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SquareFreeQ", "[", "c3", "]"}]], "Input"],

Cell[BoxData["False"], "Output"]
}, Open  ]],

Cell[TextData[{
 "Note that ",
 StyleBox[ButtonBox["SquareFreeQ",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/SquareFreeQ"], "FunctionLink"],
 " returns ",
 StyleBox[ButtonBox["False",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/False"], "FunctionLink"],
 " when the assertion is verified and ",
 StyleBox[ButtonBox["True",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/True"], "FunctionLink"],
 " when the assertion fails, such as for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", "4"}], TraditionalForm]]],
 "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SquareFreeQ", "[", 
  RowBox[{"Binomial", "[", 
   RowBox[{"8", ",", "4"}], "]"}], "]"}]], "Input"],

Cell[BoxData["True"], "Output"]
}, Open  ]],

Cell[TextData[{
 "The problem was to verify the conjecture for \[OpenCurlyDoubleQuote]as many \
positive integers ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " as you can.\[CloseCurlyDoubleQuote] We will use the ",
 StyleBox[ButtonBox["TimeConstrained",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/TimeConstrained"], "FunctionLink"],
 " function to run the test for a specified amount of time. The second \
argument of ",
 StyleBox[ButtonBox["TimeConstrained",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/TimeConstrained"], "FunctionLink"],
 " is an amount of time, in seconds, that bounds the time that ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " will spend executing the first argument. For the first argument, we will \
use an infinite loop that will display values of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " for which the statement is found to be false. ",
 StyleBox[ButtonBox["TimeConstrained",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/TimeConstrained"], "FunctionLink"],
 " takes an optional third argument that is evaluated if the allotted time \
expires. We will use this argument to display the maximum value of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " for which the statement was checked. Note that this maximum ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " must be one less than the index used in the loop."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TimeConstrained", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"n", "=", "1"}], ";", "\[IndentingNewLine]", 
    RowBox[{"While", "[", 
     RowBox[{"True", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"SquareFreeQ", "[", 
          RowBox[{"Binomial", "[", 
           RowBox[{
            RowBox[{"2", "*", "n"}], ",", "n"}], "]"}], "]"}], ",", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<Found counterexample: \>\"", ",", "n"}], "]"}]}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"n", "++"}]}]}], "\[IndentingNewLine]", "]"}]}], ",", 
   "\[IndentingNewLine]", "1", " ", ",", 
   RowBox[{"(*", " ", 
    RowBox[{"1", " ", "second", " ", "limit"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Checked through n=\>\"", ",", 
     RowBox[{"n", "-", "1"}]}], "]"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Found counterexample: \"\>", "\[InvisibleSpace]", "1"}],
  SequenceForm["Found counterexample: ", 1],
  Editable->False]], "Print"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Found counterexample: \"\>", "\[InvisibleSpace]", "2"}],
  SequenceForm["Found counterexample: ", 2],
  Editable->False]], "Print"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Found counterexample: \"\>", "\[InvisibleSpace]", "4"}],
  SequenceForm["Found counterexample: ", 4],
  Editable->False]], "Print"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Checked through n=\"\>", "\[InvisibleSpace]", "8825"}],
  SequenceForm["Checked through n=", 8825],
  Editable->False]], "Print"]
}, Open  ]]
}, Open  ]]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Exercises", "Section",
 CellTags->"Exercises"],

Cell[CellGroupData[{

Cell[TextData[{
 "Build a recursive version of ",
 StyleBox["subsetSumCount", "Input"],
 ", using the ideas of ",
 StyleBox["findBitStrings", "Input"],
 ". Your function should determine all subsets of a given set whose sum is \
less than a target value. Rather than considering all sets, it should build \
potential sets recursively using the fact that once a set has sum larger than \
the target no larger set of positive integers can have smaller sum. Compare \
the performance of your procedure with ",
 StyleBox["subsetSumCount", "Input"],
 "."
}], "Item1Exercise"],

Cell[TextData[{
 "Create a function ",
 StyleBox["findDecreasing", "Input"],
 " by modifying ",
 StyleBox["findIncreasing", "Input"],
 " in order to determine a strictly decreasing subsequence of maximal \
length."
}], "Item1Exercise"],

Cell[TextData[{
 "Modify the Patience algorithm to find ",
 StyleBox["all",
  FontSlant->"Italic"],
 " of the strictly increasing subsequences of maximal length. "
}], "Item1Exercise"],

Cell[TextData[{
 "Use ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " to show that, in Example 11 of Section 6.2, ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " positive integers not exceeding ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "n"}], TraditionalForm]]],
 " are not sufficient to guarantee that one integer divides one of the others."
}], "Item1Exercise"],

Cell[TextData[{
 "Use ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " to determine how many different strings can be made from the word \
\[OpenCurlyDoubleQuote]PAPARAZZI\[CloseCurlyDoubleQuote] when all the letters \
are used, when any number of letters are used, when all the letters are used \
and the string begins and ends with the letter \[OpenCurlyDoubleQuote]Z\
\[CloseCurlyDoubleQuote], and when all the letters are used and the three \
\[OpenCurlyDoubleQuote]A\[CloseCurlyDoubleQuote]s are consecutive."
}], "Item1Exercise"],

Cell[TextData[{
 "Suppose that a certain Mathematics Department has ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]]],
 " male faculty and ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]]],
 " female faculty. Write a ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " function to find all committees with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "k"}], TraditionalForm]]],
 " members in which both sexes are represented equally."
}], "Item1Exercise"],

Cell[TextData[{
 "Use ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " to prove the identity"
}], "Item1Exercise"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"(", GridBox[{
      {
       RowBox[{"n", "+", "1"}]},
      {"k"}
     }], ")"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"n", "+", "1"}], "k"], 
    RowBox[{"(", GridBox[{
       {"n"},
       {
        RowBox[{"k", "-", "1"}]}
      }], ")"}]}]}], TraditionalForm]], "ExerciseEquation"],

Cell[TextData[{
 "for positive integers ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "\[LessEqual]", "n"}], TraditionalForm]]],
 "."
}], "ExerciseContinuation"],

Cell[TextData[{
 "Use ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " to prove Pascal's identity:"
}], "Item1Exercise"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"(", GridBox[{
      {
       RowBox[{"n", "+", "1"}]},
      {"k"}
     }], ")"}], "=", 
   RowBox[{
    RowBox[{"(", GridBox[{
       {"n"},
       {
        RowBox[{"k", "-", "1"}]}
      }], ")"}], "+", 
    RowBox[{"(", GridBox[{
       {"n"},
       {"k"}
      }], ")"}]}]}], TraditionalForm]], "ExerciseEquation"],

Cell[TextData[{
 "for all positive integers ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "\[LessEqual]", "n"}], TraditionalForm]]],
 "."
}], "ExerciseContinuation"],

Cell[TextData[{
 "Use ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " to generate many rows of Pascal's triangle. See if you can formulate any \
conjectures involving identities satisfied by the binomial coefficients. Use ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " to help you verify that your conjecture is true by using the techniques at \
the end of Section 6.4 of this manual."
}], "Item1Exercise"],

Cell[TextData[{
 "Write a function that mixes the techniques used in ",
 StyleBox["binomialF", "Input"],
 " and ",
 StyleBox["binomialR", "Input"],
 " to generate the rows of Pascal's triangle from row ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]]],
 " to row ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]]],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", ">", "a", ">", "0"}], TraditionalForm]]],
 "."
}], "Item1Exercise"],

Cell[TextData[{
 "Use ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " to count and list all solutions to the equation"
}], "Item1Exercise"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["x", "1"], "+", 
    SubscriptBox["x", "2"], "+", 
    SubscriptBox["x", "3"], "+", 
    SubscriptBox["x", "4"]}], "=", "25"}], 
  TraditionalForm]], "ExerciseEquation"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "1"], ",", 
    SubscriptBox["x", "2"], ",", 
    SubscriptBox["x", "3"], ",", " ", 
    RowBox[{"and", " ", 
     SubscriptBox["x", "4"]}]}], TraditionalForm]]],
 " are non-negative integers. Also count and list all solutions such that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["x", "1"], "\[GreaterEqual]", "1"}], ",", 
    RowBox[{
     SubscriptBox["x", "2"], "\[GreaterEqual]", "2"}], ",", 
    RowBox[{
     SubscriptBox["x", "3"], "\[GreaterEqual]", "3"}], ",", 
    RowBox[{
     RowBox[{"and", " ", 
      SubscriptBox["x", "4"]}], "\[GreaterEqual]", "4"}]}], TraditionalForm]]],
 "."
}], "ExerciseContinuation"],

Cell["\<\
Generate a large triangle of Stirling numbers of the second kind and look for \
patterns that suggest identities among the Stirling numbers. Also see if you \
can make any conjectures about the relationship between Stirling numbers and \
the binomial coefficients. \
\>", "Item1Exercise"],

Cell["\<\
Implement the algorithm described in the \[OpenCurlyDoubleQuote]Generating \
partitions\[CloseCurlyDoubleQuote] subsection of Section 6.5 of this manual.\
\>", "Item1Exercise"],

Cell[TextData[{
 "Write a ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " function that takes as input three positive integers ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 ", ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 ", and ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]]],
 ", and returns the ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]]],
 "th multinomial, in lexicographic order, of the polynomial ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["x", "1"], "+", 
      SubscriptBox["x", "2"], "+", "\[CenterEllipsis]", "+", 
      SubscriptBox["x", "k"]}], ")"}], "n"], TraditionalForm]]],
 ". Write its inverse; that is, given a multinomial, the inverse should \
return its index (position) in the sorted polynomial."
}], "Item1Exercise"],

Cell["\<\
Implement Algorithm 2 of Section 6.6 for generating the next largest bit \
string. \
\>", "Item1Exercise"],

Cell[TextData[{
 "Implement Algorithm 3 of Section 6.6 for generating the next ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]]],
 "-combination. "
}], "Item1Exercise"],

Cell[TextData[{
 "Write a ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " function to compute the Cantor expansion of an integer. (See the prelude \
to Exercise 14 of Section 6.6 of the text.)"
}], "Item1Exercise"],

Cell[TextData[{
 "Implement the algorithm for generating the set of all permutations of the \
first ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " integers using the bijection from the collection of all permutations of \
the set ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "\[Ellipsis]", ",", "n"}], "}"}], 
   TraditionalForm]]],
 " to the set ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "\[Ellipsis]", ",", 
     RowBox[{"n", "!"}]}], "}"}], TraditionalForm]]],
 " described prior to Exercise 14 of Section 6.6 of the textbook. \:fffc"
}], "Item1Exercise"]
}, Open  ]]
}, Closed]]
}, Open  ]]
},
