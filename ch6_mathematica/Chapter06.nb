   RowBox[{"{", 
    RowBox[{"\<\"c\"\>", ",", "\<\"c\"\>", ",", "\<\"b\"\>", 
     ",", "\<\"c\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"c\"\>", ",", "\<\"c\"\>", ",", "\<\"c\"\>", 
     ",", "\<\"a\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"c\"\>", ",", "\<\"c\"\>", ",", "\<\"c\"\>", 
     ",", "\<\"b\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"c\"\>", ",", "\<\"c\"\>", ",", "\<\"c\"\>", 
     ",", "\<\"c\"\>"}], "}"}]}], "}"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Length", "[", "abcRepeated", "]"}]], "Input"],

Cell[BoxData["81"], "Output"]
}, Open  ]],

Cell[TextData[{
 "Note that the size of the list produced by ",
 StyleBox[ButtonBox["Permutations",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Permutations"], "FunctionLink"],
 " agrees with the answer given by the formula ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["n", "r"], TraditionalForm]]],
 "."
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["Combinations with Repetition", "Subsection",
 CellTags->"Section5b"],

Cell[TextData[{
 "Combinations with repetition can be handled in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " in much the same way as permutations with repetition are."
}], "Text"],

Cell[TextData[{
 "Theorem 2 of Section 6.5, asserts that the number of ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]]],
 "-combinations of a set of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " objects when repetition of elements is allowed is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"C", "(", 
    RowBox[{
     RowBox[{"n", "+", "r", "-", "1"}], ",", "r"}], ")"}], 
   TraditionalForm]]],
 ". This suggests the following useful function."
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CRep", "[", 
    RowBox[{"n_Integer", ",", "r_Integer"}], "]"}], "/;", 
   RowBox[{
    RowBox[{"n", ">", "0"}], "&&", 
    RowBox[{"r", "\[GreaterEqual]", "0"}]}]}], ":=", 
  RowBox[{"Binomial", "[", 
   RowBox[{
    RowBox[{"n", "+", "r", "-", "1"}], ",", "r"}], "]"}]}]], "Input",
 InitializationCell->True],

Cell["\<\
Thus we can compute, for example, the number of ways to select five bills \
from a cash box with seven types of bills (Example 3) as follows. \
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CRep", "[", 
  RowBox[{"7", ",", "5"}], "]"}]], "Input"],

Cell[BoxData["462"], "Output"]
}, Open  ]],

Cell[TextData[{
 "We can also make use of the ",
 StyleBox[ButtonBox["Subsets",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Subsets"], "FunctionLink"],
 " function similar to how ",
 StyleBox[ButtonBox["Permutations",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Permutations"], "FunctionLink"],
 " was used above."
}], "Text"],

Cell[TextData[{
 "Consider Example 2 from Section 6.5. In this example, we are given a bowl \
of apples, oranges, and pears and are to select four pieces of fruit from the \
bowl provided that it contains at least four pieces of each kind of fruit. We \
have two ways to solve this problem with ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ". "
}], "Text"],

Cell[TextData[{
 "First, we can use the ",
 StyleBox["CRep", "Input"],
 " function we created."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CRep", "[", 
  RowBox[{"3", ",", "4"}], "]"}]], "Input"],

Cell[BoxData["15"], "Output"]
}, Open  ]],

Cell[TextData[{
 "The other approach is to use ",
 StyleBox[ButtonBox["Subsets",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Subsets"], "FunctionLink"],
 " to list all the options. We form the argument to ",
 StyleBox[ButtonBox["Subsets",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Subsets"], "FunctionLink"],
 " in the same way as in the last subsection. However, the difference between \
",
 StyleBox[ButtonBox["Subsets",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Subsets"], "FunctionLink"],
 " and ",
 StyleBox[ButtonBox["Permutations",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Permutations"], "FunctionLink"],
 " is that ",
 StyleBox[ButtonBox["Subsets",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Subsets"], "FunctionLink"],
 " treats repeated objects as distinct. This means that combinations will be \
repeated. For example, consider the following."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Subsets", "[", 
  RowBox[{"{", 
   RowBox[{"\"\<a\>\"", ",", "\"\<b\>\"", ",", "\"\<b\>\""}], "}"}], 
  "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "\<\"a\"\>", "}"}], ",", 
   RowBox[{"{", "\<\"b\"\>", "}"}], ",", 
   RowBox[{"{", "\<\"b\"\>", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"a\"\>", ",", "\<\"b\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"a\"\>", ",", "\<\"b\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"b\"\>", ",", "\<\"b\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"a\"\>", ",", "\<\"b\"\>", ",", "\<\"b\"\>"}], "}"}]}], 
  "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "The subsets ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "b", "}"}], TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"a", ",", "b"}], "}"}], TraditionalForm]]],
 " appear twice because ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " considered the two \[OpenCurlyDoubleQuote]b\[CloseCurlyDoubleQuote]s in \
the input to be different from each other. So one ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "b", "}"}], TraditionalForm]]],
 " in the output is from the first \[OpenCurlyDoubleQuote]b\
\[CloseCurlyDoubleQuote] in the input, and the other ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "b", "}"}], TraditionalForm]]],
 " is the second \[OpenCurlyDoubleQuote]b\[CloseCurlyDoubleQuote] in the \
input. To eliminate these redundancies, we can apply ",
 StyleBox[ButtonBox["DeleteDuplicates",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/DeleteDuplicates"], "FunctionLink"],
 ", a function that removes duplicate elements from a list."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DeleteDuplicates", "[", 
  RowBox[{"Subsets", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<a\>\"", ",", "\"\<b\>\"", ",", "\"\<b\>\""}], "}"}], "]"}], 
  "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "\<\"a\"\>", "}"}], ",", 
   RowBox[{"{", "\<\"b\"\>", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"a\"\>", ",", "\<\"b\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"b\"\>", ",", "\<\"b\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"a\"\>", ",", "\<\"b\"\>", ",", "\<\"b\"\>"}], "}"}]}], 
  "}"}]], "Output"]
}, Open  ]],

Cell["\<\
To answer the question about the bowl of fruit, we enter the following.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DeleteDuplicates", "[", 
  RowBox[{"Subsets", "[", 
   RowBox[{
    RowBox[{"Join", "@@", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"ConstantArray", "[", 
        RowBox[{"i", ",", "4"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"{", 
          RowBox[{
          "\"\<apple\>\"", ",", "\"\<pear\>\"", ",", "\"\<orange\>\""}], 
          "}"}]}], "}"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", "4", "}"}]}], "\[IndentingNewLine]", "]"}], 
  "\[IndentingNewLine]", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\<\"apple\"\>", ",", "\<\"apple\"\>", ",", "\<\"apple\"\>", 
     ",", "\<\"apple\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"apple\"\>", ",", "\<\"apple\"\>", ",", "\<\"apple\"\>", 
     ",", "\<\"pear\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"apple\"\>", ",", "\<\"apple\"\>", ",", "\<\"apple\"\>", 
     ",", "\<\"orange\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"apple\"\>", ",", "\<\"apple\"\>", ",", "\<\"pear\"\>", 
     ",", "\<\"pear\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"apple\"\>", ",", "\<\"apple\"\>", ",", "\<\"pear\"\>", 
     ",", "\<\"orange\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"apple\"\>", ",", "\<\"apple\"\>", ",", "\<\"orange\"\>", 
     ",", "\<\"orange\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"apple\"\>", ",", "\<\"pear\"\>", ",", "\<\"pear\"\>", 
     ",", "\<\"pear\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"apple\"\>", ",", "\<\"pear\"\>", ",", "\<\"pear\"\>", 
     ",", "\<\"orange\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"apple\"\>", ",", "\<\"pear\"\>", ",", "\<\"orange\"\>", 
     ",", "\<\"orange\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"apple\"\>", ",", "\<\"orange\"\>", ",", "\<\"orange\"\>", 
     ",", "\<\"orange\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"pear\"\>", ",", "\<\"pear\"\>", ",", "\<\"pear\"\>", 
     ",", "\<\"pear\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"pear\"\>", ",", "\<\"pear\"\>", ",", "\<\"pear\"\>", 
     ",", "\<\"orange\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"pear\"\>", ",", "\<\"pear\"\>", ",", "\<\"orange\"\>", 
     ",", "\<\"orange\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"pear\"\>", ",", "\<\"orange\"\>", ",", "\<\"orange\"\>", 
     ",", "\<\"orange\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"orange\"\>", ",", "\<\"orange\"\>", ",", "\<\"orange\"\>", 
     ",", "\<\"orange\"\>"}], "}"}]}], "}"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Length", "[", "%", "]"}]], "Input"],

Cell[BoxData["15"], "Output"]
}, Open  ]],

Cell[TextData[{
 "Pay careful attention to the difference between ",
 StyleBox[ButtonBox["Permutations",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Permutations"], "FunctionLink"],
 " and ",
 StyleBox[ButtonBox["Subsets",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Subsets"], "FunctionLink"],
 ". ",
 StyleBox[ButtonBox["Permutations",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Permutations"], "FunctionLink"],
 " considered repeated elements to be identical, while ",
 StyleBox[ButtonBox["Subsets",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Subsets"], "FunctionLink"],
 " treats them as distinct."
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["Permutations with Indistinguishable Objects", "Subsection",
 CellTags->"Section5c"],

Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " handles permutations with indistinguishable objects in the same way as \
when repetition is allowed. The ",
 StyleBox[ButtonBox["Permutations",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Permutations"], "FunctionLink"],
 " function accepts a list of objects as its first argument. If objects in \
the list are repeated, ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " considers them as indistinguishable and produces the permutations \
appropriately."
}], "Text"],

Cell[TextData[{
 "For example, to solve Example 7, finding the number of different strings \
that can be made from the letters of the word SUCCESS, we use the list ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"{", 
     RowBox[{
     "\"\<S\>\"", ",", "\"\<U\>\"", ",", "\"\<C\>\"", ",", "\"\<C\>\"", ",", 
      "\"\<E\>\"", ",", "\"\<S\>\"", ",", "\"\<S\>\""}], "}"}], "Input"], 
   TraditionalForm]]],
 " as the argument to ",
 StyleBox[ButtonBox["Permutations",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Permutations"], "FunctionLink"],
 ". Since we are only interested in the number of permutations, we apply ",
 StyleBox[ButtonBox["Length",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Length"], "FunctionLink"],
 " as well."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Length", "[", 
  RowBox[{"Permutations", "[", 
   RowBox[{"{", 
    RowBox[{
    "\"\<S\>\"", ",", "\"\<U\>\"", ",", "\"\<C\>\"", ",", "\"\<C\>\"", ",", 
     "\"\<E\>\"", ",", "\"\<S\>\"", ",", "\"\<S\>\""}], "}"}], "]"}], 
  "]"}]], "Input"],

Cell[BoxData["420"], "Output"]
}, Open  ]],

Cell["\<\
Observe that this gives the same result as the formula given in Theorem 3. \
\>", "Text"],

Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " makes it easy to go a bit further than Theorem 3, which is restricted to \
the situation when you are permuting all ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " objects. To find the number of ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]]],
 "-permutations of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " objects where some objects are indistinguishable, you give ",
 StyleBox["{r}", "Input"],
 " as the second argument."
}], "Text"],

Cell["\<\
For example, the strings of length 3 that can be made from the letters of the \
word SUCCESS can be found as follows. \
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Permutations", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "\"\<S\>\"", ",", "\"\<U\>\"", ",", "\"\<C\>\"", ",", "\"\<C\>\"", ",", 
     "\"\<E\>\"", ",", "\"\<S\>\"", ",", "\"\<S\>\""}], "}"}], ",", 
   RowBox[{"{", "3", "}"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\<\"S\"\>", ",", "\<\"U\"\>", ",", "\<\"C\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"S\"\>", ",", "\<\"U\"\>", ",", "\<\"E\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"S\"\>", ",", "\<\"U\"\>", ",", "\<\"S\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"S\"\>", ",", "\<\"C\"\>", ",", "\<\"U\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"S\"\>", ",", "\<\"C\"\>", ",", "\<\"C\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"S\"\>", ",", "\<\"C\"\>", ",", "\<\"E\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"S\"\>", ",", "\<\"C\"\>", ",", "\<\"S\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"S\"\>", ",", "\<\"E\"\>", ",", "\<\"U\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"S\"\>", ",", "\<\"E\"\>", ",", "\<\"C\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"S\"\>", ",", "\<\"E\"\>", ",", "\<\"S\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"S\"\>", ",", "\<\"S\"\>", ",", "\<\"U\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"S\"\>", ",", "\<\"S\"\>", ",", "\<\"C\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"S\"\>", ",", "\<\"S\"\>", ",", "\<\"E\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"S\"\>", ",", "\<\"S\"\>", ",", "\<\"S\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"U\"\>", ",", "\<\"S\"\>", ",", "\<\"C\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"U\"\>", ",", "\<\"S\"\>", ",", "\<\"E\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"U\"\>", ",", "\<\"S\"\>", ",", "\<\"S\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"U\"\>", ",", "\<\"C\"\>", ",", "\<\"S\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"U\"\>", ",", "\<\"C\"\>", ",", "\<\"C\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"U\"\>", ",", "\<\"C\"\>", ",", "\<\"E\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"U\"\>", ",", "\<\"E\"\>", ",", "\<\"S\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"U\"\>", ",", "\<\"E\"\>", ",", "\<\"C\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"C\"\>", ",", "\<\"S\"\>", ",", "\<\"U\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"C\"\>", ",", "\<\"S\"\>", ",", "\<\"C\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"C\"\>", ",", "\<\"S\"\>", ",", "\<\"E\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"C\"\>", ",", "\<\"S\"\>", ",", "\<\"S\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"C\"\>", ",", "\<\"U\"\>", ",", "\<\"S\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"C\"\>", ",", "\<\"U\"\>", ",", "\<\"C\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"C\"\>", ",", "\<\"U\"\>", ",", "\<\"E\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"C\"\>", ",", "\<\"C\"\>", ",", "\<\"S\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"C\"\>", ",", "\<\"C\"\>", ",", "\<\"U\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"C\"\>", ",", "\<\"C\"\>", ",", "\<\"E\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"C\"\>", ",", "\<\"E\"\>", ",", "\<\"S\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"C\"\>", ",", "\<\"E\"\>", ",", "\<\"U\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"C\"\>", ",", "\<\"E\"\>", ",", "\<\"C\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"E\"\>", ",", "\<\"S\"\>", ",", "\<\"U\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"E\"\>", ",", "\<\"S\"\>", ",", "\<\"C\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"E\"\>", ",", "\<\"S\"\>", ",", "\<\"S\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"E\"\>", ",", "\<\"U\"\>", ",", "\<\"S\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"E\"\>", ",", "\<\"U\"\>", ",", "\<\"C\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"E\"\>", ",", "\<\"C\"\>", ",", "\<\"S\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"E\"\>", ",", "\<\"C\"\>", ",", "\<\"U\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"E\"\>", ",", "\<\"C\"\>", ",", "\<\"C\"\>"}], "}"}]}], 
  "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "Applying ",
 StyleBox[ButtonBox["Length",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Length"], "FunctionLink"],
 " returns the number of such strings."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Length", "[", "%", "]"}]], "Input"],

Cell[BoxData["43"], "Output"]
}, Open  ]],

Cell[TextData[{
 "A related question is the number of strings with 3 or more letters that can \
be made from the letters of the word SUCCESS. To find this, we only have to \
change the second argument of ",
 StyleBox[ButtonBox["Permutations",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Permutations"], "FunctionLink"],
 " to ",
 StyleBox["{3,7}", "Input"],
 ", indicating that the length of the permutations should be allowed to range \
from 3 to 7 (the number of letters in SUCCESS)."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Length", "[", 
  RowBox[{"Permutations", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\"\<S\>\"", ",", "\"\<U\>\"", ",", "\"\<C\>\"", ",", "\"\<C\>\"", ",", 
      "\"\<E\>\"", ",", "\"\<S\>\"", ",", "\"\<S\>\""}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"3", ",", "7"}], "}"}]}], "]"}], "]"}]], "Input"],

Cell[BoxData["1247"], "Output"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Distinguishable Objects and Distinguishable Boxes", "Subsection",
 CellTags->"Section5d"],

Cell[TextData[{
 "Example 8 asks how many ways there are to distribute hands of 5 cards to \
each of four players from a deck of 52 cards. There are several ways to \
compute this value in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "."
}], "Text"],

Cell[TextData[{
 "First, we can use the expression in terms of combinations, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"C", "(", 
     RowBox[{"52", ",", "5"}], ")"}], 
    RowBox[{"C", "(", 
     RowBox[{"47", ",", "5"}], ")"}], 
    RowBox[{"C", "(", 
     RowBox[{"42", ",", "5"}], ")"}], 
    RowBox[{"C", "(", 
     RowBox[{"37", ",", "5"}], ")"}]}], TraditionalForm]]],
 ", by using ",
 StyleBox[ButtonBox["Binomial",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Binomial"], "FunctionLink"],
 "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Binomial", "[", 
   RowBox[{"52", ",", "5"}], "]"}], "*", 
  RowBox[{"Binomial", "[", 
   RowBox[{"47", ",", "5"}], "]"}], "*", 
  RowBox[{"Binomial", "[", 
   RowBox[{"42", ",", "5"}], "]"}], "*", 
  RowBox[{"Binomial", "[", 
   RowBox[{"37", ",", "5"}], "]"}]}]], "Input"],

Cell[BoxData["1478262843475644020034240"], "Output"]
}, Open  ]],

Cell[TextData[{
 "Second, we can use the formula from Theorem 4: ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"52", "!"}], 
    RowBox[{
     RowBox[{"5", "!"}], "\[CenterDot]", 
     RowBox[{"5", "!"}], "\[CenterDot]", 
     RowBox[{"5", "!"}], "\[CenterDot]", 
     RowBox[{"5", "!"}], "\[CenterDot]", 
     RowBox[{"32", "!"}]}]], TraditionalForm]]],
 "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"52", "!"}], "/", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"5", "!"}], "*", 
    RowBox[{"5", "!"}], "*", 
    RowBox[{"5", "!"}], "*", 
    RowBox[{"5", "!"}], "*", 
    RowBox[{"32", "!"}]}], ")"}]}]], "Input"],

Cell[BoxData["1478262843475644020034240"], "Output"]
}, Open  ]],

Cell[TextData[{
 "Finally, this same value can be computed using the ",
 StyleBox[ButtonBox["Multinomial",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Multinomial"], "FunctionLink"],
 " function. Recall Theorem 4 in the text asserts that the number of ways to \
place ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " distinguishable objects into boxes so that ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["n", "1"], TraditionalForm]]],
 " objects are placed in box 1, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["n", 
    SubscriptBox["2", " "]], TraditionalForm]]],
 " objects are put in box 2, etc., is ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"n", "!"}], 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["n", "1"], "!"}], "\[CenterDot]", 
      RowBox[{
       SubscriptBox["n", "2"], "!"}]}], 
     RowBox[{
      SubscriptBox["\[CenterEllipsis]n", "k"], "!"}]}]], TraditionalForm]]],
 ". The ",
 StyleBox[ButtonBox["Multinomial",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Multinomial"], "FunctionLink"],
 " function takes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["n", "1"], ",", 
    SubscriptBox["n", "2"], ",", "\[Ellipsis]", ",", 
    SubscriptBox["n", "k"]}], TraditionalForm]]],
 " as arguments and applies the formula with ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " computed as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["n", "1"], "+", 
    SubscriptBox["n", "2"], "+", "\[CenterEllipsis]", "+", 
    SubscriptBox["n", "k"]}], TraditionalForm]]],
 ". So to compute the answer to Example 8, you enter the following."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Multinomial", "[", 
  RowBox[{"5", ",", "5", ",", "5", ",", "5", ",", "32"}], "]"}]], "Input"],

Cell[BoxData["1478262843475644020034240"], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Revising the ",
 StyleBox["Multinomial", "Input"],
 " Function"
}], "Subsubsection"],

Cell[TextData[{
 "It is common in questions about distributing distinguishable objects into \
distinguishable boxes that you want to distribute only some of the objects. \
In Example 8, for instance, not all of the cards are dealt to players. The ",
 StyleBox[ButtonBox["Multinomial",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Multinomial"], "FunctionLink"],
 " function requires that you include the remainder of the cards as an \
argument. Conceptually, you can think of making one more box to hold the \
objects that are not placed in any of the other boxes."
}], "Text"],

Cell[TextData[{
 "This is such a common occurrence, however, that it seems more natural to \
forget about this \[OpenCurlyDoubleQuote]discard box\[CloseCurlyDoubleQuote] \
and instead include the total number of objects. We will write a ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " function that will use the formula from Theorem 4 but will require the \
total number of objects as the first argument and calculate the size of the \
discard box."
}], "Text"],

Cell[TextData[{
 "We would like our function to, like ",
 StyleBox[ButtonBox["Multinomial",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Multinomial"], "FunctionLink"],
 ", accept any number of arguments, rather than requiring the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["n", "i"], TraditionalForm]]],
 " to be collected in a list. That is, we would like to be able to compute \
the answer to Example 8 as follows."
}], "Text"],

Cell[BoxData[
 RowBox[{"myMultinomial", "[", 
  RowBox[{"52", ",", "5", ",", "5", ",", "5", ",", "5"}], "]"}]], "myCode"],

Cell["\<\
The first argument will be the total number of objects, and it should be \
followed by at least one integer indicating the sizes of the boxes.\
\>", "Text"],

Cell[TextData[{
 "To allow the function to accept arbitrary numbers of argument, we use the \
",
 StyleBox[ButtonBox["BlankSequence",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/BlankSequence"], "FunctionLink"],
 " (",
 StyleBox["__", "Input"],
 ") pattern, entered with two underscores. In the past, \
we\[CloseCurlyQuote]ve used this inside braces as a way to specify that an \
argument must be a list of a certain kind, as in ",
 StyleBox["a:{__Integer}", "Input"],
 ". This will be similar, but without the braces."
}], "Text"],

Cell["The function definition will begin as shown below.", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"myMultinomial", "[", 
   RowBox[{"n_Integer", ",", "L__Integer"}], "]"}], ":="}]], "myCode"],

Cell[TextData[{
 "The difficulty arises when working with the sequence of integers matched by \
",
 StyleBox["L", "Input"],
 ". In particular, ",
 StyleBox["L", "Input"],
 " does not represent a list, it represents a sequence of arguments. So \
functions that accept a list argument, such as ",
 StyleBox[ButtonBox["Length",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Length"], "FunctionLink"],
 ", will raise an error, as illustrated below."
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"numberArgs", "[", "L__", "]"}], ":=", 
  RowBox[{"Length", "[", "L", "]"}]}]], "Input",
 InitializationCell->True],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"numberArgs", "[", 
  RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"Length", "::", "argx"}], "MessageName"], 
  RowBox[{
  ":", " "}], "\<\"\[NoBreak]\\!\\(Length\\)\[NoBreak] called with \[NoBreak]\
\\!\\(4\\)\[NoBreak] arguments; 1 argument is expected. \\!\\(\\*ButtonBox[\\\
\"\[RightSkeleton]\\\", ButtonStyle->\\\"Link\\\", ButtonFrame->None, \
ButtonData:>\\\"paclet:ref/message/General/argx\\\", ButtonNote -> \
\\\"Length::argx\\\"]\\)\"\>"}]], "Message", "MSG"],

Cell[BoxData[
 RowBox[{"Length", "[", 
  RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "]"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "The way to deal with this is to wrap ",
 StyleBox["L", "Input"],
 " in braces before applying the function."
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"numberArgs2", "[", "L__", "]"}], ":=", 
  RowBox[{"Length", "[", 
   RowBox[{"{", "L", "}"}], "]"}]}]], "Input",
 InitializationCell->True],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"numberArgs2", "[", 
  RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "]"}]], "Input"],

Cell[BoxData["4"], "Output"]
}, Open  ]],

Cell[TextData[{
 "On the other hand, functions that normally accepts arbitrary numbers of \
arguments and must usually be used in conjunction with ",
 StyleBox[ButtonBox["Apply",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Apply"], "FunctionLink"],
 " to operate on a list, can be given the sequence directly."
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sumArgs", "[", "L__", "]"}], ":=", 
  RowBox[{"Plus", "[", "L", "]"}]}]], "Input",
 InitializationCell->True],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sumArgs", "[", 
  RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "]"}]], "Input"],

Cell[BoxData["10"], "Output"]
}, Open  ]],

Cell[TextData[{
 "Now that we know how to work with the ",
 StyleBox[ButtonBox["BlankSequence",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/BlankSequence"], "FunctionLink"],
 ", writing the ",
 StyleBox["myMultinomial", "Input"],
 " function is straightforward. We compute the size of the discard box by \
subtracting the first argument from the sum of the rest. The ",
 StyleBox[ButtonBox["Factorial",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Factorial"], "FunctionLink"],
 " function automatically threads over lists, so we can apply it to the list \
formed from ",
 StyleBox["L", "Input"],
 " and the discard box size. We need to use ",
 StyleBox[ButtonBox["Apply",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Apply"], "FunctionLink"],
 " (",
 StyleBox["@@", "Input"],
 ") with ",
 StyleBox[ButtonBox["Times",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Times"], "FunctionLink"],
 " in order to multiply the factorials, and then divide ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "!"}], TraditionalForm]]],
 " by that result."
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"myMultinomial", "[", 
   RowBox[{"n_Integer", ",", "L__Integer"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"discard", ",", "denomList", ",", "denom"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"discard", "=", 
      RowBox[{"n", "-", 
       RowBox[{"Plus", "[", "L", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"denomList", "=", 
      RowBox[{"Factorial", "[", 
       RowBox[{"{", 
        RowBox[{"L", ",", "discard"}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"denom", "=", 
      RowBox[{"Times", "@@", "denomList"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"n", "!"}], "/", "denom"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 InitializationCell->True],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"myMultinomial", "[", 
  RowBox[{"52", ",", "5", ",", "5", ",", "5", ",", "5"}], "]"}]], "Input"],

Cell[BoxData["1478262843475644020034240"], "Output"]
}, Open  ]],

Cell["\<\
The reader is encouraged to eliminate the local variables and write a \
\[OpenCurlyDoubleQuote]one line\[CloseCurlyDoubleQuote] version of this \
function.\
\>", "Text"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Indistinguishable Objects and Distinguishable Boxes", "Subsection",
 CellTags->"Section5e"],

Cell["\<\
The text describes the correspondence between questions about placing \
indistinguishable objects into distinguishable boxes and about combination \
with repetition questions.\
\>", "Text"],

Cell[TextData[{
 "Example 9 asks how many ways 10 indistinguishable balls can be placed in 8 \
bins. We can use the ",
 StyleBox["CRep", "Input"],
 " function written earlier."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CRep", "[", 
  RowBox[{"8", ",", "10"}], "]"}]], "Input"],

Cell[BoxData["19448"], "Output"]
}, Open  ]],

Cell["\<\
It may seem that the arguments were reversed. Keep in mind that the \
connection to combinations with repetition is that you are selecting 10 bins \
from the 8 available bins, with repetition allowed.\
\>", "Text"],

Cell[CellGroupData[{

Cell["Compositions and Weak Compositions", "Subsubsection"],

Cell[TextData[{
 "We can also use the ",
 StyleBox[ButtonBox["Compositions",
  BaseStyle->"Link",
  ButtonData->"paclet:Combinatorica/ref/Compositions"], "FunctionLink"],
 " and ",
 StyleBox[ButtonBox["NumberOfCompositions",
  BaseStyle->"Link",
  ButtonData->"paclet:Combinatorica/ref/NumberOfCompositions"], 
  "FunctionLink"],
 " functions to answer questions of this kind. A ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 "-composition of a positive integer ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " is a way of writing ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " as the sum of ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 " positive integers where the order of the summands matters. For example, 4 \
has three distinct 2-compositions: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "+", "1"}], TraditionalForm]]],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "+", "2"}], TraditionalForm]]],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "+", "3"}], TraditionalForm]]],
 "."
}], "Text"],

Cell[TextData[{
 "A weak composition is similar, but the terms in the sum are allowed to be \
0. Thus 4 has five distinct weak 2-compositions: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"4", "+", "0"}], TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "+", "4"}], TraditionalForm]]],
 " in addition to the three listed before."
}], "Text"],

Cell[TextData[{
 "Note that the weak ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]]],
 "-compositions of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " correspond to the ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]]],
 "-compositions of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "+", "r"}], TraditionalForm]]],
 ". For suppose that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["x", "1"], "+", 
     SubscriptBox["x", "2"], "+", "\[CenterEllipsis]", "+", 
     SubscriptBox["x", "r"]}], "=", "n"}], TraditionalForm]]],
 " is a weak ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]]],
 "-composition. Then each ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "i"], TraditionalForm]]],
 " is nonnegative. So"
}], "Text"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["x", "1"], "+", "1"}], ")"}], "+", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["x", "2"], "+", "1"}], ")"}], "+", "\[CenterEllipsis]", 
     "+", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["x", "r"], "+", "1"}], ")"}]}], "=", 
    RowBox[{"n", "+", "r"}]}], ","}], TraditionalForm]], "Equation"],

Cell[TextData[{
 "and each ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "i"], "+", "1"}], TraditionalForm]]],
 " is positive, and hence this is a composition of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "+", "r"}], TraditionalForm]]],
 ". Likewise, any ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]]],
 "-composition of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "+", "r"}], TraditionalForm]]],
 " can be transformed into a weak ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]]],
 "-composition by subtracting 1 from each term."
}], "Text"],

Cell[TextData[{
 "Also note that weak ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]]],
 "-compositions of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " correspond to placing ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " indistinguishable balls into ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]]],
 " distinguishable bins. Suppose ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["x", "1"], "+", 
     SubscriptBox["x", "2"], "+", "\[CenterEllipsis]", "+", 
     SubscriptBox["x", "r"]}], "=", "n"}], TraditionalForm]]],
 " is a weak ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]]],
 "-composition of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 ". This can be identified with placing ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]]],
 " of the objects into the first bin, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "2"], TraditionalForm]]],
 " objects in the second bin, etc."
}], "Text"],

Cell[TextData[{
 "We now return to ",
 StyleBox[ButtonBox["Compositions",
  BaseStyle->"Link",
  ButtonData->"paclet:Combinatorica/ref/Compositions"], "FunctionLink"],
 " and ",
 StyleBox[ButtonBox["NumberOfCompositions",
  BaseStyle->"Link",
  ButtonData->"paclet:Combinatorica/ref/NumberOfCompositions"], 
  "FunctionLink"],
 ". These are functions contained in the ",
 StyleBox["Combinatorica",
  FontSlant->"Italic"],
 " package, and are not available without loading that package by executing a \
",
 StyleBox[ButtonBox["Needs",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Needs"], "FunctionLink"],
 " statement. "
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<Combinatorica`\>\"", "]"}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"General", "::", "compat"}], "MessageName"], 
  RowBox[{
  ":", " "}], "\<\"Combinatorica Graph and Permutations functionality has \
been superseded by preloaded functionality. The package now being loaded may \
conflict with this. Please see the Compatibility Guide for details.\"\>"}]], \
"Message", "MSG"]
}, Open  ]],

Cell[TextData[{
 "You may safely ignore the compatibility warning in this context. Some of \
the functionality of the ",
 StyleBox["Combinatorica",
  FontSlant->"Italic"],
 " package has been superseded by new functionality in the main kernel in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ". However, this does not affect the functions we will be using."
}], "Text"],

Cell[TextData[{
 "The ",
 StyleBox[ButtonBox["Compositions",
  BaseStyle->"Link",
  ButtonData->"paclet:Combinatorica/ref/Compositions"], "FunctionLink"],
 " and ",
 StyleBox[ButtonBox["NumberOfCompositions",
  BaseStyle->"Link",
  ButtonData->"paclet:Combinatorica/ref/NumberOfCompositions"], 
  "FunctionLink"],
 " functions accept the same arguments: the integers ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]]],
 ". ",
 StyleBox[ButtonBox["NumberOfCompositions",
  BaseStyle->"Link",
  ButtonData->"paclet:Combinatorica/ref/NumberOfCompositions"], 
  "FunctionLink"],
 " outputs the number of ",
 StyleBox["weak",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]]],
 "-compositions of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 ", while ",
 StyleBox[ButtonBox["Compositions",
  BaseStyle->"Link",
  ButtonData->"paclet:Combinatorica/ref/Compositions"], "FunctionLink"],
 " returns a list of them. Observe that the names ",
 StyleBox["Combinatorica",
  FontSlant->"Italic"],
 " uses for these functions is slightly at odds with the usual terminology."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"NumberOfCompositions", "[", 
  RowBox[{"4", ",", "2"}], "]"}]], "Input"],

Cell[BoxData["5"], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Compositions", "[", 
  RowBox[{"4", ",", "2"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "0"}], "}"}]}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "The number of ways to place ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " indistinguishable objects in ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]]],
 " distinguishable boxes is the same as the number of weak ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]]],
 "-compositions of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 ". Consequently, we can determine the number of ways 10 balls can be placed \
in 8 bins, the same question as before, as follows."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"NumberOfCompositions", "[", 
  RowBox[{"10", ",", "8"}], "]"}]], "Input"],

Cell[BoxData["19448"], "Output"]
}, Open  ]]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Distinguishable Objects and Indistinguishable Boxes", "Subsection",
 CellTags->"Section5f"],

Cell[TextData[{
 "As described in the text, the number of ways to place ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " distinguishable objects in ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 " indistinguishable boxes is given by the Stirling numbers of the second \
kind, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "(", 
    RowBox[{"n", ",", "k"}], ")"}], TraditionalForm]]],
 "."
}], "Text"],

Cell[TextData[{
 "The function ",
 StyleBox[ButtonBox["StirlingS2",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/StirlingS2"], "FunctionLink"],
 " computes the Stirling number of the second kind. This function requires \
two arguments, the number of objects and the number of boxes. For example, \
the expression below computes the number of ways to put seven different \
employees in 4 different offices when each office must not be empty."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"StirlingS2", "[", 
  RowBox[{"7", ",", "4"}], "]"}]], "Input"],

Cell[BoxData["350"], "Output"]
}, Open  ]],

Cell["\<\
In order to compute the number of ways to assign the 7 employees to the 4 \
offices and allow empty offices, we must add the number of ways to assign all \
7 employees to 1 office, to 2 offices, to 3 offices, and to 4 offices.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Sum", "[", 
  RowBox[{
   RowBox[{"StirlingS2", "[", 
    RowBox[{"7", ",", "i"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "1", ",", "4"}], "}"}]}], "]"}]], "Input"],

Cell[BoxData["715"], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Generating Assignments of Employees to Offices", "Subsubsection",
 PageBreakWithin->False],

Cell[TextData[{
 "The ",
 StyleBox[ButtonBox["StirlingS2",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/StirlingS2"], "FunctionLink"],
 " function tells us how many ways there are to place distinguishable objects \
in indistinguishable boxes. In this subsection, we will create a function to \
list these. However, note that the ",
 StyleBox["Combinatorica",
  FontSlant->"Italic"],
 " package has a function, similar to the one we will create by hand, called ",
 StyleBox[ButtonBox["SetPartitions",
  BaseStyle->"Link",
  ButtonData->"paclet:Combinatorica/ref/SetPartitions"], "FunctionLink"],
 "."
}], "Text",
 PageBreakAbove->False,
 PageBreakWithin->False],

Cell[TextData[{
 "To create a function that will list the possible assignments of \
distinguishable objects to boxes, we rely on the following observations. \
First, as indicated in the text, a choice of distinguishable objects to \
indistinguishable boxes can be modeled as a set of subsets. For instance,",
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"A", ",", "C"}], "}"}], ",", 
     RowBox[{"{", "D", "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"B", ",", "E"}], "}"}]}], "}"}], TraditionalForm]]],
 " represents the assignment of A and C to one box, D to a box of its own, \
and B and E to another box. The set of subsets must not contain the empty set \
and must be such that the union of the subsets be the entire collection of \
objects."
}], "Text"],

Cell[TextData[{
 "We can produce such assignments recursively. The basis step is that there \
is only one way to assign ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " objects to 1 box and there are no ways to assign ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " objects to ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 " boxes for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", ">", "n"}], TraditionalForm]]],
 " (under the requirement that no box be empty). To assign ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " objects to ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 " boxes with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "\[LessEqual]", "n"}], TraditionalForm]]],
 ", proceed as follows."
}], "Text"],

Cell[TextData[{
 "First, find all assignments of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "-", "1"}], TraditionalForm]]],
 " objects to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "-", "1"}], TraditionalForm]]],
 " boxes and update each assignment by placing object ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " in a box by itself. In terms of the set representation, given ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["B", "1"], ",", 
     SubscriptBox["B", "2"], ",", "\[Ellipsis]", ",", 
     SubscriptBox["B", 
      RowBox[{"k", "-", "1"}]]}], "}"}], TraditionalForm]]],
 ", we produce ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["B", "1"], ",", 
     SubscriptBox["B", "2"], ",", "\[Ellipsis]", ",", 
     SubscriptBox["B", 
      RowBox[{"k", "-", "1"}]], ",", 
     RowBox[{"{", "n", "}"}]}], "}"}], TraditionalForm]]],
 "."
}], "Text"],

Cell[TextData[{
 "Second, find all assignments of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "-", "1"}], TraditionalForm]]],
 " objects to ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 " boxes. For each such assignment ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["B", "1"], ",", 
     SubscriptBox["B", "2"], ",", "\[Ellipsis]", ",", 
     SubscriptBox["B", "k"]}], "}"}], TraditionalForm]]],
 ", produce the following ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 " assignments of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " objects to the ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 " boxes:"
}], "Text"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SubscriptBox["B", "1"], "\[Union]", 
      RowBox[{"{", "n", "}"}]}], ",", 
     SubscriptBox["B", "2"], ",", "\[Ellipsis]", ",", 
     SubscriptBox["B", "k"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["B", "1"], ",", 
     RowBox[{
      SubscriptBox["B", "2"], "\[Union]", 
      RowBox[{"{", "n", "}"}]}], ",", 
     SubscriptBox["B", "3"], ",", "\[Ellipsis]", ",", 
     SubscriptBox["B", "k"]}], "}"}], ",", 
   RowBox[{"\[Ellipsis]", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["B", "1"], ",", 
      SubscriptBox["B", "2"], ",", "\[Ellipsis]", ",", 
      RowBox[{
       SubscriptBox["B", "k"], "\[Union]", 
       RowBox[{"{", "n", "}"}]}]}], "}"}]}]}], TraditionalForm]], "Equation"],

Cell["\<\
The assignments of objects to boxes produced by the two methods above produce \
all assignments. The following function implements this algorithm.\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"makeStirling2", "[", 
    RowBox[{"n_Integer", ",", "k_Integer"}], "]"}], "/;", 
   RowBox[{
    RowBox[{"n", ">", "0"}], "&&", 
    RowBox[{"k", ">", "0"}]}]}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "A", ",", "k1boxes", ",", "kboxes", ",", "B", ",", "new", ",", "i"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{"k", "\[Equal]", "1"}], ",", "\[IndentingNewLine]", 
       RowBox[{"A", "=", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"Range", "[", "n", "]"}], "}"}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"k", ">", "n"}], ",", "\[IndentingNewLine]", 
       RowBox[{"A", "=", 
        RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", "True", ",", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"the", " ", 
         RowBox[{"recursion", ":"}]}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"A", "=", 
         RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"n", "-", 
          RowBox[{"1", " ", "objects", " ", "in", " ", "k"}], "-", 
          RowBox[{"1", " ", "boxes"}]}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"k1boxes", "=", 
         RowBox[{"makeStirling2", "[", 
          RowBox[{
           RowBox[{"n", "-", "1"}], ",", 
           RowBox[{"k", "-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"new", "=", 
            RowBox[{"Union", "[", 
             RowBox[{"B", ",", 
              RowBox[{"{", 
               RowBox[{"{", "n", "}"}], "}"}]}], "]"}]}], ";", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"A", ",", "new"}], "]"}]}], "\[IndentingNewLine]", ",", 
          RowBox[{"{", 
           RowBox[{"B", ",", "k1boxes"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"n", "-", 
          RowBox[{"1", " ", "objects", " ", "in", " ", "k", " ", "boxes"}]}], 
         " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"kboxes", "=", 
         RowBox[{"makeStirling2", "[", 
          RowBox[{
           RowBox[{"n", "-", "1"}], ",", "k"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"i", "=", "1"}], ",", 
            RowBox[{"i", "\[LessEqual]", "k"}], ",", 
            RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"new", "=", 
              RowBox[{"ReplacePart", "[", 
               RowBox[{"B", ",", 
                RowBox[{"i", "\[Rule]", 
                 RowBox[{"Append", "[", 
                  RowBox[{
                   RowBox[{"B", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", "n"}], "]"}]}]}], 
               "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"A", ",", "new"}], "]"}]}]}], "\[IndentingNewLine]", 
           "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"B", ",", "kboxes"}], "}"}]}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", "A"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True],

Cell[TextData[{
 "Let us analyze the function. It accepts ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 " as parameters and returns the list of all possible assignments of \
distinguishable objects to indistinguishable boxes. The symbol ",
 StyleBox["A", "Input"],
 " stores the list that will ultimately be output."
}], "Text"],

Cell[TextData[{
 "In the case that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "=", "1"}], TraditionalForm]]],
 ", there is only one possible assignment, all objects are assigned to the \
single box. This assignment is represented by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "\[Ellipsis]", ",", "n"}], "}"}], "}"}], 
   TraditionalForm]]],
 ", since an assignment corresponds to a set of subsets. The function sets \
the output symbol ",
 StyleBox["A", "Input"],
 " to the list consisting of this single assignment when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "=", "1"}], TraditionalForm]]],
 ". Recall the ",
 StyleBox[ButtonBox["Range",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Range"], "FunctionLink"],
 " function applied to a positive integer produces the list of integers from \
1 to that value."
}], "Text"],

Cell[TextData[{
 "If ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", ">", "n"}], TraditionalForm]]],
 ", then there are no valid assignments and the function sets the output \
symbol ",
 StyleBox["A", "Input"],
 " to the empty set."
}], "Text"],

Cell[TextData[{
 "Otherwise, the symbol ",
 StyleBox["A", "Input"],
 " is initialized to the empty set. Recall that there are two recursive \
steps. First expanding on the assignments of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "-", "1"}], TraditionalForm]]],
 " objects to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "-", "1"}], TraditionalForm]]],
 " boxes. And then expanding on the assignments of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "-", "1"}], TraditionalForm]]],
 " objects to ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 " boxes."
}], "Text"],

Cell[TextData[{
 "For the first part, we assign the symbol ",
 StyleBox["k1boxes", "Input"],
 " to the set of assignments of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "-", "1"}], TraditionalForm]]],
 " objects to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "-", "1"}], TraditionalForm]]],
 " boxes. For each such assignment, that is each ",
 StyleBox["B", "Input"],
 " in ",
 StyleBox["k1boxes", "Input"],
 ", we add ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " in its own box, e.g., for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "3", ",", "5"}], "}"}], ",", 
     RowBox[{"{", "2", "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "6"}], "}"}]}], "}"}], TraditionalForm]]],
 ", we would add 7:"
}], "Text"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "3", ",", "5"}], "}"}], ",", 
      RowBox[{"{", "2", "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"4", ",", "6"}], "}"}]}], "}"}], "\[Union]", 
    RowBox[{"{", 
     RowBox[{"{", "7", "}"}], "}"}]}], "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "3", ",", "5"}], "}"}], ",", 
      RowBox[{"{", "2", "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"4", ",", "6"}], "}"}], ",", 
      RowBox[{"{", "7", "}"}]}], "}"}], "."}]}], TraditionalForm]], "Equation"],

Cell[TextData[{
 "This ",
 StyleBox["new", "Input"],
 " assignment is then added to ",
 StyleBox["A", "Input"],
 "."
}], "Text"],

Cell[TextData[{
 "In the second part, we assign ",
 StyleBox["kboxes", "Input"],
 " to the set of assignments of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "-", "1"}], TraditionalForm]]],
 " objects to ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 " boxes. For each such assignment ",
 StyleBox["B", "Input"],
 ", we consider each of the ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 " boxes in turn and add ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " to that box. For instance, the assignment ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "3"}], "}"}], ",", 
     RowBox[{"{", "1", "}"}], ",", 
     RowBox[{"{", "5", "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "6"}], "}"}]}], "}"}], TraditionalForm]]],
 " would generate the four assignments:"
}], "Text"],

Cell[BoxData[{
 FormBox[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"2", ",", "3", ",", "7"}], "}"}], ",", 
    RowBox[{"{", "1", "}"}], ",", 
    RowBox[{"{", "5", "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"4", ",", "6"}], "}"}]}], "}"}], 
  TraditionalForm], "\[LineSeparator]", 
 FormBox[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"2", ",", "3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "7"}], "}"}], ",", 
    RowBox[{"{", "5", "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"4", ",", "6"}], "}"}]}], "}"}], 
  TraditionalForm], "\[LineSeparator]", 
 FormBox[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"2", ",", "3"}], "}"}], ",", 
    RowBox[{"{", "1", "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"5", ",", "7"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"4", ",", "6"}], "}"}]}], "}"}], 
  TraditionalForm], "\[LineSeparator]", 
 FormBox[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"2", ",", "3"}], "}"}], ",", 
    RowBox[{"{", "1", "}"}], ",", 
    RowBox[{"{", "5", "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"4", ",", "6", ",", "7"}], "}"}]}], "}"}], 
  TraditionalForm]}], "Equation"],

Cell[TextData[{
 "To create these four ",
 StyleBox["new", "Input"],
 " assignments from the initial assignment ",
 StyleBox["B", "Input"],
 ", we use the ",
 StyleBox[ButtonBox["ReplacePart",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/ReplacePart"], "FunctionLink"],
 " function. In its simplest form, as we use it here, ",
 StyleBox[ButtonBox["ReplacePart",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/ReplacePart"], "FunctionLink"],
 " takes two arguments. The first argument is an expression to be \
manipulated, in this case ",
 StyleBox["B", "Input"],
 ", the original list representing an assignment of objects to boxes. The \
second argument is a rule of the form ",
 Cell[BoxData[
  RowBox[{
   StyleBox["index", "CodeVar"], "->", 
   StyleBox["replacement", "CodeVar"]}]], "myCode"],
 ". The ",
 StyleBox["index", "CodeVar"],
 " is the location within ",
 StyleBox["B", "Input"],
 " that is to be substituted with the ",
 StyleBox["replacement", "CodeVar"],
 " expression. In ",
 StyleBox["makeStirling2", "Input"],
 ", we use a ",
 StyleBox[ButtonBox["For",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/For"], "FunctionLink"],
 " loop variable as the index and the replacement expression is obtained from \
",
 StyleBox[ButtonBox["Append",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Append"], "FunctionLink"],
 " to add the value ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " to the box at that index."
}], "Text"],

Cell[TextData[{
 "Compare the result of our function to the solution of Example 10 in Section \
6.5 of the text. We use ",
 StyleBox[ButtonBox["Column",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Column"], "FunctionLink"],
 " to put each assignment on its own line."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"makeStirling2", "[", 
   RowBox[{"4", ",", "3"}], "]"}], "//", "Column"}]], "Input"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "3", "}"}], ",", 
       RowBox[{"{", "4", "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}]}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "2", "}"}], ",", 
       RowBox[{"{", "4", "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "3"}], "}"}]}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "1", "}"}], ",", 
       RowBox[{"{", "4", "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}]}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "4"}], "}"}], ",", 
       RowBox[{"{", "2", "}"}], ",", 
       RowBox[{"{", "3", "}"}]}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "1", "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "4"}], "}"}], ",", 
       RowBox[{"{", "3", "}"}]}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "1", "}"}], ",", 
       RowBox[{"{", "2", "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "4"}], "}"}]}], "}"}]}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Column"]], "Output"]
}, Open  ]],

Cell["\<\
Except for using the integers 1 through 4 instead of the letters A through D, \
the output above is the same as the six ways listed in the text for placing \
the four employees in 3 offices. \
\>", "Text"],

Cell[TextData[{
 "To produce all 14 ways to assign the 4 employees to 3 offices with each \
office containing any number of employees, we need to loop over the different \
values of ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 ". Using ",
 StyleBox[ButtonBox["Table",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Table"], "FunctionLink"],
 " to vary the number of offices results in a list, each element of which is \
a list of results. Using ",
 StyleBox[ButtonBox["Flatten",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Flatten"], "FunctionLink"],
 " with second argument 1 combines this list of lists into a single list of \
results. The 1 as the second argument indicates that only the top level of \
lists are to be flattened. The result can be displayed with ",
 StyleBox[ButtonBox["Column",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Column"], "FunctionLink"],
 "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Flatten", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"makeStirling2", "[", 
       RowBox[{"4", ",", "k"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", "3"}], "}"}]}], "]"}], ",", "1"}], "]"}], "//",
   "Column"}]], "Input"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "4", "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"3", ",", "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}]}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "3", "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "4"}], "}"}]}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "3", ",", "4"}], "}"}], ",", 
       RowBox[{"{", "2", "}"}]}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "4"}], "}"}]}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}]}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "1", "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3", ",", "4"}], "}"}]}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "3", "}"}], ",", 
       RowBox[{"{", "4", "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}]}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "2", "}"}], ",", 
       RowBox[{"{", "4", "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "3"}], "}"}]}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "1", "}"}], ",", 
       RowBox[{"{", "4", "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}]}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "4"}], "}"}], ",", 
       RowBox[{"{", "2", "}"}], ",", 
       RowBox[{"{", "3", "}"}]}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "1", "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "4"}], "}"}], ",", 
       RowBox[{"{", "3", "}"}]}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "1", "}"}], ",", 
       RowBox[{"{", "2", "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "4"}], "}"}]}], "}"}]}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Column"]], "Output"]
}, Open  ]]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Indistinguishable Objects and Indistinguishable Boxes", "Subsection",
 CellTags->"Section5g"],

Cell[TextData[{
 "As described in the text, distributing ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " indistinguishable objects into ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 " indistinguishable boxes is identical to forming a partition of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " into ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 " positive integers. A partition of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " into ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 " positive integers is a sum ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", 
    RowBox[{
     SubscriptBox["a", "1"], "+", 
     SubscriptBox["a", "2"], "+", "\[CenterEllipsis]", "+", 
     SubscriptBox["a", "k"]}]}], TraditionalForm]]],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", "1"], "\[GreaterEqual]", 
    SubscriptBox["a", "2"], "\[GreaterEqual]", "\[CenterEllipsis]", 
    "\[GreaterEqual]", 
    SubscriptBox["a", "k"], ">", "0"}], TraditionalForm]]],
 ". "
}], "Text"],

Cell[TextData[{
 "The ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " functions ",
 StyleBox[ButtonBox["IntegerPartitions",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/IntegerPartitions"], "FunctionLink"],
 " and ",
 StyleBox[ButtonBox["PartitionsP",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/PartitionsP"], "FunctionLink"],
 " are used to form and count partitions of integers. With one argument, a \
nonnegative integer ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 ", ",
 StyleBox[ButtonBox["PartitionsP",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/PartitionsP"], "FunctionLink"],
 " returns the total number of partitions of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " into as many as ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " boxes. Likewise, ",
 StyleBox[ButtonBox["IntegerPartitions",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/IntegerPartitions"], "FunctionLink"],
 " applied to one argument returns a list containing lists representing \
partitions of its argument."
}], "Text"],

Cell["\<\
For example, the expressions below compute the number of partitions of 7 and \
lists all the partitions of 7. \
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PartitionsP", "[", "7", "]"}]], "Input"],

Cell[BoxData["15"], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"IntegerPartitions", "[", "7", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "7", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"6", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"5", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"5", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "2", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "1", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "3", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "2", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "1", ",", "1", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2", ",", "2", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2", ",", "1", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "1", ",", "1", ",", "1", ",", "1", ",", "1"}], "}"}], 
   ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1", ",", "1", ",", "1", ",", "1", ",", "1"}],
     "}"}]}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "The ",
 StyleBox[ButtonBox["IntegerPartitions",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/IntegerPartitions"], "FunctionLink"],
 " function also accepts a second argument, which specifies the number of \
elements allowed to appear in a partition. For example, to answer the \
question: how many can you distribute 7 indistinguishable balls in up to 3 \
identical boxes, we would give 3 as the second argument to ",
 StyleBox[ButtonBox["IntegerPartitions",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/IntegerPartitions"], "FunctionLink"],
 "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"IntegerPartitions", "[", 
  RowBox[{"7", ",", "3"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "7", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"6", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"5", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"5", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "2", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "3", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "2", ",", "2"}], "}"}]}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "This second argument, which specifies the length of the partitions, can \
take on many of the usual forms: ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 ", as we saw, indicates the maximum length; ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "n", "}"}], TraditionalForm]]],
 " limits the output to those partitions of length exactly ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"n", ",", "m"}], "}"}], TraditionalForm]]],
 " produces the partitions from length ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " to ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]]],
 ". Also, the symbol ",
 StyleBox[ButtonBox["All",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/All"], "FunctionLink"],
 " can be used to list all of the partitions, just as if no second argument \
were given."
}], "Text"],

Cell["\<\
For example, the following produces the partitions of 7 whose lengths are \
between 3 and 5.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"IntegerPartitions", "[", 
  RowBox[{"7", ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "5"}], "}"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"5", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "2", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "1", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "3", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "2", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "1", ",", "1", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2", ",", "2", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2", ",", "1", ",", "1", ",", "1"}], "}"}]}], 
  "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 StyleBox[ButtonBox["IntegerPartitions",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/IntegerPartitions"], "FunctionLink"],
 " also accepts a third optional argument to control what values may appear \
in the partitions. Note that in order to use the this option, the second \
argument, specifying the length, must be given. To allow unrestricted \
lengths, you should give ",
 StyleBox[ButtonBox["All",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/All"], "FunctionLink"],
 " as the second argument. The third argument has only one form: a list of \
the allowable values. "
}], "Text"],

Cell["\<\
For example, to partition 15 using only 2, 3, and 4, you would enter the \
following.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"IntegerPartitions", "[", 
  RowBox[{"15", ",", "All", ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3", ",", "4"}], "}"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"4", ",", "4", ",", "4", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "4", ",", "3", ",", "2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "3", ",", "3", ",", "3", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "3", ",", "2", ",", "2", ",", "2", ",", "2"}], "}"}], 
   ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "3", ",", "3", ",", "3", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "3", ",", "3", ",", "2", ",", "2", ",", "2"}], "}"}], 
   ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "2", ",", "2", ",", "2", ",", "2", ",", "2", ",", "2"}],
     "}"}]}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "By using ",
 StyleBox[ButtonBox["Range",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Range"], "FunctionLink"],
 " in the third argument, you can easily specify a maximum allowable value, \
or another range of values. For example, to answer the question: how many \
ways are there to distribute 7 indistinguishable balls in up to 5 identical \
boxes when each box can hold at most 4 objects, you would given ",
 StyleBox["Range[4]", "Input"],
 " as the third argument."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"IntegerPartitions", "[", 
  RowBox[{"7", ",", "5", ",", 
   RowBox[{"Range", "[", "4", "]"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"4", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "2", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "1", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "3", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "2", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "1", ",", "1", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2", ",", "2", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2", ",", "1", ",", "1", ",", "1"}], "}"}]}], 
  "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "To determine the number, without outputting the list, simply apply ",
 StyleBox[ButtonBox["Length",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Length"], "FunctionLink"],
 ". "
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Length", "[", 
  RowBox[{"IntegerPartitions", "[", 
   RowBox[{"7", ",", "5", ",", 
    RowBox[{"Range", "[", "4", "]"}]}], "]"}], "]"}]], "Input"],

Cell[BoxData["9"], "Output"]
}, Open  ]],

Cell[TextData[{
 "Note that these optional arguments are not available for ",
 StyleBox[ButtonBox["PartitionsP",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/PartitionsP"], "FunctionLink"],
 "."
}], "Text"],

Cell[CellGroupData[{

Cell["Equivalence of Maximum Length and Maximum Value", "Subsubsection"],

Cell[TextData[{
 "The partitions of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " with at most ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 " objects in a box are in one-to-one correspondence with the partitions of \
",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " into at most ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 " boxes. To understand why, consider the partition ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"3", ",", "2", ",", "2", ",", "1"}], "}"}], TraditionalForm]]],
 "."
}], "Text"],

Cell[TextData[{
 "Think about placing the 8 objects in boxes according to the partition ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"3", ",", "2", ",", "2", ",", "1"}], "}"}], TraditionalForm]]],
 ". (The diagram shown below is a Ferrers diagram. A version of this diagram \
can be created with the function ",
 StyleBox[ButtonBox["FerrersDiagram",
  BaseStyle->"Link",
  ButtonData->"paclet:Combinatorica/ref/FerrersDiagram"], "FunctionLink"],
 " in the ",
 StyleBox["Combinatorica",
  FontSlant->"Italic"],
 " package.)"
}], "Text"],

Cell[TextData[Cell[BoxData[GridBox[{
   {"X", "X", "X", "X"},
   {"X", "X", "X", " "},
   {"X", " ", " ", " "}
  },
  GridBoxDividers->{
   "Columns" -> {{True}}, "ColumnsIndexed" -> {}, 
    "Rows" -> {True, {False}, True}, "RowsIndexed" -> {}}]]]], "Text"],

Cell["\<\
Instead of thinking about the columns as the boxes, we can instead consider \
the rows as boxes. \
\>", "Text"],

Cell[TextData[Cell[BoxData[GridBox[{
   {"X", "X", "X", "X"},
   {"X", "X", "X", " "},
   {"X", " ", " ", " "}
  },
  GridBoxDividers->{
   "Columns" -> {True, {False}, True}, "ColumnsIndexed" -> {}, 
    "Rows" -> {{True}}, "RowsIndexed" -> {}}]]]], "Text"],

Cell[TextData[{
 "Now the 8 objects are contained in three boxes. One box (the top row) has 4 \
objects, another (the middle row) has 3 objects, and the last box (the bottom \
row) has one object. In other words, we've partitioned 8 as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"4", ",", "3", ",", "1"}], "}"}], TraditionalForm]]],
 ". This partition is said to be the transpose of the first. (Note that you \
can also think about forming the transpose by reflecting it across its \
diagonal.)"
}], "Text"],

Cell[TextData[{
 "The ",
 StyleBox["Combinatorica",
  FontSlant->"Italic"],
 " function ",
 StyleBox[ButtonBox["TransposePartition",
  BaseStyle->"Link",
  ButtonData->"paclet:Combinatorica/ref/TransposePartition"], 
  "FunctionLink"],
 " will compute the transpose of a given partition."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TransposePartition", "[", 
  RowBox[{"{", 
   RowBox[{"3", ",", "2", ",", "2", ",", "1"}], "}"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"4", ",", "3", ",", "1"}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "We began with a partition whose maximum entry was 3 and found that its \
transpose was a partition into 3 boxes. It is always the case that the \
transpose of a partition with maximum ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " is a partition into ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " boxes. Moreover, this correspondence is one-to-one. We leave it to the \
reader to prove these facts."
}], "Text"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Generating Partitions", "Subsubsection"],

Cell[TextData[{
 "Here we will describe how to generate partitions and use this description \
to generalize the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " function ",
 StyleBox[ButtonBox["PartitionsP",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/PartitionsP"], "FunctionLink"],
 " with a second argument limiting the maximum number in the partition."
}], "Text"],

Cell[TextData[{
 "We will describe how to recursively form the partitions of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " objects when each box can hold at most ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 " objects. The basis cases are: when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "=", "1"}], TraditionalForm]]],
 ", there is only one partition of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 ", the partition consisting of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " 1s; when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", "0"}], TraditionalForm]]],
 ", there is only one partition, the empty partition ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "}"}], TraditionalForm]]],
 "."
}], "Text"],

Cell[TextData[{
 "To determine the partitions of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " when each box can hold at most ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 " objects, with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", ">", "0"}], TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", ">", "1"}], TraditionalForm]]],
 ", proceed as follows. First, determine all partitions of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " when each box can hold at most ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "-", "1"}], TraditionalForm]]],
 " objects. These partitions are also partitions of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " satisfying the requirement that each box holds at most ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 " objects."
}], "Text"],

Cell[TextData[{
 "Second, provided that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"n", "-", "k"}], "\[GreaterEqual]", "0"}], TraditionalForm]]],
 ", determine all partitions of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "-", "k"}], TraditionalForm]]],
 " when each box can hold at most ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 " objects, and prepend ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 " to each partition. For example, with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", "7"}], TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "=", "3"}], TraditionalForm]]],
 ", we have ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"n", "-", "k"}], "=", "4"}], TraditionalForm]]],
 " and the partitions of 4 with each box holding at most 3 are:"
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"IntegerPartitions", "[", 
  RowBox[{"4", ",", "All", ",", 
   RowBox[{"Range", "[", "3", "]"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"3", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}]}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "By prepending 3 to each of these partitions, we obtain ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"{", 
     RowBox[{"3", ",", "3", ",", "1"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"3", ",", "2", ",", "2"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"3", ",", "2", ",", "1", ",", "1"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"3", ",", "1", ",", "1", ",", "1", ",", "1"}], "}"}]}], 
   TraditionalForm]]],
 ", which are each partitions of 7 with each box having at most 3 objects."
}], "Text"],

Cell[TextData[{
 "Combining the partitions of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " with each box holding at most ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "-", "1"}], TraditionalForm]]],
 " objects with the partitions of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " formed by appending ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 " to the partitions of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "-", "k"}], TraditionalForm]]],
 " with each box holding at most ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 " objects produces all partitions of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " with each box holding at most ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 " objects. Setting ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "=", "n"}], TraditionalForm]]],
 " produces all partitions of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 "."
}], "Text"],

Cell["\<\
It is an exercise to implement this algorithm to generate partitions.\
\>", "Text"],

Cell[TextData[{
 "We can use the above to generalize ",
 StyleBox[ButtonBox["PartitionsP",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/PartitionsP"], "FunctionLink"],
 ". We will define a function ",
 StyleBox["myPartitionsP", "Input"],
 ". This function will be defined recursively. The basis cases are when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "=", "1"}], TraditionalForm]]],
 " or ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", "0"}], TraditionalForm]]],
 ", there is one partition."
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"myPartitionsP", "[", 
    RowBox[{"_", ",", "1"}], "]"}], ":=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"myPartitionsP", "[", 
   RowBox[{"0", ",", "_"}], "]"}], ":=", "1"}]}], "Input",
 InitializationCell->True],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "<", "0"}], TraditionalForm]]],
 " or ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "<", "1"}], TraditionalForm]]],
 ", there are no partitions."
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"myPartitionsP", "[", 
    RowBox[{"n_", ",", "k_"}], "]"}], "/;", 
   RowBox[{
    RowBox[{"n", "<", "0"}], "||", 
    RowBox[{"k", "<", "1"}]}]}], ":=", "0"}]], "Input",
 InitializationCell->True],

Cell[TextData[{
 "Provided that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", ">", "0"}], TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", ">", "1"}], TraditionalForm]]],
 ", the discussion above leads us to the following recursive definition."
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"myPartitionsP", "[", 
    RowBox[{"n_Integer", ",", "k_Integer"}], "]"}], "/;", 
   RowBox[{
    RowBox[{"n", ">", "0"}], "&&", 
    RowBox[{"k", ">", "1"}]}]}], ":=", 
  RowBox[{
   RowBox[{"myPartitionsP", "[", 
    RowBox[{"n", ",", 
     RowBox[{"k", "-", "1"}]}], "]"}], "+", 
   RowBox[{"myPartitionsP", "[", 
    RowBox[{
     RowBox[{"n", "-", "k"}], ",", "k"}], "]"}]}]}]], "Input",
 InitializationCell->True],

Cell[TextData[{
 "We see that the value of this function coincides with the number of \
partitions produced by ",
 StyleBox[ButtonBox["IntegerPartitions",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/IntegerPartitions"], "FunctionLink"],
 "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Length", "[", 
  RowBox[{"IntegerPartitions", "[", 
   RowBox[{"20", ",", "5"}], "]"}], "]"}]], "Input"],

Cell[BoxData["192"], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"myPartitionsP", "[", 
  RowBox[{"20", ",", "5"}], "]"}]], "Input"],

Cell[BoxData["192"], "Output"]
}, Open  ]],

Cell[TextData[{
 "We can easily extend our function to compute all partitions of an integer \
",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 ", as follows."
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"myPartitionsP", "[", "n_", "]"}], ":=", 
  RowBox[{"myPartitionsP", "[", 
   RowBox[{"n", ",", "n"}], "]"}]}]], "Input"],

Cell["Note that the results agree with the built-in function.", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"myPartitionsP", "[", "15", "]"}]], "Input"],

Cell[BoxData["176"], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PartitionsP", "[", "15", "]"}]], "Input"],

Cell[BoxData["176"], "Output"]
}, Open  ]]
}, Open  ]]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["6.6 Generating Permutations and Combinations", "Section",
 CellTags->"Section6"],

Cell["\<\
In this section, we will implement Algorithm 1 from Section 6.6 of the text \
for generating the next permutation in lexicographic order. Implementing \
Algorithms 2 and 3 will be left as exercises for the reader. \
\>", "Text"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["interchange", "Input"]], "Subsection",
 CellTags->"Section6a"],

Cell["\<\
Before implementing Algorithm 1, we will first write a function to \
interchange two elements in a list. This will be called by the function for \
generating permutations. \
\>", "Text"],

Cell[TextData[{
 "The ",
 StyleBox["interchange", "Input"],
 " function will require three parameters: the list and two integers \
representing the indices to be swapped."
}], "Text"],

Cell["\<\
The function operates as follows. A copy of the list is made. The element in \
the list at the first position to be swapped is assigned to a local variable. \
Then the first position is assigned to the value in the second position. \
Finally, the second position is assigned to the value stored in the temporary \
name and the list is returned.\
\>", "Text"],

Cell["Here is the implementation and an example of applying it. ", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"interchange", "[", 
    RowBox[{"L_List", ",", "i_Integer", ",", "j_Integer"}], "]"}], "/;", 
   RowBox[{
    RowBox[{"0", "<", "i", "\[LessEqual]", 
     RowBox[{"Length", "[", "L", "]"}]}], "&&", 
    RowBox[{"0", "<", "j", "\[LessEqual]", 
     RowBox[{"Length", "[", "L", "]"}]}]}]}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"l", "=", "L"}], ",", "temp"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"temp", "=", 
      RowBox[{"l", "[", 
       RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"l", "[", 
       RowBox[{"[", "i", "]"}], "]"}], "=", 
      RowBox[{"l", "[", 
       RowBox[{"[", "j", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"l", "[", 
       RowBox[{"[", "j", "]"}], "]"}], "=", "temp"}], ";", 
     "\[IndentingNewLine]", "l"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",\

 InitializationCell->True],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"interchange", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "\"\<a\>\"", ",", "\"\<b\>\"", ",", "\"\<c\>\"", ",", "\"\<d\>\"", ",", 
     "\"\<e\>\"", ",", "\"\<f\>\""}], "}"}], ",", "2", ",", "5"}], 
  "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"a\"\>", ",", "\<\"e\"\>", ",", "\<\"c\"\>", ",", "\<\"d\"\>", 
   ",", "\<\"b\"\>", ",", "\<\"f\"\>"}], "}"}]], "Output"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["nextPermutation", "Input"]], "Subsection",
 CellTags->"Section6b"],

Cell[TextData[{
 "The input to the function will be a permutation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["a", "1"], ",", 
     SubscriptBox["a", "2"], ",", "\[Ellipsis]", ",", 
     SubscriptBox["a", "n"]}], "}"}], TraditionalForm]]],
 " of the set ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "\[Ellipsis]", ",", "n"}], "}"}], 
   TraditionalForm]]],
 ". Algorithm 1 consists of three steps: finding the largest ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]]],
 " such that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", "j"], "<", 
    SubscriptBox["a", 
     RowBox[{"j", "+", "1"}]]}], TraditionalForm]]],
 "; finding the smallest ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "k"], TraditionalForm]]],
 " to the right of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "j"], TraditionalForm]]],
 " and interchanging ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "k"], TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "j"], TraditionalForm]]],
 "; and putting the elements in positions ",
 Cell[BoxData[
  FormBox[
   RowBox[{"j", "+", "1"}], TraditionalForm]]],
 " and beyond in increasing order."
}], "Text"],

Cell[TextData[{
 "The first step comprises the first four lines of the body of Algorithm 1 in \
the text, ending with the first comment. The index ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]]],
 " is initialized to the next to last index in the permutation. A ",
 StyleBox[ButtonBox["While",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/While"], "FunctionLink"],
 " loop is used to conduct the search. The body of the loop decreases the \
value of ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]]],
 " by one, and it is controlled by the condition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", "j"], ">", 
    SubscriptBox["a", 
     RowBox[{"j", "+", "1"}]]}], TraditionalForm]]],
 ". When the ",
 StyleBox[ButtonBox["While",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/While"], "FunctionLink"],
 " loop terminates, it will be the case that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", "j"], "<", 
    SubscriptBox["a", 
     RowBox[{"j", "+", "1"}]]}], TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]]],
 " is the largest index for which that is true. Consequently, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", 
     RowBox[{"j", "+", "1"}]], ">", 
    SubscriptBox["a", 
     RowBox[{"j", "+", "2"}]], ">", "\[CenterEllipsis]", ">", 
    SubscriptBox["a", "n"]}], TraditionalForm]]],
 "."
}], "Text"],

Cell[TextData[{
 "The second step is to find the smallest ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "k"], TraditionalForm]]],
 " to the right of and larger than ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "j"], TraditionalForm]]],
 " and interchange the two. Since we are guaranteed that the elements to the \
right of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "j"], TraditionalForm]]],
 " are in increasing order, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "n"], TraditionalForm]]],
 " is the smallest element to the right of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "j"], TraditionalForm]]],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", 
    RowBox[{"n", "-", "1"}]], TraditionalForm]]],
 " is the next smallest, and so on. We are again searching from the right. \
Initialize ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 " to ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 ". A ",
 StyleBox[ButtonBox["While",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/While"], "FunctionLink"],
 " loop is used to decrease ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 " by one so long as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", "j"], ">", 
    SubscriptBox["a", "k"]}], TraditionalForm]]],
 ". When the ",
 StyleBox[ButtonBox["While",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/While"], "FunctionLink"],
 " loop terminates, ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 " will be such that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", "j"], "<", 
    SubscriptBox["a", "k"]}], TraditionalForm]]],
 ". Note that the loop is guaranteed to stop with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", ">", "j"}], TraditionalForm]]],
 " since ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", "j"], "<", 
    SubscriptBox["a", 
     RowBox[{"j", "+", "1"}]]}], TraditionalForm]]],
 ". Once ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]]],
 " has been identified, we interchange ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "j"], TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "k"], TraditionalForm]]],
 " using the ",
 StyleBox["interchange", "Input"],
 " function."
}], "Text"],

Cell[TextData[{
 "The third step is to put the elements of the permutation to the right of \
position ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]]],
 " in increasing order. Note that before the interchange, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", 
    RowBox[{"j", "+", "1"}]], TraditionalForm]]],
 " through ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "n"], TraditionalForm]]],
 " were in decreasing order. After the interchange of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "j"], TraditionalForm]]],
 " with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "k"], TraditionalForm]]],
 ", the tail end of the permutation remains in decreasing order. This is \
because ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "j"], TraditionalForm]]],
 " was smaller than ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "k"], TraditionalForm]]],
 ", but ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "k"], TraditionalForm]]],
 " was the smallest of the entries bigger than ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "j"], TraditionalForm]]],
 ". Thus all of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", 
     RowBox[{"k", "+", "1"}]], ",", "\[Ellipsis]", ",", 
    SubscriptBox["a", "n"]}], TraditionalForm]]],
 " are smaller than ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "j"], TraditionalForm]]],
 ", and all of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", 
     RowBox[{"j", "+", "1"}]], ",", "\[Ellipsis]", ",", 
    SubscriptBox["a", 
     RowBox[{"k", "-", "1"}]]}], TraditionalForm]]],
 " are larger than ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "k"], TraditionalForm]]],
 " which is larger than ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "j"], TraditionalForm]]],
 ". Therefore, "
}], "Text"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["a", 
    RowBox[{"j", "+", "1"}]], ",", "\[Ellipsis]", ",", 
   SubscriptBox["a", 
    RowBox[{"k", "-", "1"}]], ",", 
   SubscriptBox["a", "j"], ",", 
   SubscriptBox["a", 
    RowBox[{"k", "+", "1"}]], ",", "\[Ellipsis]", ",", 
   SubscriptBox["a", "n"]}], TraditionalForm]], "Equation"],

Cell["is in decreasing order.", "Text"],

Cell[TextData[{
 "To put the tail in increasing order, we follow the instructions in the \
pseudocode in the textbook that follows the interchange of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "j"], TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "k"], TraditionalForm]]],
 ". Variables ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox["s", TraditionalForm]]],
 " are initialized to ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"j", "+", "1"}], TraditionalForm]]],
 ", respectively. Provided that ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]]],
 " remains larger than ",
 Cell[BoxData[
  FormBox["s", TraditionalForm]]],
 ", we interchange ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "r"], TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "s"], TraditionalForm]]],
 " and then decrease ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]]],
 " by 1 and increase ",
 Cell[BoxData[
  FormBox["s", TraditionalForm]]],
 " by 1. This has the effect of swapping ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", 
    RowBox[{"j", "+", "1"}]], TraditionalForm]]],
 " with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "n"], TraditionalForm]]],
 ", then ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", 
    RowBox[{"j", "+", "2"}]], TraditionalForm]]],
 " with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", 
    RowBox[{"n", "-", "1"}]], TraditionalForm]]],
 ", then ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", 
    RowBox[{"j", "+", "3"}]], TraditionalForm]]],
 " with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", 
    RowBox[{"n", "-", "2"}]], TraditionalForm]]],
 ", etc."
}], "Text"],

Cell["\<\
Once the tail is in increasing order, the result is the new permutation and \
it is returned. \
\>", "Text"],

Cell[TextData[{
 "We need to add to the function two tests to ensure that the input is valid. \
First, as a ",
 StyleBox[ButtonBox["Condition",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Condition"], "FunctionLink"],
 " (",
 StyleBox["/;", "Input"],
 ") to the function definition, we ensure that the input is a permutation of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "\[Ellipsis]", ",", "n"}], "}"}], 
   TraditionalForm]]],
 ". We do this by sorting the input, using the ",
 StyleBox[ButtonBox["Sort",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Sort"], "FunctionLink"],
 " function, and comparing it with the result of applying ",
 StyleBox[ButtonBox["Range",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Range"], "FunctionLink"],
 " to the ",
 StyleBox[ButtonBox["Length",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Length"], "FunctionLink"],
 " of the input list. Second, as the first expression in the function, we \
check to see if the input is the list ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"n", ",", 
     RowBox[{"n", "-", "1"}], ",", "\[Ellipsis]", ",", "2", ",", "1"}], "}"}],
    TraditionalForm]]],
 ", which is the final permutation in the canonical order. The ",
 StyleBox[ButtonBox["Reverse",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Reverse"], "FunctionLink"],
 " function, applied to a list, simply reverses the order of the list. This \
is used in conjunction with ",
 StyleBox[ButtonBox["Range",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Range"], "FunctionLink"],
 " to produce the list ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"n", ",", 
     RowBox[{"n", "-", "1"}], ",", "\[Ellipsis]", ",", "2", ",", "1"}], "}"}],
    TraditionalForm]]],
 ", which is compared to the input. If they agree, ",
 StyleBox[ButtonBox["Return",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Return"], "FunctionLink"],
 " is used to terminate the function and cause the output to be ",
 StyleBox[ButtonBox["Null",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Null"], "FunctionLink"],
 "."
}], "Text"],

Cell["Here is the implementation. ", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"nextPermutation", "[", "A_List", "]"}], "/;", 
   RowBox[{
    RowBox[{"Sort", "[", "A", "]"}], "\[Equal]", 
    RowBox[{"Range", "[", 
     RowBox[{"Length", "[", "A", "]"}], "]"}]}]}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"a", "=", "A"}], ",", 
      RowBox[{"n", "=", 
       RowBox[{"Length", "[", "A", "]"}]}], ",", "i", ",", "j", ",", "k", ",",
       "r", ",", "s"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"a", "\[Equal]", 
        RowBox[{"Reverse", "[", 
         RowBox[{"Range", "[", "n", "]"}], "]"}]}], ",", 
       RowBox[{"Return", "[", "Null", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"step", " ", "1"}], ":", " ", 
       RowBox[{"find", " ", "j"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"j", "=", 
      RowBox[{"n", "-", "1"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"a", "[", 
         RowBox[{"[", "j", "]"}], "]"}], ">", 
        RowBox[{"a", "[", 
         RowBox[{"[", 
          RowBox[{"j", "+", "1"}], "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"j", "=", 
        RowBox[{"j", "-", "1"}]}]}], "\[IndentingNewLine]", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"step", " ", "2"}], ":", " ", 
       RowBox[{
       "find", " ", "k", " ", "and", " ", "interchange", " ", "aj", " ", 
        "and", " ", "ak"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"k", "=", "n"}], ";", "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"a", "[", 
         RowBox[{"[", "j", "]"}], "]"}], ">", 
        RowBox[{"a", "[", 
         RowBox[{"[", "k", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"k", "=", 
        RowBox[{"k", "-", "1"}]}]}], "\[IndentingNewLine]", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"a", "=", 
      RowBox[{"interchange", "[", 
       RowBox[{"a", ",", "j", ",", "k"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"step", " ", "3"}], ":", " ", 
       RowBox[{"sort", " ", "the", " ", "tail"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"r", "=", "n"}], ";", "\[IndentingNewLine]", 
     RowBox[{"s", "=", 
      RowBox[{"j", "+", "1"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{"r", ">", "s"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"a", "=", 
         RowBox[{"interchange", "[", 
          RowBox[{"a", ",", "r", ",", "s"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"r", "=", 
         RowBox[{"r", "-", "1"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"s", "=", 
         RowBox[{"s", "+", "1"}]}]}]}], "\[IndentingNewLine]", "]"}], ";", 
     "\[IndentingNewLine]", "a"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",\

 InitializationCell->True],

Cell["\<\
Example 2 of Section 6.6 finds that the permutation after 362541 is 364125. \
Let's use that example to confirm that our function is working. \
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"nextPermutation", "[", 
  RowBox[{"{", 
   RowBox[{"3", ",", "6", ",", "2", ",", "5", ",", "4", ",", "1"}], "}"}], 
  "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "6", ",", "4", ",", "1", ",", "2", ",", "5"}], 
  "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "To generate all permutations of a set ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "\[Ellipsis]", ",", "n"}], "}"}], 
   TraditionalForm]]],
 " we use a ",
 StyleBox[ButtonBox["While",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/While"], "FunctionLink"],
 " loop."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"aperm", "=", 
   RowBox[{"Range", "[", "4", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"While", "[", 
  RowBox[{
   RowBox[{"aperm", "=!=", "Null"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "aperm", "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"aperm", "=", 
     RowBox[{"nextPermutation", "[", "aperm", "]"}]}]}]}], 
  "\[IndentingNewLine]", "]"}]}], "Input"],

