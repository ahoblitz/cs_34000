         "13576763067144082109859764943426215110923900940995100861638392126957\
291410917608911489552935725380527448262970047404815772410095615122011337654446\
", 
          RowBox[{"\[LeftSkeleton]", "60205707", "\[RightSkeleton]"}], 
          "4347580097059138134536253777721694042210623817508491267308464323788\
014197939109068927095524265411013142858298323361401629914610165163562737871093\
76"}],
         Short[#, 5]& ],
