<Group view="presentation" hide-input="false" hide-output="true" inline-output="false" labelreference="L969" drawlabel="true">
<Input>
<Text-field style="Text" layout="Normal">From the above, you can see that 2, 6, 7, and 8 are all primitive roots of 11.  </Text-field>
