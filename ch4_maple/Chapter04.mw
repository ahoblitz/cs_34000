<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">mersenne(19);</Text-field>
</Input>
<Output>
<Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output">IicoR0Mm</Equation></Text-field>
</Output>
</Group>
<Group labelreference="L765" drawlabel="true">
