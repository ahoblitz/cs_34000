<Text-field prompt="&gt; " style="Maple Input" layout="Normal">yList := [seq(8+10*k,k=-10..10)];</Text-field>
</Input>
<Output>
<Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">NzchIyMqISMjKSEjcyEjaSEjXyEjVSEjSyEjQSEjNyEiIyIiKSIjPSIjRyIjUSIjWyIjZSIjbyIjeSIjKSkiIykqIiQzIg==</Equation></Text-field>
</Output>
</Group></Presentation-Block><Presentation-Block>
<Group view="presentation" hide-input="false" hide-output="true" inline-output="false" labelreference="L984" drawlabel="true">
<Input>
<Text-field style="Text" layout="Normal">Computing <Equation executable="false" style="2D Math" input-equation="" display=""></Equation> for these values confirms that each is a solution to <Equation executable="false" style="2D Math" input-equation="" display=""></Equation>.</Text-field>
