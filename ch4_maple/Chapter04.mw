</Input>
<Output>
<Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">PTYiSSZmYWxzZUclKnByb3RlY3RlZEdFXFtsI1EkR1BBRiMkIiRVJCEiI1EjSURGIyIleWw=</Equation></Text-field>
</Output>
