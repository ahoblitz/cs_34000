</Input>
<Output>
<Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output">IiMmKg==</Equation></Text-field>
</Output>
</Group>
<Group autoexecute="true" view="code" labelreference="L1992" drawlabel="true">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">RatsTo18 := ListRationals(18):</Text-field>
</Input>
</Group>
<Group view="code" labelreference="L1993" drawlabel="true">
