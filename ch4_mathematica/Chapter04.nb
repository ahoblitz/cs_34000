   RowBox[{"{", 
    RowBox[{"2908", ",", "2.89`"}], "}"}]}],
  SequenceForm[2, " ", {2908, 2.89}],
  Editable->False]], "Print",
 CellChangeTimes->{3.5806482395511503`*^9}],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"15", "\[InvisibleSpace]", "\<\" \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{"1325", ",", "3.14`"}], "}"}]}],
  SequenceForm[15, " ", {1325, 3.14}],
  Editable->False]], "Print",
 CellChangeTimes->{3.5806482395582647`*^9}],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"24", "\[InvisibleSpace]", "\<\" \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{"7319", ",", "3.21`"}], "}"}]}],
  SequenceForm[24, " ", {7319, 3.21}],
  Editable->False]], "Print",
 CellChangeTimes->{3.580648239563141*^9}],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"25", "\[InvisibleSpace]", "\<\" \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{"6578", ",", "3.42`"}], "}"}]}],
  SequenceForm[25, " ", {6578, 3.42}],
  Editable->False]], "Print",
 CellChangeTimes->{3.580648239567931*^9}],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"51", "\[InvisibleSpace]", "\<\" \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{"2216", ",", "1.98`"}], "}"}]}],
  SequenceForm[51, " ", {2216, 1.98}],
  Editable->False]], "Print",
 CellChangeTimes->{3.5806482395730133`*^9}],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"52", "\[InvisibleSpace]", "\<\" \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{"7061", ",", "3.51`"}], "}"}]}],
  SequenceForm[52, " ", {7061, 3.51}],
  Editable->False]], "Print",
 CellChangeTimes->{3.5806482395777397`*^9}]
