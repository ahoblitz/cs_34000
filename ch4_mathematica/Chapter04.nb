Cell[BoxData[
 InterpretationBox[
  RowBox[{"2", "\[InvisibleSpace]", "\<\" \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{"2908", ",", "2.89`"}], "}"}]}],
  SequenceForm[2, " ", {2908, 2.89}],
  Editable->False]], "Print",
 CellChangeTimes->{3.580648239365917*^9}],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"24", "\[InvisibleSpace]", "\<\" \"\>", "\[InvisibleSpace]", 
