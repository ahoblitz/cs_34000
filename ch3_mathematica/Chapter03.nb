Cell[TextData[{
 "If you wish to specify different values for the maximum and minimum for the \
vertical axis, you can do so with a list consisting of the two values. The \
following shows ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "(", "x", ")"}], TraditionalForm]]],
 " on the domain ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"0", ",", "10"}], "]"}], TraditionalForm]]],
 " with the vertical axis ranging from ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1000"}], TraditionalForm]]],
 " to ",
 Cell[BoxData[
  FormBox["5000", TraditionalForm]]],
 "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{"f1", ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "10"}], "}"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1000"}], ",", "5000"}], "}"}]}]}], "]"}]], "Input"],

