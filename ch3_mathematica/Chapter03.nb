Cell[CellGroupData[{

Cell["Exercises", "Section",
 CellTags->"Exercises"],

Cell[CellGroupData[{

Cell[TextData[{
 "Write step-by-step instructions, then pseudocode, and then implement in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " an algorithm to determine the ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 " largest integers in a list of integers."
}], "Item1Exercise"],

Cell["\<\
Implement the linear search presented as Algorithm 2 in Section 3.1 of the \
text. \
\>", "Item1Exercise"],

Cell["\<\
Implement the insertion sort presented as Algorithm 5 in Section 3.1 of the \
text. \
\>", "Item1Exercise"],

Cell["\<\
Implement the greedy change-making algorithm presented as Algorithm 6 in \
Section 3.1 of the text. \
\>", "Item1Exercise"],

Cell["\<\
Implement the algorithm for scheduling talks presented as Algorithm 7 in \
Section 3.1 of the text. \
\>", "Item1Exercise"],

Cell["\<\
Implement the brute-force algorithm for finding the closest pair of points as \
presented in Algorithm 3 in Section 3.3 of the text. \
\>", "Item1Exercise"],

Cell[TextData[{
 "Modify the ",
 StyleBox["bubbleSort", "Input"],
 " function so that it terminates when no more interchanges are necessary. \
(See Exercise 37 from Section 3.1.)"
}], "Item1Exercise"],

Cell[TextData[{
 "Implement the selection sort algorithm in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ". (Refer to the preamble to Exercise 41 in Section 3.1 for information on \
selection sort.) "
}], "Item1Exercise"],

Cell[TextData[{
 "Implement the binary insertion sort in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ". (Refer to the preamble to Exercise 47 in Section 3.1 for information on \
the binary insertion sort.)"
}], "Item1Exercise"],

Cell[TextData[{
 "Implement the deferred acceptance algorithm in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ". (Refer to the preamble to Exercise 61 in Section 3.1 for information on \
the deferred acceptance algorithm.)"
}], "Item1Exercise"],

Cell[TextData[{
 "Following the solution to Computations and Explorations 1, use ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " to determine values for ",
 Cell[BoxData[
  FormBox["C", TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 " that witness for the fact that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "(", "x", ")"}], TraditionalForm]]],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    RowBox[{"g", "(", "x", ")"}], ")"}], TraditionalForm]]],
 " for each of the pairs of functions given below."
}], "Item1Exercise"],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "x", ")"}], "=", 
    RowBox[{"7", "\[CenterDot]", 
     RowBox[{"ln", "(", 
      RowBox[{
       RowBox[{"3", 
        SuperscriptBox["x", "2"]}], "-", 
       RowBox[{"2", "x"}], "+", "5"}], ")"}]}]}], TraditionalForm]]],
 "; ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", "(", "x", ")"}], "=", "x"}], TraditionalForm]]]
}], "Item2Exercise"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "x", ")"}], "=", 
    FractionBox[
     SuperscriptBox["x", "4"], 
     RowBox[{
      SuperscriptBox["x", "2"], "-", 
      RowBox[{"4", "x"}], "-", "4"}]]}], TraditionalForm]]],
 "; ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", "(", "x", ")"}], "=", 
    SuperscriptBox["x", "2"]}], TraditionalForm]]]
}], "Item2Exercise"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "x", ")"}], "=", 
    RowBox[{
     RowBox[{"\[LeftFloor]", "x", "\[RightFloor]"}], "\[CenterDot]", 
     RowBox[{"\[LeftCeiling]", "x", "\[RightCeiling]"}]}]}], 
   TraditionalForm]]],
 "; ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", "(", "x", ")"}], "=", 
    SuperscriptBox["x", "2"]}], TraditionalForm]]]
}], "Item2Exercise"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "x", ")"}], "=", 
    RowBox[{"n", "\[CenterDot]", 
     RowBox[{"ln", "(", "n", ")"}]}]}], TraditionalForm]]],
 "; ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", "(", "x", ")"}], "=", 
    RowBox[{"ln", "(", 
     RowBox[{"n", "!"}], ")"}]}], TraditionalForm]]]
}], "Item2Exercise"]
}, Open  ]],

Cell[TextData[{
 "Using the approach described in Section 3.3 of this manual, compare the \
average-case performance of the ",
 StyleBox["bubbleSort", "Input"],
 " function presented in Section 3.1 to ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s ",
 StyleBox[ButtonBox["Sort",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Sort"], "FunctionLink"],
 " function."
}], "Item1Exercise"],

Cell[TextData[{
 "Using the solution to Computer Project 9 as a model, compare the \
average-case complexity (as measured by number of comparisons) of the ",
 StyleBox["bubbleSort", "Input"],
 " function with the modified procedure that you implemented as Exercise 7. "
}], "Item1Exercise"],

Cell[TextData[{
 "Using the solution to Computer Project 9 as a model, compare the \
average-case complexity (as measured by number of comparisons) of the ",
 StyleBox["bubbleSort", "Input"],
 " function with the other sort procedures you wrote (e.g., insertion sort, \
selection sort, or binary selection sort)."
}], "Item1Exercise"]
}, Open  ]]
}, Closed]]
}, Open  ]]
},
