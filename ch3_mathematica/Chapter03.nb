Cell[TextData[{
 "Note that ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " automatically selects the vertical range of the graph. You can control \
this with the ",
 StyleBox[ButtonBox["PlotRange",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/PlotRange"], "FunctionLink"],
 " option. The first two common values for ",
 StyleBox[ButtonBox["PlotRange",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/PlotRange"], "FunctionLink"],
 " are ",
 StyleBox["Automatic", "Input"],
 " and ",
 StyleBox["All", "Input"],
 ". The ",
 StyleBox["Automatic", "Input"],
 " value has the same effect as omitting the option. The difference between \
",
 StyleBox["Automatic", "Input"],
 " and ",
 StyleBox["All", "Input"],
 " is that, in certain circumstances, ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " may decide that parts of the function being graphed are outliers and may \
choose to omit them when using the ",
 StyleBox["Automatic", "Input"],
 " plot range. The ",
 StyleBox["All", "Input"],
 " value forces ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " to display the entire function. This is illustrated below, where we have \
graphed ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "10"], TraditionalForm]]],
 " with both options. "
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"x", "^", "10"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "5"}], "}"}], ",", 
     RowBox[{"PlotRange", "\[Rule]", "Automatic"}]}], "]"}], ",", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"x", "^", "10"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "5"}], "}"}], ",", 
     RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]}], "}"}]], "Input"],

