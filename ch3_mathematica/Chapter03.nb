Cell[CellGroupData[{

Cell["Computations and Explorations 1", "Subsection",
 PageBreakWithin->False,
 CellTags->"SolutionsCE1"],

Cell[TextData[{
 "We know that ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["n", "b"], TraditionalForm]]],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    SuperscriptBox["d", "n"], ")"}], TraditionalForm]]],
 " when ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox["d", TraditionalForm]]],
 " are positive numbers with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "\[GreaterEqual]", "2"}], TraditionalForm]]],
 ". Give values of the constants ",
 Cell[BoxData[
  FormBox["C", TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 " such that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["n", "b"], "\[LessEqual]", 
    RowBox[{"C", "\[CenterDot]", 
     SuperscriptBox["d", "n"]}]}], TraditionalForm]]],
 " whenever ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", ">", "k"}], TraditionalForm]]],
 " for each of these sets of values: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", "=", "10"}], TraditionalForm]]],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", "2"}], TraditionalForm]]],
 "; ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", "=", "20"}], TraditionalForm]]],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", "3"}], TraditionalForm]]],
 "; ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", "=", "1000"}], TraditionalForm]]],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", "7"}], TraditionalForm]]],
 "."
}], "Problem",
 PageBreakAbove->False,
 PageBreakWithin->False],

Cell[TextData[{
 StyleBox["Solution:",
  FontSlant->"Italic"],
 " For ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", "=", "10"}], TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", "2"}], TraditionalForm]]],
 ", we need to compare the function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "n", ")"}], "=", 
    SuperscriptBox["n", "10"]}], TraditionalForm]]],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", "(", "n", ")"}], "=", 
    SuperscriptBox["2", "n"]}], TraditionalForm]]],
 ". Following the approach we took in Section 3.2, we will use ",
 StyleBox[ButtonBox["Manipulate",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Manipulate"], "FunctionLink"],
 " to graph the functions while dynamically changing the value of ",
 Cell[BoxData[
  FormBox["C", TraditionalForm]]],
 ". Note that the values of ",
 Cell[BoxData[
  FormBox["C", TraditionalForm]]],
 " that will suffice with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "<", "20"}], TraditionalForm]]],
 " are extremely large. When exploring other values of ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox["d", TraditionalForm]]],
 ", you may have to modify the maximum values for ",
 Cell[BoxData[
  FormBox["C", TraditionalForm]]],
 ". It is also possible to find smaller values of ",
 Cell[BoxData[
  FormBox["C", TraditionalForm]]],
 " by increasing the horizontal extent of the graph."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", "^", "10"}], ",", 
       RowBox[{"c", "*", 
        RowBox[{"2", "^", "n"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", "20"}], "}"}], ",", 
     RowBox[{"PlotLegends", "\[Rule]", "\"\<Expressions\>\""}]}], "]"}], ",", 
   
   RowBox[{"{", 
    RowBox[{"c", ",", "0", ",", 
     RowBox[{"10", "^", "8"}]}], "}"}]}], "]"}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 TagBox[
  StyleBox[
   DynamicModuleBox[{$CellContext`c$$ = 0, Typeset`show$$ = True, 
    Typeset`bookmarkList$$ = {}, Typeset`bookmarkMode$$ = "Menu", 
    Typeset`animator$$, Typeset`animvar$$ = 1, Typeset`name$$ = 
    "\"untitled\"", Typeset`specs$$ = {{
      Hold[$CellContext`c$$], 0, 100000000}}, Typeset`size$$ = {
    434., {102., 107.}}, Typeset`update$$ = 0, Typeset`initDone$$, 
    Typeset`skipInitDone$$ = True, $CellContext`c$150379$$ = 0}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, "Variables" :> {$CellContext`c$$ = 0}, 
      "ControllerVariables" :> {
        Hold[$CellContext`c$$, $CellContext`c$150379$$, 0]}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$}, "Body" :> 
      Plot[{$CellContext`n^10, $CellContext`c$$ 
         2^$CellContext`n}, {$CellContext`n, 0, 20}, PlotLegends -> 
        "Expressions"], 
