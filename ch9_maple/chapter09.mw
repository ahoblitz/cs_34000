<Group view="code" labelreference="L122" drawlabel="true">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">ProjectRelation(R3, [2,4]);</Text-field>
</Input>
<Output>
<Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output">PCU3JCIoWEIsKiQiJClIISIjNyQiKGIrNSokIiQqXEYnNyQiKEBWTiokIiRtJEYn</Equation></Text-field>
</Output>
</Group>
