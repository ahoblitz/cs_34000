</Input>
<Output>
<Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output">PCU3JVEtRmlsbX5TdHVkaWVzNiIkIiQqXCEiI1EkV29vRiU3JVEsTWF0aGVtYXRpY3NGJSQiJG0kRihRKVdhcnNoYWxsRiU3JVEpUG9saXRpY3NGJSQiJClIRihRJkFkYW1zRiU=</Equation></Text-field>
</Output>
