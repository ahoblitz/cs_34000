<Input>
<Text-field style="Text" layout="Normal">Now we turn to the <Font executable="false" style="Maple Input">mergesort</Font> procedure. We repeat its definition below.</Text-field>
</Input>
</Group>
<Group view="code" labelreference="L689" drawlabel="true">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">mergesort := proc(L::list(integer))
  local m, L1, L2;
  if nops(L) &gt; 1 then
    m := floor(nops(L)/2);
    L1 := L[1..m];
    L2 := L[(m+1)..-1];
    return merge(mergesort(L1),mergesort(L2));
  else
    return L;
  end if;
end proc:</Text-field>
</Input>
</Group></Presentation-Block><Presentation-Block>
