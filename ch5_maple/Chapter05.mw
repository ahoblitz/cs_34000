<Group view="code" labelreference="L624" drawlabel="true">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">merge := proc(l1::list(integer),l2::list(integer))
  local L, L1, L2;
  # begin S1
   L1 := l1;
   L2 := l2;
   L := [];
  # end S1
  while L1 &lt;&gt; [] and L2 &lt;&gt; [] do
    # begin S2
     if L1[1] &lt; L2[1] then
       L := [op(L),L1[1]];
       L1 := L1[2..-1];
     else
       L := [op(L),L2[1]];
       L2 := L2[2..-1];
     end if;
    # end S2
    # begin S3
     if L1 = [] then
       L := [op(L),op(L2)];
       L2 := [];
     elif L2 = [] then
       L := [op(L),op(L1)];
       L1 := [];
     end if;
    # end S3
  end do;
  return L;
end proc:</Text-field>
</Input>
</Group></Presentation-Block><Presentation-Block>
