Cell[CellGroupData[{

Cell["Conditional Probabilities", "Subsubsection"],

Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " allows you to calculate with conditional probabilities using the ",
 StyleBox[ButtonBox["Conditioned",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Conditioned"], "FunctionLink"],
 " (",
 StyleBox["\[Conditioned]", "Input"],
 ") operator. The operator symbol is entered by \[EscapeKey]cond\[EscapeKey]. \
For example, consider a binomial random variable ",
 Cell[BoxData[
  FormBox["X", TraditionalForm]]],
 " with parameters 20 and ",
 Cell[BoxData[
  FormBox["0.3", TraditionalForm]]],
 ". The probability that ",
 Cell[BoxData[
  FormBox["X", TraditionalForm]]],
 " is greater than 5 given that it is less than 10, that is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "(", 
    RowBox[{
     RowBox[{"X", ">", "5"}], "|", 
     RowBox[{"X", "<", "10"}]}], ")"}], TraditionalForm]]],
 " can be compute as shown below."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Probability", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"X", ">", "5"}], "\[Conditioned]", 
    RowBox[{"X", "<", "10"}]}], ",", 
   RowBox[{"X", "\[Distributed]", 
    RowBox[{"BinomialDistribution", "[", 
     RowBox[{"20", ",", ".3"}], "]"}]}]}], "]"}]], "Input"],

Cell[BoxData["0.5626531876399129`"], "Output"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Defining Distributions from Data", "Subsubsection"],

Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " provides the ",
 StyleBox[ButtonBox["EmpiricalDistribution",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/EmpiricalDistribution"], "FunctionLink"],
 " function to allow you to define, and thus compute with, discrete \
probability distributions from your own data. There are two ways to use the \
",
 StyleBox[ButtonBox["EmpiricalDistribution",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/EmpiricalDistribution"], "FunctionLink"],
 " function."
}], "Text"],

Cell[TextData[{
 "If you have a list of values representing the results of experiments, you \
can pass this list of data to ",
 StyleBox[ButtonBox["EmpiricalDistribution",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/EmpiricalDistribution"], "FunctionLink"],
 ". For example, suppose you manually roll a die 20 times and obtain the \
following results."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dieRolls", "=", 
  RowBox[{"{", 
   RowBox[{
   "3", ",", "2", ",", "1", ",", "1", ",", "5", ",", "2", ",", "3", ",", "6", 
    ",", "5", ",", "1", ",", "2", ",", "5", ",", "6", ",", "4", ",", "4", ",",
     "3", ",", "1", ",", "3", ",", "1", ",", "1"}], "}"}]}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "3", ",", "2", ",", "1", ",", "1", ",", "5", ",", "2", ",", "3", ",", "6", 
   ",", "5", ",", "1", ",", "2", ",", "5", ",", "6", ",", "4", ",", "4", ",", 
   "3", ",", "1", ",", "3", ",", "1", ",", "1"}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "To use this as the basis for a distribution, simply give the list as the \
argument to ",
 StyleBox[ButtonBox["EmpiricalDistribution",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/EmpiricalDistribution"], "FunctionLink"],
 ". We\[CloseCurlyQuote]ll assign the distribution to a symbol."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dieDistribution", "=", 
  RowBox[{"EmpiricalDistribution", "[", "dieRolls", "]"}]}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 TagBox[
  RowBox[{"DataDistribution", "[", "\[LeftSkeleton]", 
   TagBox["\<\"Empirical\"\>",
    Editable -> False], "\[RightSkeleton]", ",", 
   TagBox[
    RowBox[{"{", "20", "}"}],
    Editable -> False], "]"}],
  InterpretTemplate[DataDistribution[#, {{
      Rational[3, 10], 
      Rational[3, 20], 
      Rational[1, 5], 
      Rational[1, 10], 
      Rational[3, 20], 
      Rational[1, 10]}, {1, 2, 3, 4, 5, 6}, False}, 1, 
    First[#2]]& ],
  Editable->False,
  SelectWithContents->True,
  Selectable->True]], "Output"]
}, Open  ]],

Cell[TextData[{
 "The output is giving you a peek at the internal representation of the \
distribution. What\[CloseCurlyQuote]s important for us is that we can now use \
",
 StyleBox["dieDistribution", "Input"],
 " as a probability distribution in functions like ",
 StyleBox[ButtonBox["Probability",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Probability"], "FunctionLink"],
 ". For example, we can calculate the probability that the die shows a value \
of 4 or less."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Probability", "[", 
  RowBox[{
   RowBox[{"X", "\[LessEqual]", "4"}], ",", 
   RowBox[{"X", "\[Distributed]", "dieDistribution"}]}], "]"}]], "Input"],

Cell[BoxData[
 FractionBox["3", "4"]], "Output"]
}, Open  ]],

Cell[TextData[{
 "The second way you can use ",
 StyleBox[ButtonBox["EmpiricalDistribution",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/EmpiricalDistribution"], "FunctionLink"],
 " is to explicitly specify each data value and corresponding weights. As an \
example, consider the following problem. A die is weighted so that the \
probability of a 1 is ",
 Cell[BoxData[
  FormBox[
   FractionBox["2", "9"], TraditionalForm]]],
 ", the probability of a 2 is ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "3"], TraditionalForm]]],
 ", and the probability of the other values is ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "9"], TraditionalForm]]],
 " each. What is the probability that value is less than 3 when it is \
rolled?"
}], "Text"],

Cell[TextData[{
 "To specify probabilities associated to specific values, you need to list \
the probabilities (or weights) and the values and join the two lists with a \
",
 StyleBox[ButtonBox["Rule",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Rule"], "FunctionLink"],
 " (",
 StyleBox["->", "Input"],
 "). The following is the distribution of the die described above."
}], "Text"],

Cell[BoxData[
 RowBox[{"EmpiricalDistribution", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"2", "/", "9"}], ",", 
     RowBox[{"1", "/", "3"}], ",", 
     RowBox[{"1", "/", "9"}], ",", 
     RowBox[{"1", "/", "9"}], ",", 
     RowBox[{"1", "/", "9"}], ",", 
     RowBox[{"1", "/", "9"}]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "5", ",", "6"}], "}"}]}], 
  "]"}]], "myCode"],

Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " interprets this as meaning that the data values in the right hand list are \
weighted as per the corresponding entry in the left hand list. That is, 1 has \
probability ",
 Cell[BoxData[
  FormBox[
   FractionBox["2", "9"], TraditionalForm]]],
 ", 2 has probability ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "3"], TraditionalForm]]],
 ", etc. Note that it is not necessary for the weights in the left hand list \
to be probabilities. ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " computes the probabilities of the data values by dividing the \
corresponding weight value by the sum of the weights. So the following will \
also produce the correct distribution for the die."
}], "Text"],

Cell[BoxData[
 RowBox[{"EmpiricalDistribution", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "3", ",", "1", ",", "1", ",", "1", ",", "1"}], "}"}], 
   "\[Rule]", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "5", ",", "6"}], "}"}]}], 
  "]"}]], "myCode"],

Cell[TextData[{
 "The following, therefore, computes the probability that the value is less \
than 3. Note that we use ",
 StyleBox[ButtonBox["Range",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Range"], "FunctionLink"],
 " rather than type the integers 1 through 6."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Probability", "[", 
  RowBox[{
   RowBox[{"X", "<", "3"}], ",", 
   RowBox[{"X", "\[Distributed]", 
    RowBox[{"EmpiricalDistribution", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "3", ",", "1", ",", "1", ",", "1", ",", "1"}], "}"}],
       "\[Rule]", 
      RowBox[{"Range", "[", "6", "]"}]}], "]"}]}]}], "]"}]], "Input"],

Cell[BoxData[
 FractionBox["5", "9"]], "Output"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Combining Empirical Distributions", "Subsubsection"],

Cell[TextData[{
 "A more interesting question is to compute probabilities for the sum of the \
values on a weighted die. For example, consider two loaded dice. One is \
weighted so that the probability that a 1 appears is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "/", "7"}], TraditionalForm]]],
 " and the probabilities of all other values is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "7"}], TraditionalForm]]],
 ". The other is weighted to that the probability of a 4 appearing is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "/", "8"}], TraditionalForm]]],
 " and the probabilities of all other values is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "8"}], TraditionalForm]]],
 ". What is the probability that the sum is 7 when the two dice are rolled?"
}], "Text"],

Cell["\<\
To answer this question, we first define two empirical distributions, just as \
done above. Here we assign the distributions to symbols.\
\>", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"weighted1", "=", 
   RowBox[{"EmpiricalDistribution", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "1", ",", "1", ",", "1", ",", "1", ",", "1"}], "}"}], 
     "\[Rule]", 
     RowBox[{"Range", "[", "6", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"weighted2", "=", 
   RowBox[{"EmpiricalDistribution", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "1", ",", "3", ",", "1", ",", "1"}], "}"}], 
     "\[Rule]", 
     RowBox[{"Range", "[", "6", "]"}]}], "]"}]}], ";"}]}], "Input",
 InitializationCell->True],

Cell["\<\
The example above using two Bernoulli distributions suggests that the \
probability of the sum being 7 can be computed as below.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Probability", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"X", "+", "Y"}], "\[Equal]", "7"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"X", "\[Distributed]", "weighted1"}], ",", 
     RowBox[{"Y", "\[Distributed]", "weighted2"}]}], "}"}]}], "]"}]], "Input",\

 InitializationCell->True],

Cell[BoxData[
 FractionBox["9", "56"]], "Output"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Sampling", "Subsubsection"],

Cell[TextData[{
 "Given a particular distribution, you may wish to use it to conduct \
experiments or simulations. The process of generating pseudo-random numbers \
according to a given probability distribution is referred to as sampling. In ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ", the ",
 StyleBox[ButtonBox["RandomVariate",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/RandomVariate"], "FunctionLink"],
 " function is used to sample."
}], "Text"],

Cell[TextData[{
 "Recall that a random variable is a function that assigns a real number to \
each possible outcome in a sample space (Definition 6 in Section 7.2 of the \
textbook). A ",
 StyleBox["random variate",
  FontSlant->"Italic"],
 " is a real number obtained by applying the random variable to an outcome \
selected pseudo-randomly according to a specified probability distribution. \
In other words, where a random variable describes the relationship between an \
experiment\[CloseCurlyQuote]s sample space and real numbers, a random variate \
is a particular value obtained by performing the experiment."
}], "Text"],

Cell[TextData[{
 "Applying ",
 StyleBox[ButtonBox["RandomVariate",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/RandomVariate"], "FunctionLink"],
 " to a probability distribution produces a single random sample from that \
distribution. For example, the following expression simulates a binomial \
experiment with 10 trials and probability of success ",
 Cell[BoxData[
  FormBox["0.4", TraditionalForm]]],
 "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RandomVariate", "[", 
  RowBox[{"BinomialDistribution", "[", 
   RowBox[{"10", ",", ".4"}], "]"}], "]"}]], "Input"],

Cell[BoxData["4"], "Output"]
}, Open  ]],

Cell["\<\
Providing a positive integer as a second argument produces a list of that \
many values. For example, the following simulates a binomial process 1000 \
times.\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"binomialData", "=", 
   RowBox[{"RandomVariate", "[", 
    RowBox[{
     RowBox[{"BinomialDistribution", "[", 
      RowBox[{"20", ",", ".3"}], "]"}], ",", "1000"}], "]"}]}], 
  ";"}]], "Input",
 InitializationCell->True],

Cell[TextData[{
 "We can use the ",
 StyleBox[ButtonBox["Histogram",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Histogram"], "FunctionLink"],
 " function to draw a histogram of the data. You see that the data produced \
has approximately the same shape as was produced with ",
 StyleBox[ButtonBox["PDF",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/PDF"], "FunctionLink"],
 " above. We use the ",
 StyleBox[ButtonBox["PlotRange",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/PlotRange"], "FunctionLink"],
 " option, first described in Section 2.3, to ensure the graph shows all of \
the possible values, not just those actually obtained."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Histogram", "[", 
  RowBox[{"binomialData", ",", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "20"}], "}"}], ",", "Full"}], "}"}]}]}], 
  "]"}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 GraphicsBox[
  {RGBColor[0.798413061722744, 0.824719615472648, 0.968322270542458], 
   EdgeForm[Opacity[0.595]], {}, 
   {RGBColor[0.798413061722744, 0.824719615472648, 0.968322270542458], 
    EdgeForm[Opacity[0.595]], 
    TagBox[
     TooltipBox[
      TagBox[
       DynamicBox[{
         FEPrivate`If[
          CurrentValue["MouseOver"], 
          EdgeForm[{
            GrayLevel[0.5], 
            AbsoluteThickness[1.5], 
            Opacity[0.66]}], {}, {}], 
         RectangleBox[{0., 0}, {1., 1}, "RoundingRadius" -> 0]},
        ImageSizeCache->{{17.5, 35.3}, {91.2175828902744, 93.2161637088185}}],
       
       StatusArea[#, 1]& ,
       TagBoxNote->"1"],
      StyleBox["1", {
        GrayLevel[0]}, StripOnInput -> False]],
     Annotation[#, 
      Style[1, {
        GrayLevel[0]}], "Tooltip"]& ], 
    TagBox[
     TooltipBox[
      TagBox[
       DynamicBox[{
         FEPrivate`If[
          CurrentValue["MouseOver"], 
          EdgeForm[{
            GrayLevel[0.5], 
            AbsoluteThickness[1.5], 
            Opacity[0.66]}], {}, {}], 
         RectangleBox[{1., 0}, {2., 3}, "RoundingRadius" -> 0]},
        ImageSizeCache->{{34.3, 52.1}, {89.22042125318622, 93.2161637088185}}],
       StatusArea[#, 3]& ,
       TagBoxNote->"3"],
      StyleBox["3", {
        GrayLevel[0]}, StripOnInput -> False]],
     Annotation[#, 
      Style[3, {
        GrayLevel[0]}], "Tooltip"]& ], 
    TagBox[
     TooltipBox[
      TagBox[
       DynamicBox[{
         FEPrivate`If[
          CurrentValue["MouseOver"], 
          EdgeForm[{
            GrayLevel[0.5], 
            AbsoluteThickness[1.5], 
            Opacity[0.66]}], {}, {}], 
         RectangleBox[{2., 0}, {3., 28}, "RoundingRadius" -> 0]},
        ImageSizeCache->{{51.1, 68.9}, {64.25590078958392, 93.2161637088185}}],
       StatusArea[#, 28]& ,
       TagBoxNote->"28"],
      StyleBox["28", {
        GrayLevel[0]}, StripOnInput -> False]],
     Annotation[#, 
      Style[28, {
        GrayLevel[0]}], "Tooltip"]& ], 
    TagBox[
     TooltipBox[
      TagBox[
       DynamicBox[{
         FEPrivate`If[
          CurrentValue["MouseOver"], 
          EdgeForm[{
            GrayLevel[0.5], 
            AbsoluteThickness[1.5], 
            Opacity[0.66]}], {}, {}], 
         RectangleBox[{3., 0}, {4., 68}, "RoundingRadius" -> 0]},
        ImageSizeCache->{{67.9, 85.7}, {24.312668047820225`, 
