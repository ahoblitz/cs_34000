   ",", "\<\"expense\"\>", ",", "\<\"of\"\>", ",", "\<\"many\"\>", 
   ",", "\<\"a\"\>", ",", "\<\"vanish'd\"\>", ",", "\<\"sight\"\>", 
   ",", "\<\"Then\"\>", ",", "\<\"can\"\>", ",", "\<\"I\"\>", 
