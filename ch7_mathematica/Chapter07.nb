   ",", "\<\"weep\"\>", ",", "\<\"afresh\"\>", ",", "\<\"love's\"\>", 
   ",", "\<\"long\"\>", ",", "\<\"since\"\>", ",", "\<\"cancell'd\"\>", 
   ",", "\<\"woe\"\>", ",", "\<\"moan\"\>", ",", "\<\"expense\"\>", 
   ",", "\<\"vanish'd\"\>", ",", "\<\"sight\"\>", ",", "\<\"grieve\"\>", 
   ",", "\<\"at\"\>", ",", "\<\"grievances\"\>", ",", "\<\"foregone\"\>", 
