Cell[TextData[{
 "We apply ",
 StyleBox[ButtonBox["DeleteDuplicates",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/DeleteDuplicates"], "FunctionLink"],
 " to remove repeated words."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"exampleTestWords", "=", 
  RowBox[{"DeleteDuplicates", "[", "exampleTestWords", "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"When\"\>", ",", "\<\"to\"\>", ",", "\<\"the\"\>", 
   ",", "\<\"sessions\"\>", ",", "\<\"of\"\>", ",", "\<\"sweet\"\>", 
   ",", "\<\"silent\"\>", ",", "\<\"thought\"\>", ",", "\<\"I\"\>", 
