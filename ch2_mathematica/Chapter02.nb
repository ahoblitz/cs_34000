(* Beginning of Notebook Content *)
Notebook[{
Cell["\<\
Basic Structures: Sets, Functions, Sequences, Sums, and Matrices\
\>", "BookChapterTitle",
 CounterAssignments->{{"ChapterNumber", 2}}],

Cell[CellGroupData[{

Cell["Introduction", "Section"],

Cell[TextData[{
 "Chapter 2 of the textbook covers mathematical objects fundamental to the \
study of discrete mathematics. We will see how ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " represents these objects."
}], "Text"],

Cell[TextData[{
 "In Sections 1 and 2 we will see that ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "\[CloseCurlyQuote]s implementation of a list can be used to model the \
mathematical concept of set. We will also see how to extend ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "\[CloseCurlyQuote]s capabilities to include fuzzy sets. In Section 3 we \
will consider different ways in which the concept of function can be \
represented in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " and how these approaches can be used in different circumstances. Section 4 \
will look at how to use lists in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " to model finite sequences, how to represent recurrence relations, and how ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " can be used to compute both finite and symbolic summations. In Section 5, \
we will use ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " to list positive rational numbers in a way that demonstrates the fact that \
the rationals are enumerable. And in Section 6, we will see how ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " can be used to study matrices."
}], "Text"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.1 Sets", "Section",
 CellTags->"Section1"],

Cell[TextData[{
 "Sets are fundamental to the description of almost all of the discrete \
objects that we will study. ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " provides support for both their representation and manipulation."
}], "Text"],

Cell[CellGroupData[{

Cell["Set Basics", "Subsection",
 CellTags->"Section1a"],

Cell[TextData[{
 "In ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ", sets are modeled as lists. Note that the syntax for a ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " list matches the standard syntax for a mathematical set: a list of the \
elements of the set separated by commas and enclosed in braces. The elements \
can be any object known to ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ". Typical examples are shown below."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3"}], "}"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3"}], "}"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\"\<a\>\"", ",", "\"\<b\>\"", ",", "\"\<c\>\""}], "}"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"a\"\>", ",", "\<\"b\"\>", ",", "\<\"c\"\>"}], "}"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}]}], "}"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}]}], "}"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", "}"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", "}"}]], "Output"]
}, Open  ]],

Cell["\<\
In the first two examples above, the lists contain the numbers 1, 2, and 3, \
and the characters a, b, and c, respectively (note that the quotation marks \
distinguish them as strings and not symbols). In the third example, the \
elements of the list are themselves lists. The fourth example is the empty \
list. \
\>", "Text"],

Cell[TextData[{
 "Note, however, that ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " does not treat these list objects as sets, that is, it does not \
automatically respect the mathematical properties of sets. In particular, \
repetition and order make lists distinct, unlike mathematical sets. For \
example, consider the lists defined below."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"set1", "=", 
  RowBox[{"{", 
   RowBox[{"1", ",", "2", ",", "3", ",", "1", ",", "2"}], "}"}]}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3", ",", "1", ",", "2"}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "Observe that when ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " echoes the list, it preserves the duplicate entries."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"set2", "=", 
  RowBox[{"{", 
   RowBox[{"2", ",", "3", ",", "1"}], "}"}]}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "3", ",", "1"}], "}"}]], "Output"]
}, Open  ]],

Cell["\<\
Also note that the order in which elements are entered is preserved.\
\>", "Text"],

Cell[TextData[{
 "To test whether two lists are the same, use the ",
 StyleBox[ButtonBox["Equal",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Equal"], "FunctionLink"],
 " (",
 StyleBox["==", "Input"],
 ") relation. Below, you see that ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " considers the lists ",
 StyleBox["set1", "Input"],
 " and ",
 StyleBox["set2", "Input"],
 " different from each other and different from ",
 StyleBox["{1,2,3}", "Input"],
 ", despite the fact that, as sets, they are all identical."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"set1", "==", "set2"}]], "Input"],

Cell[BoxData["False"], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"set1", "==", 
  RowBox[{"{", 
   RowBox[{"1", ",", "2", ",", "3"}], "}"}]}]], "Input"],

Cell[BoxData["False"], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"set2", "==", 
  RowBox[{"{", 
   RowBox[{"1", ",", "2", ",", "3"}], "}"}]}]], "Input"],

Cell[BoxData["False"], "Output"]
}, Open  ]],

Cell[TextData[{
 "In order to get ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " to recognize that ",
 StyleBox["set1", "Input"],
 " and ",
 StyleBox["set2", "Input"],
 " are equal as sets, you must force ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " to represent them in a canonical fashion. This is achieved with the ",
 StyleBox[ButtonBox["Union",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Union"], "FunctionLink"],
 " function. We will see below how to use ",
 StyleBox[ButtonBox["Union",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Union"], "FunctionLink"],
 " to find the union of two or more sets. But when applied to a single list, ",
 StyleBox[ButtonBox["Union",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Union"], "FunctionLink"],
 " returns the list obtained by sorting the elements and removing \
duplicates."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Union", "[", 
  RowBox[{"{", 
   RowBox[{"4", ",", "2", ",", "1", ",", "1", ",", "3", ",", "2", ",", "4"}], 
   "}"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "Because ",
 StyleBox[ButtonBox["Union",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Union"], "FunctionLink"],
 " puts the elements of a list in a canonical order, the results of applying ",
 StyleBox[ButtonBox["Union",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Union"], "FunctionLink"],
 " to two different lists that represent the same mathematical set will be \
the same."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Union", "[", "set1", "]"}], "==", 
  RowBox[{"Union", "[", "set2", "]"}]}]], "Input"],

Cell[BoxData["True"], "Output"]
}, Open  ]],

Cell[TextData[{
 "It is a good idea, when doing work involving sets, to apply the ",
 StyleBox[ButtonBox["Union",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Union"], "FunctionLink"],
 " function as part of the definition of the set.",
 " "
}], "Text"],

Cell[CellGroupData[{

Cell["Parts of Sets", "Subsubsection"],

Cell[TextData[{
 "Because ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " uses lists to represent sets, you can use the ",
 StyleBox[ButtonBox["Part",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Part"], "FunctionLink"],
 " operator to access individual elements and to select subsets based on \
their index.",
 " ",
 "To obtain, for example, the fourth element, enclose 4 in double brackets."
}], "Text",
 PageBreakAbove->False,
 PageBreakWithin->False],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"set3", "=", 
  RowBox[{"Union", "[", 
   RowBox[{"{", 
    RowBox[{
    "\"\<a\>\"", ",", "\"\<b\>\"", ",", "\"\<c\>\"", ",", "\"\<d\>\"", ",", 
     "\"\<e\>\"", ",", "\"\<f\>\""}], "}"}], "]"}]}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"a\"\>", ",", "\<\"b\"\>", ",", "\<\"c\"\>", ",", "\<\"d\"\>", 
   ",", "\<\"e\"\>", ",", "\<\"f\"\>"}], "}"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"set3", "[", 
  RowBox[{"[", "4", "]"}], "]"}]], "Input"],

Cell[BoxData["\<\"d\"\>"], "Output"]
}, Open  ]],

Cell["\<\
Negative values count from the right, so the second to last element (in the \
canonical order), is accessed as follows.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"set3", "[", 
  RowBox[{"[", 
   RowBox[{"-", "2"}], "]"}], "]"}]], "Input"],

Cell[BoxData["\<\"e\"\>"], "Output"]
}, Open  ]],

Cell["\<\
By putting a list of indices within the double brackets, you can obtain any \
subset you wish. Note that the list must be contained in braces within the \
double brackets.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"set3", "[", 
  RowBox[{"[", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3", ",", "4"}], "}"}], "]"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"a\"\>", ",", "\<\"c\"\>", ",", "\<\"d\"\>"}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "Finally, you can obtain a range of elements using the ",
 StyleBox[ButtonBox["Span",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Span"], "FunctionLink"],
 " (",
 StyleBox[";;", "Input"],
 ") operator. For example, to obtain the second through fifth elements, enter \
the following."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"set3", "[", 
  RowBox[{"[", 
   RowBox[{"2", ";;", "5"}], "]"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"b\"\>", ",", "\<\"c\"\>", ",", "\<\"d\"\>", ",", "\<\"e\"\>"}],
   "}"}]], "Output"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Generating Sets", "Subsubsection"],

Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " contains many functions that can be used to generate sets (lists). Two of \
these are ",
 StyleBox[ButtonBox["Range",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Range"], "FunctionLink"],
 " and ",
 StyleBox[ButtonBox["Table",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Table"], "FunctionLink"],
 ". ",
 StyleBox[ButtonBox["Range",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Range"], "FunctionLink"],
 " is the simpler function and we will describe it first."
}], "Text"],

Cell[TextData[{
 "The ",
 StyleBox[ButtonBox["Range",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Range"], "FunctionLink"],
 " function is used to generate lists consisting of simple sequences of \
numbers. It has three basic forms. The first form of ",
 StyleBox[ButtonBox["Range",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Range"], "FunctionLink"],
 " is with one argument. ",
 "In this case, it produces the list of integers from 1 through the given \
value."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Range", "[", "8", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "1", ",", "2", ",", "3", ",", "4", ",", "5", ",", "6", ",", "7", ",", "8"}],
   "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "The second form of ",
 StyleBox[ButtonBox["Range",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Range"], "FunctionLink"],
 " is with two arguments.",
 " ",
 "In this case, it produces the list of values with the first argument as the \
starting value and the second argument as the maximum."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Range", "[", 
  RowBox[{
   RowBox[{"-", "3"}], ",", "5"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "3"}], ",", 
   RowBox[{"-", "2"}], ",", 
   RowBox[{"-", "1"}], ",", "0", ",", "1", ",", "2", ",", "3", ",", "4", ",", 
   "5"}], "}"}]], "Output"]
}, Open  ]],

Cell["\<\
The third form takes three arguments. Again, the first argument is the \
starting value and the second is the maximum. The third argument specifies \
the \[OpenCurlyDoubleQuote]step\[CloseCurlyDoubleQuote], that is, the \
difference between successive values in the list. For example, the following \
produces every third integer beginning with 2 up to 25.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Range", "[", 
  RowBox[{"2", ",", "25", ",", "3"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "2", ",", "5", ",", "8", ",", "11", ",", "14", ",", "17", ",", "20", ",", 
   "23"}], "}"}]], "Output"]
}, Open  ]],

Cell["\<\
Note that the maximum does not need to be a member of the list. Also note \
that the values given do not need to be integers. The command below produces \
the numbers beginning at 0.25 and increasing by 0.41 up until at most 7.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Range", "[", 
  RowBox[{"0.25", ",", "7", ",", "0.41"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "0.25`", ",", "0.6599999999999999`", ",", "1.0699999999999998`", ",", 
   "1.48`", ",", "1.89`", ",", "2.3`", ",", "2.71`", ",", 
   "3.1199999999999997`", ",", "3.53`", ",", "3.94`", ",", "4.35`", ",", 
   "4.76`", ",", "5.17`", ",", "5.58`", ",", "5.989999999999999`", ",", 
   "6.3999999999999995`", ",", "6.81`"}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "The second function, ",
 StyleBox[ButtonBox["Table",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Table"], "FunctionLink"],
 ", gives you even more control over forming lists. Generally, ",
 StyleBox[ButtonBox["Table",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Table"], "FunctionLink"],
 " requires two arguments. The first argument is an expression, often \
involving a symbol called the table index or table variable, that specifies \
the elements of the list being created. The second argument is a list \
defining the values that are to be substituted for the table variable in \
order to produce the list. There are five distinct forms for this second \
argument."
}], "Text"],

Cell[TextData[{
 "The simplest form of ",
 StyleBox[ButtonBox["Table",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Table"], "FunctionLink"],
 " is where no variable is used in the first argument and the second argument \
is a number enclosed in braces. This results in a list consisting of that \
many copies of the first argument.",
 " ",
 "For example, to produce a list of seven fives, enter the following."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{"5", ",", 
   RowBox[{"{", "7", "}"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"5", ",", "5", ",", "5", ",", "5", ",", "5", ",", "5", ",", "5"}], 
  "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "The other forms all use a table index. For these examples, we will use the \
variable ",
 StyleBox["i", "Input"],
 ", and the expression that we give as the first argument will be ",
 Cell[BoxData[
  RowBox[{"i", "^", "2"}]], "myCode"],
 ". This will produce lists whose elements are the squares of the values \
substituted for ",
 StyleBox["i", "Input"],
 ". The second argument to ",
 StyleBox[ButtonBox["Table",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Table"], "FunctionLink"],
 ", when using a variable, is always a list whose first element is the name \
of the variable, as in ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["var", "CodeVar"], ",", "..."}], "}"}]], "myCode"],
 "."
}], "Text"],

Cell[TextData[{
 "If you evaluate ",
 StyleBox[ButtonBox["Table",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Table"], "FunctionLink"],
 " with the second argument comprised of the variable and a positive integer, \
the result will be to substitute the integers 1 though the given integer for \
the variable. The following produces the squares of the integers 1 through 9. "
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"i", "^", "2"}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "9"}], "}"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "1", ",", "4", ",", "9", ",", "16", ",", "25", ",", "36", ",", "49", ",", 
   "64", ",", "81"}], "}"}]], "Output"]
}, Open  ]],

Cell["\<\
In the next form, the second argument is the list consisting of the name of \
the variable and two numbers, a minimum and a maximum. The following produces \
the list of squares of integers from 5 to 12.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"i", "^", "2"}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "5", ",", "12"}], "}"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "25", ",", "36", ",", "49", ",", "64", ",", "81", ",", "100", ",", "121", 
   ",", "144"}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "You can also include a \[OpenCurlyDoubleQuote]step\[CloseCurlyDoubleQuote] \
by adding yet another number to the second argument. The following shows the \
squares of every other integer beginning at ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["4", "2"], TraditionalForm]]],
 " and ending at ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["20", "2"], TraditionalForm]]],
 "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"i", "^", "2"}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "4", ",", "20", ",", "2"}], "}"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "16", ",", "36", ",", "64", ",", "100", ",", "144", ",", "196", ",", "256", 
   ",", "324", ",", "400"}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "In the final form of the second argument, you are able to specify an \
explicit list of values to substitute for the variable. You do this using the \
syntax ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["var", "CodeVar"], ",", 
    RowBox[{"{", 
     StyleBox["values", "CodeVar"], "}"}]}], "}"}]], "myCode"],
 ". That is, the second argument to ",
 StyleBox[ButtonBox["Table",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Table"], "FunctionLink"],
 " is a list consisting of two elements: first the name of the variable, and \
second the list of values enclosed in braces. The following computes the \
squares of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", ",", "3", ",", "5", ",", "7", ",", "11", ",", " ", 
    RowBox[{"and", " ", "13"}]}], TraditionalForm]]],
 "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"i", "^", "2"}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "3", ",", "5", ",", "7", ",", "11", ",", "13"}], 
      "}"}]}], "}"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"4", ",", "9", ",", "25", ",", "49", ",", "121", ",", "169"}], 
  "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "We summarize the allowed forms of the second argument to ",
 StyleBox[ButtonBox["Table",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Table"], "FunctionLink"],
 " in the table below."
}], "Text"],

Cell[TextData[Cell[BoxData[GridBox[{
   {Cell[BoxData[
     RowBox[{"{", 
      StyleBox["i", "CodeVar"], ",", 
      StyleBox[
       SubscriptBox["i", "max"], "CodeVar"], "}"}]], "myCode"], 
    RowBox[{
     StyleBox["i", "CodeVar"], " ", "ranges", " ", "from", " ", "1", " ", 
     "to", " ", 
     StyleBox[
      SubscriptBox["i", "max"], "CodeVar"]}]},
   {Cell[BoxData[
     RowBox[{"{", 
      StyleBox["i", "CodeVar"], ",", 
      StyleBox[
       SubscriptBox["i", "min"], "CodeVar"], ",", 
      StyleBox[
       SubscriptBox["i", "max"], "CodeVar"], "}"}]], "myCode"], 
    RowBox[{
     StyleBox["i", "CodeVar"], " ", "ranges", " ", "from", " ", 
     StyleBox[
      SubscriptBox["i", "min"], "CodeVar"], " ", "to", " ", 
     StyleBox[
      SubscriptBox["i", "max"], "CodeVar"]}]},
   {Cell[BoxData[
     RowBox[{"{", 
      StyleBox["i", "CodeVar"], ",", 
      StyleBox[
       SubscriptBox["i", "min"], "CodeVar"], ",", 
      StyleBox[
       SubscriptBox["i", "max"], "CodeVar"], ",", 
      StyleBox["step", "CodeVar"], "}"}]], "myCode"], 
    RowBox[{
     StyleBox["i", "CodeVar"], " ", "ranges", " ", "from", " ", 
     StyleBox[
      SubscriptBox["i", "min"], "CodeVar"], " ", "to", " ", 
     StyleBox[
      SubscriptBox["i", "max"], "CodeVar"], " ", "by", " ", 
     StyleBox["step", "CodeVar"]}]},
   {Cell[BoxData[
     RowBox[{"{", 
      StyleBox["i", "CodeVar"], ",", 
      StyleBox["list", "CodeVar"], "}"}]], "myCode"], 
    RowBox[{
     StyleBox["i", "CodeVar"], " ", "ranges", " ", "over", " ", "elements", 
     " ", "of", " ", 
     StyleBox["list", "CodeVar"]}]}
  },
  GridBoxDividers->{
   "Columns" -> {{True}}, "ColumnsIndexed" -> {}, "Rows" -> {{True}}, 
    "RowsIndexed" -> {}}]],
 FontFamily->"Times"]], "Text",
 TextAlignment->Center],

Cell[TextData[{
 StyleBox[ButtonBox["Table",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Table"], "FunctionLink"],
 " can also be used with more than one variable in the expression. To do \
this, you simply provide an additional argument specifying each table \
variable. The ",
 StyleBox[ButtonBox["Table",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Table"], "FunctionLink"],
 " function ensures that all combinations of values are included. For \
example, if ",
 StyleBox["f", "Input"],
 " were a function of two values, the following would evaluate the function \
with the first value ranging from 3 to 9 and the second taking the values 0, \
1, and 5."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tableExample", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"i", ",", "j"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "3", ",", "9"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1", ",", "5"}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 InitializationCell->True],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"3", ",", "0"}], "]"}], ",", 
     RowBox[{"f", "[", 
      RowBox[{"3", ",", "1"}], "]"}], ",", 
     RowBox[{"f", "[", 
      RowBox[{"3", ",", "5"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"4", ",", "0"}], "]"}], ",", 
     RowBox[{"f", "[", 
      RowBox[{"4", ",", "1"}], "]"}], ",", 
     RowBox[{"f", "[", 
      RowBox[{"4", ",", "5"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"5", ",", "0"}], "]"}], ",", 
     RowBox[{"f", "[", 
      RowBox[{"5", ",", "1"}], "]"}], ",", 
     RowBox[{"f", "[", 
      RowBox[{"5", ",", "5"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"6", ",", "0"}], "]"}], ",", 
     RowBox[{"f", "[", 
      RowBox[{"6", ",", "1"}], "]"}], ",", 
     RowBox[{"f", "[", 
      RowBox[{"6", ",", "5"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"7", ",", "0"}], "]"}], ",", 
     RowBox[{"f", "[", 
      RowBox[{"7", ",", "1"}], "]"}], ",", 
     RowBox[{"f", "[", 
      RowBox[{"7", ",", "5"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"8", ",", "0"}], "]"}], ",", 
     RowBox[{"f", "[", 
      RowBox[{"8", ",", "1"}], "]"}], ",", 
     RowBox[{"f", "[", 
      RowBox[{"8", ",", "5"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"9", ",", "0"}], "]"}], ",", 
     RowBox[{"f", "[", 
      RowBox[{"9", ",", "1"}], "]"}], ",", 
     RowBox[{"f", "[", 
      RowBox[{"9", ",", "5"}], "]"}]}], "}"}]}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "Note that this produces a nested list. If your goal is to produce a single \
list of all of the values, so as to work with the result as a set, use ",
 StyleBox[ButtonBox["Flatten",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Flatten"], "FunctionLink"],
 " to eliminate the nested structure and use ",
 StyleBox[ButtonBox["Union",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Union"], "FunctionLink"],
 " to ensure that the result is canonically ordered and that duplicates have \
been removed.",
 " ",
 "Be sure that ",
 StyleBox[ButtonBox["Flatten",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Flatten"], "FunctionLink"],
 " is applied first."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Union", "[", 
  RowBox[{"Flatten", "[", "tableExample", "]"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"3", ",", "0"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"3", ",", "1"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"3", ",", "5"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"4", ",", "0"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"4", ",", "1"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"4", ",", "5"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"5", ",", "0"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"5", ",", "1"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"5", ",", "5"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"6", ",", "0"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"6", ",", "1"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"6", ",", "5"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"7", ",", "0"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"7", ",", "1"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"7", ",", "5"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"8", ",", "0"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"8", ",", "1"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"8", ",", "5"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"9", ",", "0"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"9", ",", "1"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"9", ",", "5"}], "]"}]}], "}"}]], "Output"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Membership, Subset, and Size", "Subsubsection"],

Cell[TextData[{
 "Perhaps the most basic question one can ask about a set is whether or not a \
particular object is or is not a member of a set. In ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ", you do this with the ",
 StyleBox[ButtonBox["MemberQ",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/MemberQ"], "FunctionLink"],
 " function. The first argument to ",
 StyleBox[ButtonBox["MemberQ",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/MemberQ"], "FunctionLink"],
 " is the list and the second is the object being sought."
}], "Text"],

Cell[TextData[{
 "For example, if we use ",
 StyleBox[ButtonBox["Table",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Table"], "FunctionLink"],
 " to define ",
 StyleBox["set4", "Input"],
 ", the set of squares of integers from 0 to 10, we can use ",
 StyleBox[ButtonBox["MemberQ",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/MemberQ"], "FunctionLink"],
 " to see that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"4", "\[Element]", 
    StyleBox["set4", "Input"]}], TraditionalForm]]],
 " but that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"5", "\[NotElement]", 
    StyleBox["set4", "Input"]}], TraditionalForm]]],
 ". As mentioned earlier, when modeling a set as a list, it is a good idea to \
apply ",
 StyleBox[ButtonBox["Union",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Union"], "FunctionLink"],
 " when defining it."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"set4", "=", 
  RowBox[{"Union", "[", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"i", "^", "2"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "10"}], "}"}]}], "]"}], "]"}]}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "0", ",", "1", ",", "4", ",", "9", ",", "16", ",", "25", ",", "36", ",", 
   "49", ",", "64", ",", "81", ",", "100"}], "}"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MemberQ", "[", 
  RowBox[{"set4", ",", "4"}], "]"}]], "Input"],

Cell[BoxData["True"], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MemberQ", "[", 
  RowBox[{"set4", ",", "5"}], "]"}]], "Input"],

Cell[BoxData["False"], "Output"]
}, Open  ]],

Cell[TextData[{
 "The ",
 StyleBox[ButtonBox["Length",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Length"], "FunctionLink"],
 " function returns the number of elements in a list. "
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Length", "[", "set4", "]"}]], "Input"],

Cell[BoxData["11"], "Output"]
}, Open  ]],

Cell[TextData[{
 "Be careful to keep in mind that if it is the cardinality of a set you are \
after, you must use ",
 StyleBox[ButtonBox["Union",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Union"], "FunctionLink"],
 " or risk over-counting."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Length", "[", 
  RowBox[{"{", 
   RowBox[{"1", ",", "2", ",", "3", ",", "2", ",", "3"}], "}"}], 
  "]"}]], "Input"],

Cell[BoxData["5"], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Length", "[", 
  RowBox[{"Union", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3", ",", "2", ",", "3"}], "}"}], "]"}], 
  "]"}]], "Input"],

Cell[BoxData["3"], "Output"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " does not have a built-in function for checking whether one set is a subset \
of another. However, it is not difficult to create one. Given finite sets ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox["B", TraditionalForm]]],
 ", determining whether or not ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", "\[Subset]", "B"}], TraditionalForm]]],
 " amounts to checking, for every element of ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]]],
 ", whether it is also a member of ",
 Cell[BoxData[
  FormBox["B", TraditionalForm]]],
 ". "
}], "Text"],

Cell[TextData[{
 "We can loop over all members of a given list ",
 StyleBox["A", "Input"],
 " by using the ",
 StyleBox[ButtonBox["Do",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Do"], "FunctionLink"],
 " function with the ",
 Cell[BoxData[
  RowBox[{"{", 
   StyleBox["var", "CodeVar"], ",", 
   StyleBox["list", "CodeVar"], "}"}]], "myCode"],
 " construction for the second argument (assuming ",
 StyleBox["A", "Input"],
 " is a list). Note that ",
 StyleBox[ButtonBox["Do",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Do"], "FunctionLink"],
 " and ",
 StyleBox[ButtonBox["Table",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Table"], "FunctionLink"],
 " use the same syntax for their iteration specifications. The main \
difference between ",
 StyleBox[ButtonBox["Do",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Do"], "FunctionLink"],
 " and ",
 StyleBox[ButtonBox["Table",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Table"], "FunctionLink"],
 " is that ",
 StyleBox[ButtonBox["Table",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Table"], "FunctionLink"],
 " builds a list as its output while ",
 StyleBox[ButtonBox["Do",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Do"], "FunctionLink"],
 " simply executes the code in the first argument without producing output \
unless explicitly told to do so. "
}], "Text"],

Cell[TextData[{
 "Within the loop, we use the ",
 StyleBox[ButtonBox["MemberQ",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/MemberQ"], "FunctionLink"],
 " function to test whether the object is in the list ",
 StyleBox["B", "Input"],
 ". We embed the loop within a ",
 StyleBox[ButtonBox["Catch",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Catch"], "FunctionLink"],
 " and use ",
 StyleBox[ButtonBox["Throw",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Throw"], "FunctionLink"],
 " if we find an element of ",
 StyleBox["A", "Input"],
 " missing from ",
 StyleBox["B", "Input"],
 ". This ensures that we return false as soon as possible rather than \
checking every element of ",
 StyleBox["A", "Input"],
 " if it is not necessary. If the loop completes, we ",
 StyleBox[ButtonBox["Throw",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Throw"], "FunctionLink"],
 " ",
 StyleBox[ButtonBox["True",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/True"], "FunctionLink"],
 ". Without that statement, nothing would be thrown and the ",
 StyleBox[ButtonBox["Catch",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Catch"], "FunctionLink"],
 " would output ",
 StyleBox[ButtonBox["Null",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Null"], "FunctionLink"],
 "."
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"subsetQ", "[", 
   RowBox[{"A_", ",", "B_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "i", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Catch", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"MemberQ", "[", 
            RowBox[{"B", ",", "i"}], "]"}]}], ",", 
          RowBox[{"Throw", "[", "False", "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "A"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"Throw", "[", "True", "]"}]}], "\[IndentingNewLine]", "]"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True],

Cell["We demonstrate our function on a few sets.", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"subsetQ", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"4", ",", "9", ",", "100"}], "}"}], ",", "set4"}], "]"}]], "Input"],

Cell[BoxData["True"], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"subsetQ", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", "set4"}], "]"}]], "Input"],

Cell[BoxData["False"], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"subsetQ", "[", 
  RowBox[{
   RowBox[{"Range", "[", 
    RowBox[{"3", ",", "7"}], "]"}], ",", 
   RowBox[{"Range", "[", "10", "]"}]}], "]"}]], "Input"],

Cell[BoxData["True"], "Output"]
}, Open  ]]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Power Set and Cartesian Product", "Subsection",
 CellTags->"Section1b"],

Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " has a built-in function to compute the power set of a finite set. The ",
 StyleBox[ButtonBox["Subsets",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Subsets"], "FunctionLink"],
 " function accepts a list as its argument and returns the list of all \
possible sublists. For example, the power set of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", "c"}], "}"}], TraditionalForm]]],
 " can be computed as below."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Subsets", "[", 
  RowBox[{"{", 
   RowBox[{"\"\<a\>\"", ",", "\"\<b\>\"", ",", "\"\<c\>\""}], "}"}], 
  "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "\<\"a\"\>", "}"}], ",", 
   RowBox[{"{", "\<\"b\"\>", "}"}], ",", 
   RowBox[{"{", "\<\"c\"\>", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"a\"\>", ",", "\<\"b\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"a\"\>", ",", "\<\"c\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"b\"\>", ",", "\<\"c\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"a\"\>", ",", "\<\"b\"\>", ",", "\<\"c\"\>"}], "}"}]}], 
  "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "Keep in mind that ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " does not automatically remove duplicates. ",
 "So, for example, if we apply ",
 StyleBox[ButtonBox["Subsets",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Subsets"], "FunctionLink"],
 " to a list with repeated elements, ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " will compute the power set as if the duplicates were distinct."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Subsets", "[", 
  RowBox[{"{", 
   RowBox[{
   "\"\<a\>\"", ",", "\"\<b\>\"", ",", "\"\<c\>\"", ",", "\"\<c\>\""}], "}"}],
   "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "\<\"a\"\>", "}"}], ",", 
   RowBox[{"{", "\<\"b\"\>", "}"}], ",", 
   RowBox[{"{", "\<\"c\"\>", "}"}], ",", 
   RowBox[{"{", "\<\"c\"\>", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"a\"\>", ",", "\<\"b\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"a\"\>", ",", "\<\"c\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"a\"\>", ",", "\<\"c\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"b\"\>", ",", "\<\"c\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"b\"\>", ",", "\<\"c\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"c\"\>", ",", "\<\"c\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"a\"\>", ",", "\<\"b\"\>", ",", "\<\"c\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"a\"\>", ",", "\<\"b\"\>", ",", "\<\"c\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"a\"\>", ",", "\<\"c\"\>", ",", "\<\"c\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"b\"\>", ",", "\<\"c\"\>", ",", "\<\"c\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"a\"\>", ",", "\<\"b\"\>", ",", "\<\"c\"\>", 
     ",", "\<\"c\"\>"}], "}"}]}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "As always, applying ",
 StyleBox[ButtonBox["Union",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Union"], "FunctionLink"],
 " before using the ",
 StyleBox[ButtonBox["Subsets",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Subsets"], "FunctionLink"],
 " function will help avoid this."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Subsets", "[", 
  RowBox[{"Union", "[", 
   RowBox[{"{", 
    RowBox[{
    "\"\<a\>\"", ",", "\"\<b\>\"", ",", "\"\<c\>\"", ",", "\"\<c\>\""}], 
    "}"}], "]"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "\<\"a\"\>", "}"}], ",", 
   RowBox[{"{", "\<\"b\"\>", "}"}], ",", 
   RowBox[{"{", "\<\"c\"\>", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"a\"\>", ",", "\<\"b\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"a\"\>", ",", "\<\"c\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"b\"\>", ",", "\<\"c\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"a\"\>", ",", "\<\"b\"\>", ",", "\<\"c\"\>"}], "}"}]}], 
  "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "The function ",
 StyleBox[ButtonBox["Tuples",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Tuples"], "FunctionLink"],
 " can be used to compute the Cartesian product of sets.",
 " ",
 "There are two ways to use this function."
}], "Text"],

Cell[TextData[{
 "First, to compute the Cartesian product of two or more sets, say ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c"}], "}"}], "\[Cross]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}]}], TraditionalForm]]],
 ", apply ",
 StyleBox[ButtonBox["Tuples",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Tuples"], "FunctionLink"],
 " with one argument: a list whose elements are the lists to be combined."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Tuples", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\"\<a\>\"", ",", "\"\<b\>\"", ",", "\"\<c\>\""}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}]}], "}"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\<\"a\"\>", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"a\"\>", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"b\"\>", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"b\"\>", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"c\"\>", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"c\"\>", ",", "2"}], "}"}]}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "Note that the result is a list of lists. We interpret the outer list as a \
set, the Cartesian product, and we interpret the inner lists as the ordered \
tuples. You can extend this to more than two sets just by including more \
lists in the argument to ",
 StyleBox[ButtonBox["Tuples",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Tuples"], "FunctionLink"],
 ". "
}], "Text"],

Cell[TextData[{
 "The second syntax is used to compute the Cartesian product of a set with \
itself. For example, if ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", "=", 
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c"}], "}"}]}], TraditionalForm]]],
 ", you can compute ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", "3"], TraditionalForm]]],
 " by giving the list as the first argument and the exponent as the second."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Tuples", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<a\>\"", ",", "\"\<b\>\"", ",", "\"\<c\>\""}], "}"}], ",", 
   "3"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\<\"a\"\>", ",", "\<\"a\"\>", ",", "\<\"a\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"a\"\>", ",", "\<\"a\"\>", ",", "\<\"b\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"a\"\>", ",", "\<\"a\"\>", ",", "\<\"c\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"a\"\>", ",", "\<\"b\"\>", ",", "\<\"a\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"a\"\>", ",", "\<\"b\"\>", ",", "\<\"b\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"a\"\>", ",", "\<\"b\"\>", ",", "\<\"c\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"a\"\>", ",", "\<\"c\"\>", ",", "\<\"a\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"a\"\>", ",", "\<\"c\"\>", ",", "\<\"b\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"a\"\>", ",", "\<\"c\"\>", ",", "\<\"c\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"b\"\>", ",", "\<\"a\"\>", ",", "\<\"a\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"b\"\>", ",", "\<\"a\"\>", ",", "\<\"b\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"b\"\>", ",", "\<\"a\"\>", ",", "\<\"c\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"b\"\>", ",", "\<\"b\"\>", ",", "\<\"a\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"b\"\>", ",", "\<\"b\"\>", ",", "\<\"b\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"b\"\>", ",", "\<\"b\"\>", ",", "\<\"c\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"b\"\>", ",", "\<\"c\"\>", ",", "\<\"a\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"b\"\>", ",", "\<\"c\"\>", ",", "\<\"b\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"b\"\>", ",", "\<\"c\"\>", ",", "\<\"c\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"c\"\>", ",", "\<\"a\"\>", ",", "\<\"a\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"c\"\>", ",", "\<\"a\"\>", ",", "\<\"b\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"c\"\>", ",", "\<\"a\"\>", ",", "\<\"c\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"c\"\>", ",", "\<\"b\"\>", ",", "\<\"a\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"c\"\>", ",", "\<\"b\"\>", ",", "\<\"b\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"c\"\>", ",", "\<\"b\"\>", ",", "\<\"c\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"c\"\>", ",", "\<\"c\"\>", ",", "\<\"a\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"c\"\>", ",", "\<\"c\"\>", ",", "\<\"b\"\>"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"c\"\>", ",", "\<\"c\"\>", ",", "\<\"c\"\>"}], "}"}]}], 
  "}"}]], "Output"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Example Using the Power Set", "Subsection",
 CellTags->"Section1c"],

Cell[TextData[{
 "As an example of a practical use of ",
 StyleBox[ButtonBox["Subsets",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Subsets"], "FunctionLink"],
 ", ",
 "let\[CloseCurlyQuote]s search for the subsets of the first five positive \
integers which have their own cardinality as a member, i.e., those sets ",
 Cell[BoxData[
  FormBox["S", TraditionalForm]]],
 " such that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", "S", "|", 
    RowBox[{"\[Element]", "S"}]}], TraditionalForm]]],
 ". ",
 "We\[CloseCurlyQuote]ll do this by considering each subset in turn and \
checking whether its size, obtained using the ",
 StyleBox[ButtonBox["Length",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Length"], "FunctionLink"],
 " function, is a member of the subset, using ",
 StyleBox[ButtonBox["MemberQ",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/MemberQ"], "FunctionLink"],
 "."
}], "Text"],

Cell["\<\
Here\[CloseCurlyQuote]s the function that will list all subsets of the first \
five positive integers whose cardinalities are members of themselves.\
\>", "Text"],

Cell[BoxData[
 RowBox[{"selfSize", ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"mainSet", ",", "powerSet", ",", "S"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"mainSet", "=", 
      RowBox[{"Range", "[", "5", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"powerSet", "=", 
      RowBox[{"Subsets", "[", "mainSet", "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{"S", ",", 
           RowBox[{"Length", "[", "S", "]"}]}], "]"}], ",", 
         RowBox[{"Print", "[", "S", "]"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"S", ",", "powerSet"}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True],

Cell[TextData[{
 "After declaring local variables, we form the set of the integers from 1 to \
5 using ",
 StyleBox[ButtonBox["Range",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Range"], "FunctionLink"],
 ". Then we apply the ",
 StyleBox[ButtonBox["Subsets",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Subsets"], "FunctionLink"],
 " function to form the power set, ",
 StyleBox["powerSet", "Input"],
 ". Using a ",
 StyleBox[ButtonBox["Do",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Do"], "FunctionLink"],
 " loop, we iterate over every member ",
 StyleBox["S", "Input"],
 " of ",
 StyleBox["powerSet", "Input"],
 ". Inside the loop, we print those sets that have their own size as a member."
}], "Text"],

Cell["Now let\[CloseCurlyQuote]s execute it.", "Text"],

Cell[CellGroupData[{

Cell[BoxData["selfSize"], "Input"],

Cell[BoxData[
 RowBox[{"{", "1", "}"}]], "Print"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2"}], "}"}]], "Print"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "3"}], "}"}]], "Print"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "4"}], "}"}]], "Print"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "5"}], "}"}]], "Print"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3"}], "}"}]], "Print"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "3", ",", "4"}], "}"}]], "Print"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "3", ",", "5"}], "}"}]], "Print"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "3", ",", "4"}], "}"}]], "Print"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "3", ",", "5"}], "}"}]], "Print"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "4", ",", "5"}], "}"}]], "Print"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}]], "Print"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "4", ",", "5"}], "}"}]], "Print"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "3", ",", "4", ",", "5"}], "}"}]], "Print"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "3", ",", "4", ",", "5"}], "}"}]], "Print"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "5"}], "}"}]], "Print"]
}, Open  ]],

Cell["\<\
If you wish, you can easily modify the function definition to take the main \
set as an argument.\
\>", "Text"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["2.2 Set Operations", "Section",
 CellTags->"Section2"],

Cell[TextData[{
 "In this section we will examine the functions ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " provides for computing set operations. Then we will use these commands and \
the concept of membership tables to see how ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " can be used to prove set identities. Finally, we see how we can use ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " to represent and manipulate fuzzy sets."
}], "Text"],

Cell[CellGroupData[{

Cell["Basic Operations", "Subsection",
 CellTags->"Section2a"],

Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " provides fairly intuitive functions related to the basic set operations of \
union, intersection, and complement. The functions are named ",
 StyleBox[ButtonBox["Union",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Union"], "FunctionLink"],
 ", ",
 StyleBox[ButtonBox["Intersection",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Intersection"], "FunctionLink"],
 ", and ",
 StyleBox[ButtonBox["Complement",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Complement"], "FunctionLink"],
 ". Consider the following sets."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"primes", "=", 
  RowBox[{"{", 
   RowBox[{"2", ",", "3", ",", "5", ",", "7", ",", "11", ",", "13"}], 
   "}"}]}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "3", ",", "5", ",", "7", ",", "11", ",", "13"}], 
  "}"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"odds", "=", 
  RowBox[{"Range", "[", 
   RowBox[{"1", ",", "13", ",", "2"}], "]"}]}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "3", ",", "5", ",", "7", ",", "9", ",", "11", ",", "13"}],
   "}"}]], "Output"]
}, Open  ]],

Cell["We compute their union and intersection as follows:", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Union", "[", 
  RowBox[{"primes", ",", "odds"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "1", ",", "2", ",", "3", ",", "5", ",", "7", ",", "9", ",", "11", ",", 
   "13"}], "}"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Intersection", "[", 
  RowBox[{"primes", ",", "odds"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "5", ",", "7", ",", "11", ",", "13"}], "}"}]], "Output"]
}, Open  ]],

Cell["\<\
Neither of these functions is restricted to two arguments, but will find the \
union or common intersection of any number of sets. Also, both functions have \
infix forms obtained using the aliases \[EscapeKey]un\[EscapeKey] and \
\[EscapeKey]inter\[EscapeKey]. \
\>", "Text"],

Cell[TextData[{
 "The ",
 StyleBox[ButtonBox["Complement",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Complement"], "FunctionLink"],
 " function is slightly different. Its first argument is the universal set \
and its second argument is the set whose complement is desired.",
 " ",
 "For example, to find the complement of ",
 StyleBox["odds", "Input"],
 " in the universe consisting of integers 1 to 13, you enter the following."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Complement", "[", 
  RowBox[{
   RowBox[{"Range", "[", "13", "]"}], ",", "odds"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "4", ",", "6", ",", "8", ",", "10", ",", "12"}], 
  "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "Recall from the textbook that the complement of a set can be defined in \
terms of set difference. The ",
 StyleBox[ButtonBox["Complement",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Complement"], "FunctionLink"],
 " function can be thought of as implementing the set difference of the first \
argument minus the second. The following examples compute the differences of \
the ",
 StyleBox["primes", "Input"],
 " and ",
 StyleBox["odds", "Input"],
 " sets and illustrate that, unlike union and intersection, set difference is \
not symmetric, i.e., ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", "-", "B"}], TraditionalForm]]],
 " is generally not the same as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"B", "-", "A"}], TraditionalForm]]],
 "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Complement", "[", 
  RowBox[{"primes", ",", "odds"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", "2", "}"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Complement", "[", 
  RowBox[{"odds", ",", "primes"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "9"}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "The ",
 StyleBox[ButtonBox["Complement",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Complement"], "FunctionLink"],
 " function can accept more than two arguments. In this case, it returns the \
list of all elements of the first set that appear in none of the others. That \
is to say, it finds the complement of the union of all of the sets following \
the first relative to the first: ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"Complement", "["}], 
   StyleBox["U", "CodeVar"], ",", 
   StyleBox["A", "CodeVar"], ",", 
   StyleBox["B", "CodeVar"], ",", "...", "]"}]], "myCode"],
 " computes ",
 Cell[BoxData[
  FormBox[
   RowBox[{"U", "-", 
    RowBox[{"(", 
     RowBox[{"A", "\[Union]", "B", "\[Union]", "\[Ellipsis]"}], ")"}]}], 
   TraditionalForm]]],
 "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Complement", "[", 
  RowBox[{
   RowBox[{"Range", "[", "13", "]"}], ",", "odds", ",", "primes"}], 
  "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"4", ",", "6", ",", "8", ",", "10", ",", "12"}], "}"}]], "Output"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Set Identities and Membership Tables", "Subsection",
 CellTags->"Section2b"],

Cell[TextData[{
 "The textbook discusses how membership tables can be used to prove set \
identities. In this subsection, we use the idea of membership tables to have ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " verify set identities."
}], "Text"],

Cell["\<\
A membership table is very similar to a truth table. In a membership table, \
each row corresponds to a possible element in the universe. We use 1 and 0 to \
indicate that the element corresponding to that row is or is not in the set.\
\>", "Text"],

Cell[CellGroupData[{

Cell["An Illustration of the General Approach", "Subsubsection"],

Cell[TextData[{
 "We first consider a specific example in detail in order to get an idea of \
how we can use ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " to automate the construction of membership tables. Consider the De Morgan\
\[CloseCurlyQuote]s law ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     RowBox[{"A", "\[Union]", "B"}], "_"], "=", 
    RowBox[{
     OverscriptBox["A", "_"], "\[Intersection]", 
     OverscriptBox["B", "_"]}]}], TraditionalForm]]],
 ". We begin the table by considering all possible combinations of 1s and 0s \
for A and B and add columns for the two sides of the identity. "
}], "Text"],

Cell[TextData[Cell[BoxData[GridBox[{
   {
    RowBox[{"row", " ", "number"}], 
    StyleBox[Cell[TextData[Cell[BoxData[
      FormBox["A", TraditionalForm]]]]], "Text"], 
    StyleBox[Cell["B"], "Text"], Cell[TextData[Cell[BoxData[
     FormBox[
      OverscriptBox[
       RowBox[{"A", "\[Union]", "B"}], "_"], TraditionalForm]]]]], Cell[
    TextData[Cell[BoxData[
     FormBox[
      RowBox[{
       OverscriptBox["A", "_"], "\[Intersection]", 
       OverscriptBox["B", "_"]}], TraditionalForm]]]]]},
   {"1", 
    StyleBox["1", "Text"], 
    StyleBox["1", "Text"], " ", 
    StyleBox[" ", "Text"]},
   {
    StyleBox["2", "Text"], 
    StyleBox["1", "Text"], 
    StyleBox["0", "Text"], 
    StyleBox[" ", "Text"], 
    StyleBox[" ", "Text"]},
   {
    StyleBox["3", "Text"], 
    StyleBox["0", "Text"], 
    StyleBox["1", "Text"], 
    StyleBox[" ", "Text"], 
    StyleBox[" ", "Text"]},
   {
    StyleBox["4", "Text"], 
    StyleBox["0", "Text"], 
    StyleBox["0", "Text"], 
    StyleBox[" ", "Text"], 
    StyleBox[" ", "Text"]}
  },
  GridBoxDividers->{
   "Columns" -> {{True}}, "ColumnsIndexed" -> {}, "Rows" -> {{True}}, 
    "RowsIndexed" -> {}}]],
 FontFamily->"Times"]], "Text",
 TextAlignment->Center],

Cell[TextData[{
 "We determine the values for the last two columns as follows. Let the \
universe be the set consisting of the row numbers ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}], TraditionalForm]]],
 ". Now form sets ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox["B", TraditionalForm]]],
 " as follows: a number in the universe of row numbers is in ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]]],
 " if there is a 1 in ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]]],
 "\[CloseCurlyQuote]s column in that row. Thus ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", "=", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}]}], TraditionalForm]]],
 " because rows 1 and 2 have 1s in ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]]],
 "\[CloseCurlyQuote]s column. Likewise, we form ",
 Cell[BoxData[
  FormBox[
   RowBox[{"B", "=", 
    RowBox[{"{", 
     RowBox[{"1", ",", "3"}], "}"}]}], TraditionalForm]]],
 "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"rows", "=", 
  RowBox[{"{", 
   RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}]}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"setA", "=", 
  RowBox[{"{", 
   RowBox[{"1", ",", "2"}], "}"}]}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2"}], "}"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"setB", "=", 
  RowBox[{"{", 
   RowBox[{"1", ",", "3"}], "}"}]}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "3"}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "Next, compute both sides of the identity ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     RowBox[{"A", "\[Union]", "B"}], "_"], "=", 
    RowBox[{
     OverscriptBox["A", "_"], "\[Intersection]", 
     OverscriptBox["B", "_"]}]}], TraditionalForm]]],
 ". "
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Complement", "[", 
  RowBox[{"rows", ",", 
   RowBox[{"Union", "[", 
    RowBox[{"setA", ",", "setB"}], "]"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", "4", "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "This indicates that row 4 is the only row with a 1 in the column for",
 " ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    RowBox[{"A", "\[Union]", "B"}], "_"], TraditionalForm]]],
 "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Intersection", "[", 
  RowBox[{
   RowBox[{"Complement", "[", 
    RowBox[{"rows", ",", "setA"}], "]"}], ",", 
   RowBox[{"Complement", "[", 
    RowBox[{"rows", ",", "setB"}], "]"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", "4", "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "This tells us that row 4 is also the only row with a 1 in the column for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["A", "_"], "\[Intersection]", 
    OverscriptBox["B", "_"]}], TraditionalForm]]],
 ". ",
 "Since the two sets are equal, the two columns must be identical."
}], "Text"],

Cell["\<\
The above indicates the approach that we will be using. First, compute the \
initial entries in the rows of the membership table; each row corresponds to \
a different assignment of 1s and 0s. Second, construct sets whose entries are \
the row numbers corresponding to 1s in the table. And finally, compute both \
sides of the identity. If the resulting sets are equal, then we have \
confirmed the identity.\
\>", "Text"],

Cell[TextData[{
 "Much of what we do here will be very similar to how we created the ",
 StyleBox["myEquivalentQ", "Input"],
 " function in Section 1.3 of this manual. First, we need to be able to \
create expressions representing the two sides of the identity. We\
\[CloseCurlyQuote]ll be using Example 14 of the text as our example: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     RowBox[{"A", "\[Union]", 
      RowBox[{"(", 
       RowBox[{"B", "\[Intersection]", "C"}], ")"}]}], "_"], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       OverscriptBox["C", "_"], "\[Union]", 
       OverscriptBox["B", "_"]}], ")"}], "\[Intersection]", 
     OverscriptBox["A", "_"]}]}], TraditionalForm]]],
 ". We\[CloseCurlyQuote]ll use the symbol ",
 StyleBox["U", "Input"],
 " for the universe and ",
 StyleBox["a", "Input"],
 ", ",
 StyleBox["b", "Input"],
 ", and ",
 StyleBox["c", "Input"],
 " for the names of sets. (We use lowercase set names in order to avoid \
conflict with ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "\[CloseCurlyQuote]s reserved symbol ",
 StyleBox["C", "Input"],
 ".) It is important that these symbols not be assigned to values, so we \
first ",
 StyleBox[ButtonBox["Clear",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Clear"], "FunctionLink"],
 " them."
}], "Text"]
}, Open  ]],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"U", ",", "a", ",", "b", ",", "c"}], "]"}]], "Input",
 InitializationCell->True],

Cell[CellGroupData[{

Cell["Set Expressions and Delayed Evaluation", "Subsubsection"],

Cell[TextData[{
 "Creating an expression involving set operations and variables is not as \
simple as it is for the logical operators.",
 " ",
 "With the logical operators, we can, for example, create the expression ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "\[And]", "b"}], TraditionalForm]]],
 "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"And", "[", 
  RowBox[{"a", ",", "b"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"a", "&&", "b"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "But with the set operations, ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " requires the arguments to not be symbols. So when we try to enter the \
analogous set expression, a warning is produced."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Intersection", "[", 
  RowBox[{"a", ",", "b"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"Intersection", "::", "normal"}], "MessageName"], 
  RowBox[{
  ":", " "}], "\<\"Nonatomic expression expected at position \
\[NoBreak]\\!\\(1\\)\[NoBreak] in \[NoBreak]\\!\\(a \[Intersection] b\\)\
\[NoBreak]. \\!\\(\\*ButtonBox[\\\"\[RightSkeleton]\\\", \
ButtonStyle->\\\"Link\\\", ButtonFrame->None, \
ButtonData:>\\\"paclet:ref/message/General/normal\\\", ButtonNote -> \
\\\"Intersection::normal\\\"]\\)\"\>"}]], "Message", "MSG"],

Cell[BoxData[
 RowBox[{"a", "\[Intersection]", "b"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "The message is telling us that the function we applied is supposed to be a \
list or other compound expression, not a mere symbol (or number or string). \
Beyond the warning message, there is another difficulty in representing \
expressions involving set operations in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ". Observe what happens when we attempt to enter ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"A", "\[Intersection]", "B"}], ")"}], "\[Union]", 
    RowBox[{"(", 
     RowBox[{"A", "\[Intersection]", "C"}], ")"}]}], TraditionalForm]]],
 "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Union", "[", 
  RowBox[{
   RowBox[{"Intersection", "[", 
    RowBox[{"a", ",", "b"}], "]"}], ",", 
   RowBox[{"Intersection", "[", 
    RowBox[{"a", ",", "c"}], "]"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"Intersection", "::", "normal"}], "MessageName"], 
  RowBox[{
  ":", " "}], "\<\"Nonatomic expression expected at position \
\[NoBreak]\\!\\(1\\)\[NoBreak] in \[NoBreak]\\!\\(a \[Intersection] b\\)\
\[NoBreak]. \\!\\(\\*ButtonBox[\\\"\[RightSkeleton]\\\", \
ButtonStyle->\\\"Link\\\", ButtonFrame->None, \
ButtonData:>\\\"paclet:ref/message/General/normal\\\", ButtonNote -> \
\\\"Intersection::normal\\\"]\\)\"\>"}]], "Message", "MSG"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"Intersection", "::", "normal"}], "MessageName"], 
  RowBox[{
  ":", " "}], "\<\"Nonatomic expression expected at position \
\[NoBreak]\\!\\(1\\)\[NoBreak] in \[NoBreak]\\!\\(a \[Intersection] c\\)\
\[NoBreak]. \\!\\(\\*ButtonBox[\\\"\[RightSkeleton]\\\", \
ButtonStyle->\\\"Link\\\", ButtonFrame->None, \
ButtonData:>\\\"paclet:ref/message/General/normal\\\", ButtonNote -> \
\\\"Intersection::normal\\\"]\\)\"\>"}]], "Message", "MSG"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"Intersection", "::", "normal"}], "MessageName"], 
  RowBox[{
  ":", " "}], "\<\"Nonatomic expression expected at position \
\[NoBreak]\\!\\(1\\)\[NoBreak] in \[NoBreak]\\!\\(a \[Intersection] b \
\[Intersection] c\\)\[NoBreak]. \\!\\(\\*ButtonBox[\\\"\[RightSkeleton]\\\", \
ButtonStyle->\\\"Link\\\", ButtonFrame->None, \
ButtonData:>\\\"paclet:ref/message/General/normal\\\", ButtonNote -> \
\\\"Intersection::normal\\\"]\\)\"\>"}]], "Message", "MSG"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"General", "::", "stop"}], "MessageName"], 
  RowBox[{
  ":", " "}], "\<\"Further output of \
\[NoBreak]\\!\\(\\*StyleBox[\\(Intersection :: normal\\), \
\\\"MessageName\\\"]\\)\[NoBreak] will be suppressed during this calculation. \
\\!\\(\\*ButtonBox[\\\"\[RightSkeleton]\\\", ButtonStyle->\\\"Link\\\", \
ButtonFrame->None, ButtonData:>\\\"paclet:ref/message/General/stop\\\", \
ButtonNote -> \\\"General::stop\\\"]\\)\"\>"}]], "Message", "MSG"],

Cell[BoxData[
 RowBox[{"a", "\[Intersection]", "b", "\[Intersection]", "c"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " transformed the expression we entered into the intersection of all three \
sets, which does not represent the same set as the original expression. The \
reason for this behavior is that the ",
 StyleBox[ButtonBox["Union",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Union"], "FunctionLink"],
 " function\[CloseCurlyQuote]s arguments are not required to be lists. \
Provided the arguments have the same head, ",
 StyleBox[ButtonBox["Union",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Union"], "FunctionLink"],
 " returns the expression consisting of that common head and the union of the \
arguments. This is illustrated below using the symbol ",
 StyleBox["f", "Input"],
 " for the head."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Union", "[", 
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"a", ",", "b", ",", "c"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"a", ",", "c", ",", "d"}], "]"}], ",", 
   RowBox[{"f", "[", 
    RowBox[{"b", ",", "d", ",", "e"}], "]"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"f", "[", 
  RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "e"}], "]"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "In order to work properly, our functions in this section will need to \
ensure that the set expressions they are given are not evaluated. We will do \
this with ",
 StyleBox[ButtonBox["Hold",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Hold"], "FunctionLink"],
 "."
}], "Text"],

Cell[TextData[{
 "The ",
 StyleBox[ButtonBox["Hold",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Hold"], "FunctionLink"],
 " function accepts a single argument, which can be any expression \
whatsoever. The result is to maintain the expression just as it was given to ",
 StyleBox[ButtonBox["Hold",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Hold"], "FunctionLink"],
 " with no evaluation performed on it."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"holdExample", "=", 
  RowBox[{"Hold", "[", 
   RowBox[{"Union", "[", 
    RowBox[{
     RowBox[{"Intersection", "[", 
      RowBox[{"a", ",", "b"}], "]"}], ",", 
     RowBox[{"Intersection", "[", 
      RowBox[{"a", ",", "c"}], "]"}]}], "]"}], "]"}]}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{"Hold", "[", 
  RowBox[{
   RowBox[{"a", "\[Intersection]", "b"}], "\[Union]", 
   RowBox[{"a", "\[Intersection]", "c"}]}], "]"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "In the above, the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " front end has displayed the set expression using the infix symbols rather \
than the function names (",
 StyleBox[ButtonBox["FullForm",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/FullForm"], "FunctionLink"],
 " will show that the function names are still in the internal \
representation). However, the expression was retained as we intended it, in \
contrast to what happened to the same expression above."
}], "Text"],

Cell[TextData[{
 "Note also that the result has ",
 StyleBox[ButtonBox["Hold",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Hold"], "FunctionLink"],
 " as its head. This means that the expression will remain held until we \
explicitly cause it to be evaluated using ",
 StyleBox[ButtonBox["ReleaseHold",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/ReleaseHold"], "FunctionLink"],
 "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ReleaseHold", "[", "holdExample", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"Intersection", "::", "normal"}], "MessageName"], 
  RowBox[{
  ":", " "}], "\<\"Nonatomic expression expected at position \
\[NoBreak]\\!\\(1\\)\[NoBreak] in \[NoBreak]\\!\\(a \[Intersection] b\\)\
\[NoBreak]. \\!\\(\\*ButtonBox[\\\"\[RightSkeleton]\\\", \
ButtonStyle->\\\"Link\\\", ButtonFrame->None, \
ButtonData:>\\\"paclet:ref/message/General/normal\\\", ButtonNote -> \
\\\"Intersection::normal\\\"]\\)\"\>"}]], "Message", "MSG"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"Intersection", "::", "normal"}], "MessageName"], 
  RowBox[{
  ":", " "}], "\<\"Nonatomic expression expected at position \
\[NoBreak]\\!\\(1\\)\[NoBreak] in \[NoBreak]\\!\\(a \[Intersection] c\\)\
\[NoBreak]. \\!\\(\\*ButtonBox[\\\"\[RightSkeleton]\\\", \
ButtonStyle->\\\"Link\\\", ButtonFrame->None, \
ButtonData:>\\\"paclet:ref/message/General/normal\\\", ButtonNote -> \
\\\"Intersection::normal\\\"]\\)\"\>"}]], "Message", "MSG"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"Intersection", "::", "normal"}], "MessageName"], 
  RowBox[{
  ":", " "}], "\<\"Nonatomic expression expected at position \
\[NoBreak]\\!\\(1\\)\[NoBreak] in \[NoBreak]\\!\\(a \[Intersection] b \
\[Intersection] c\\)\[NoBreak]. \\!\\(\\*ButtonBox[\\\"\[RightSkeleton]\\\", \
ButtonStyle->\\\"Link\\\", ButtonFrame->None, \
ButtonData:>\\\"paclet:ref/message/General/normal\\\", ButtonNote -> \
\\\"Intersection::normal\\\"]\\)\"\>"}]], "Message", "MSG"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"General", "::", "stop"}], "MessageName"], 
  RowBox[{
  ":", " "}], "\<\"Further output of \
\[NoBreak]\\!\\(\\*StyleBox[\\(Intersection :: normal\\), \
\\\"MessageName\\\"]\\)\[NoBreak] will be suppressed during this calculation. \
\\!\\(\\*ButtonBox[\\\"\[RightSkeleton]\\\", ButtonStyle->\\\"Link\\\", \
ButtonFrame->None, ButtonData:>\\\"paclet:ref/message/General/stop\\\", \
ButtonNote -> \\\"General::stop\\\"]\\)\"\>"}]], "Message", "MSG"],

Cell[BoxData[
 RowBox[{"a", "\[Intersection]", "b", "\[Intersection]", "c"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "In what follows, we will initially require that all set expressions are \
manually held, by being entered with the ",
 StyleBox[ButtonBox["Hold",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Hold"], "FunctionLink"],
 " function explicitly applied. At the end of this section, we will see how \
to remove this cumbersome requirement."
}], "Text"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Revising the ",
 StyleBox["getVars", "Input"],
 " Function"
}], "Subsubsection"],

Cell[TextData[{
 "Much of what follows will parallel the construction of the ",
 StyleBox["myEquivalentQ", "Input"],
 " function from Section 1.3 of this manual. ",
 "First, let\[CloseCurlyQuote]s create expressions representing the two sides \
of the identity from Example 14 of the text.",
 " We\[CloseCurlyQuote]ll use the symbol ",
 StyleBox["U", "Input"],
 " for the universe and ",
 StyleBox["a", "Input"],
 ", ",
 StyleBox["b", "Input"],
 ", and ",
 StyleBox["c", "Input"],
 " for the sets."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ex14L", "=", 
  RowBox[{"Hold", "[", 
   RowBox[{"Complement", "[", 
    RowBox[{"U", ",", 
     RowBox[{"Union", "[", 
      RowBox[{"a", ",", 
       RowBox[{"Intersection", "[", 
        RowBox[{"b", ",", "c"}], "]"}]}], "]"}]}], "]"}], "]"}]}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{"Hold", "[", 
  RowBox[{"Complement", "[", 
   RowBox[{"U", ",", 
    RowBox[{"a", "\[Union]", 
     RowBox[{"b", "\[Intersection]", "c"}]}]}], "]"}], "]"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ex14R", "=", 
  RowBox[{"Hold", "[", 
   RowBox[{"Intersection", "[", 
    RowBox[{
     RowBox[{"Union", "[", 
      RowBox[{
       RowBox[{"Complement", "[", 
        RowBox[{"U", ",", "c"}], "]"}], ",", 
       RowBox[{"Complement", "[", 
        RowBox[{"U", ",", "b"}], "]"}]}], "]"}], ",", 
     RowBox[{"Complement", "[", 
      RowBox[{"U", ",", "a"}], "]"}]}], "]"}], "]"}]}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{"Hold", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Complement", "[", 
      RowBox[{"U", ",", "c"}], "]"}], "\[Union]", 
     RowBox[{"Complement", "[", 
      RowBox[{"U", ",", "b"}], "]"}]}], ")"}], "\[Intersection]", 
   RowBox[{"Complement", "[", 
    RowBox[{"U", ",", "a"}], "]"}]}], "]"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "Now we will create a version of the ",
 StyleBox["getVars", "Input"],
 " function from Section 1.3. In Section 1.3 of this manual, we built ",
 StyleBox["getVars", "Input"],
 " using the most fundamental ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " functions possible. Our purpose then was to build the functions from \
scratch as an illustration of essential programming constructions and \
concepts. Here, we will instead take advantage of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "\[CloseCurlyQuote]s sophisticated built-in functions to illustrate their \
use."
}], "Text"],

Cell[TextData[{
 "Most of the work of the function will be done by using the built-in \
function ",
 StyleBox[ButtonBox["Cases",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Cases"], "FunctionLink"],
 ". The purpose of the ",
 StyleBox[ButtonBox["Cases",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Cases"], "FunctionLink"],
 " function is to analyze an expression and produce a list of the elements of \
the expression that satisfy a certain condition. A simple example is finding \
the integers in a list of numbers."
}], "Text"],

Cell[TextData[{
 "The first argument to ",
 StyleBox[ButtonBox["Cases",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Cases"], "FunctionLink"],
 " is the expression being searched, for example the list of numbers. The \
second argument must be a \[OpenCurlyDoubleQuote]pattern\
\[CloseCurlyDoubleQuote] that describes which elements are to be matched. \
Patterns in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " are rather involved. Here we will describe only the aspects needed for the \
current task. "
}], "Text"],

Cell[TextData[{
 "We have already used the most basic ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " pattern, the ",
 StyleBox[ButtonBox["Blank",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Blank"], "FunctionLink"],
 " (",
 StyleBox["_", "Input"],
 "), which matches anything at all. When you define a function in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ", as in ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], ":=", 
   RowBox[{"x", "^", "2"}]}]], "myCode"],
 ", the ",
 StyleBox[ButtonBox["Blank",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Blank"], "FunctionLink"],
 " (",
 StyleBox["_", "Input"],
 ") indicates to ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " that you wish to match any expression as the argument to the function. The \
symbol preceding the blank, in this case, ",
 StyleBox["x", "Input"],
 ", tells ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " that you will be using that symbol to refer to the expression that was \
matched by the blank."
}], "Text"],

Cell["\<\
You can create more specific patterns, that is patterns that are selective \
about the kinds of expressions that they match, by following the blank with \
the name of a head. Consider, for example, the following function definition.\
\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"patternEx", "[", "x_Integer", "]"}], ":=", 
  RowBox[{"x", "^", "2"}]}]], "Input",
 InitializationCell->True],

Cell[TextData[{
 "Here, ",
 StyleBox["x_Integer", "Input"],
 " is a pattern. As before, the symbol preceding the blank tells ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " that you will refer to the matched expression with ",
 StyleBox["x", "Input"],
 ". The fact that the blank is followed by ",
 StyleBox["Integer", "Input"],
 " tells ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " that you only allow a match when the expression has head ",
 StyleBox["Integer", "Input"],
 ". If you give this function an argument that is not an integer, it will not \
match the pattern that specifies the argument and so the function definition \
will not apply."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"patternEx", "[", "5", "]"}]], "Input"],

Cell[BoxData["25"], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"patternEx", "[", "2.9", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"patternEx", "[", "2.9`", "]"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "We can use this pattern with ",
 StyleBox[ButtonBox["Cases",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Cases"], "FunctionLink"],
 " in order to find the elements of a list that are integers. We use the \
function with first argument a list of objects and second argument the \
pattern describing the objects we want found."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Cases", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"5", ",", 
     RowBox[{"-", "3"}], ",", "9", ",", "x", ",", "Pi", ",", "0", ",", 
     "4.7"}], "}"}], ",", "_Integer"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"5", ",", 
   RowBox[{"-", "3"}], ",", "9", ",", "0"}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "Note that we were able to leave off the symbol preceding the blank in the \
pattern ",
 StyleBox["_Integer", "Input"],
 ", since we did not need to refer to the integers being matched. Here is \
another example."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Cases", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", 
     RowBox[{"-", "1"}], ",", 
     RowBox[{"{", 
      RowBox[{"5", ",", "q", ",", "3"}], "}"}], ",", "x", ",", "6"}], "}"}], 
   ",", "_Integer"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", 
   RowBox[{"-", "1"}], ",", "6"}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "In this example, ",
 StyleBox[ButtonBox["Cases",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Cases"], "FunctionLink"],
 " did not return the 5 and the 3 found in the sublist. This is because ",
 StyleBox[ButtonBox["Cases",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Cases"], "FunctionLink"],
 ", by default, only checks the first level of its argument. To be more \
precise, in the example above, the expression that ",
 StyleBox[ButtonBox["Cases",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Cases"], "FunctionLink"],
 " was applied to was a list with 5 elements. The ",
 StyleBox["2", "Input"],
 ", ",
 StyleBox["-1", "Input"],
 ", and ",
 StyleBox["6", "Input"],
 " were elements with head ",
 StyleBox["Integer", "Input"],
 " and were matched by the pattern. The ",
 StyleBox["x", "Input"],
 " has head ",
 StyleBox["Symbol", "Input"],
 " and is not matched. The other element was the list ",
 StyleBox["{5,q,3}", "Input"],
 ", which has head ",
 StyleBox["List", "Input"],
 " and so the sublist was not matched by the pattern. Moreover, ",
 StyleBox[ButtonBox["Cases",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Cases"], "FunctionLink"],
 " did not delve into that subexpression."
}], "Text"],

Cell[TextData[{
 "You can have ",
 StyleBox[ButtonBox["Cases",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Cases"], "FunctionLink"],
 " dig deeper, that is, analyze elements of subexpressions, by providing a \
level specification. By providing a positive integer as an optional third \
argument, ",
 StyleBox[ButtonBox["Cases",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Cases"], "FunctionLink"],
 " will include everything from the first level down to the specified level. \
For example, to have ",
 StyleBox[ButtonBox["Cases",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Cases"], "FunctionLink"],
 " include the ",
 StyleBox["5", "Input"],
 " and ",
 StyleBox["3", "Input"],
 " in its result for the example above, you just need to tell it to work down \
to level 2."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Cases", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", 
     RowBox[{"-", "1"}], ",", 
     RowBox[{"{", 
      RowBox[{"5", ",", "q", ",", "3"}], "}"}], ",", "x", ",", "6"}], "}"}], 
   ",", "_Integer", ",", "2"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", 
   RowBox[{"-", "1"}], ",", "5", ",", "3", ",", "6"}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "The symbol ",
 StyleBox["Infinity", "Input"],
 " is used as the level specification to indicate that you want ",
 StyleBox[ButtonBox["Cases",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Cases"], "FunctionLink"],
 " to go as deep as possible."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Cases", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", 
         RowBox[{"{", 
          RowBox[{"4", ",", 
           RowBox[{"{", 
            RowBox[{"5", ",", 
             RowBox[{"{", 
              RowBox[{"6", ",", 
               RowBox[{"{", 
                RowBox[{"7", ",", 
                 RowBox[{"{", 
                  RowBox[{"8", ",", 
                   RowBox[{"{", "9", "}"}]}], "}"}]}], "}"}]}], "}"}]}], 
            "}"}]}], "}"}]}], "}"}]}], "}"}]}], "}"}], ",", "_Integer", ",", 
   "Infinity"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "1", ",", "2", ",", "3", ",", "4", ",", "5", ",", "6", ",", "7", ",", "8", 
   ",", "9"}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "Since the first argument does not have to be a list, but can be any \
expression, we can identify the variables used in an expression by using ",
 StyleBox[ButtonBox["Cases",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Cases"], "FunctionLink"],
 " to search for the symbols in the expression with the pattern ",
 StyleBox["_Symbol", "Input"],
 "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Cases", "[", 
  RowBox[{"ex14R", ",", "_Symbol", ",", "Infinity"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"U", ",", "c", ",", "U", ",", "b", ",", "U", ",", "a"}], 
  "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "We\[CloseCurlyQuote]re almost there, but we want to exclude the universe \
from our list of variables. To do this, we will be assuming, for convenience, \
that the universe is always denoted by U in expressions. The reason for \
excluding the universe is so that the list of variables returned by ",
 StyleBox["getVarsSets", "Input"],
 " corresponds to the columns of the membership table."
}], "Text"],

Cell[TextData[{
 "We\[CloseCurlyQuote]ll exclude ",
 StyleBox["U", "Input"],
 " by making a modification of the pattern specification. ",
 StyleBox[ButtonBox["Except",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Except"], "FunctionLink"],
 " is used in patterns to exclude certain matches. With two arguments, the \
first argument specifies patterns to exclude (in this case ",
 StyleBox["U", "Input"],
 "), and the second argument is the pattern to include."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Cases", "[", 
  RowBox[{"ex14R", ",", 
   RowBox[{"Except", "[", 
    RowBox[{"U", ",", "_Symbol"}], "]"}], ",", "Infinity"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"c", ",", "b", ",", "a"}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "We apply ",
 StyleBox[ButtonBox["Union",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Union"], "FunctionLink"],
 " in order to remove duplicates and put the results in a standard order. \
This is everything we need to create ",
 StyleBox["getVarsSets", "Input"],
 "."
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"getVarsSets", "[", "S_", "]"}], ":=", 
  RowBox[{"Union", "[", 
   RowBox[{"Cases", "[", 
    RowBox[{"S", ",", 
     RowBox[{"Except", "[", 
      RowBox[{"U", ",", "_Symbol"}], "]"}], ",", "Infinity"}], "]"}], 
   "]"}]}]], "Input",
 InitializationCell->True],

Cell[TextData[{
 "In order to be sure to include all variables that appear in either ",
 StyleBox["ex14L", "Input"],
 " or ",
 StyleBox["ex14R", "Input"],
 ", we combine the two into a list and pass that list as the argument to ",
 StyleBox["getVarsSets", "Input"],
 "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ex14Vars", "=", 
  RowBox[{"getVarsSets", "[", 
   RowBox[{"{", 
    RowBox[{"ex14L", ",", "ex14R"}], "}"}], "]"}]}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"a", ",", "b", ",", "c"}], "}"}]], "Output"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Producing the Rows of the Table", "Subsubsection"],

Cell[TextData[{
 "In Section 1.3, we created a procedure called ",
 StyleBox["nextTA", "Input"],
 ". This function was responsible for producing the truth value assignments \
for the variables. In other words, it produced the rows of the truth table. \
Look again at the membership table above. Observe that the rows correspond to \
the members of the Cartesian product"
}], "Text"],

Cell[BoxData[
 FormBox[
  RowBox[{Cell["\<\
{0,1}\[Times]{0,1}={(0,0), (0,1), (1,0), (1,1)}\
\>"], "."}], TraditionalForm]], "Equation"],

Cell[TextData[{
 "In fact, the Cartesian product is exactly suited to what we need. The rows \
of the table are all the possible choices of 0s and 1s for the variables. The \
Cartesian product of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"0", ",", "1"}], "}"}], TraditionalForm]]],
 " with itself is the collection of all possible tuples with each entry in \
the tuple equal to 0 or to 1."
}], "Text"],

Cell[TextData[{
 "The ",
 StyleBox[ButtonBox["Tuples",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Tuples"], "FunctionLink"],
 " function, described earlier, produces the list of all possible tuples \
whose members are given by the first argument and whose size is given by the \
second."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Tuples", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "1"}], "}"}], ",", "3"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], "}"}]], "Output"]
}, Open  ]],

Cell["\<\
You can see that the results are identical to the first three columns of \
Table 2 of Section 2.2 in the textbook.\
\>", "Text"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Building Sets to Correspond to the Table Rows", "Subsubsection"],

Cell[TextData[{
 "We need to build sets whose entries are determined by the rows of the \
membership table (i.e., by the elements of a Cartesian power of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"0", ",", "1"}], "}"}], TraditionalForm]]],
 ", as above). The sets, corresponding to what we called ",
 StyleBox["setA", "Input"],
 " and ",
 StyleBox["setB", "Input"],
 " in the example, will be stored in a list. That is, we\[CloseCurlyQuote]ll \
create a list of sets. These sets are identified with the variables in the \
identity to be checked as follows: the set in position ",
 StyleBox["i", "Input"],
 " in the list of sets corresponds to the variable in position ",
 StyleBox["i", "Input"],
 " in the list that results from ",
 StyleBox["getVarsSets", "Input"],
 "."
}], "Text"],

Cell[TextData[{
 "Begin by initializing a list of the right size (the number of variables) \
whose entries are the empty set.",
 " We use the ",
 StyleBox[ButtonBox["Table",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Table"], "FunctionLink"],
 " function to create multiple copies of the empty set."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"memberTableSets", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", 
    RowBox[{"{", "3", "}"}]}], "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "Note that we can access and modify the lists as usual. For instance, to add \
5 to the second set we use the ",
 StyleBox[ButtonBox["AppendTo",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/AppendTo"], "FunctionLink"],
 " function, which modifies a list given as the first argument by adding the \
second argument to the end of the list."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AppendTo", "[", 
  RowBox[{
   RowBox[{"memberTableSets", "[", 
    RowBox[{"[", "2", "]"}], "]"}], ",", "5"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", "5", "}"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData["memberTableSets"], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "5", "}"}], ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output"]
}, Open  ]],

Cell["\<\
Let\[CloseCurlyQuote]s re-initialize this so we can use it below.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"memberTableSets", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", 
    RowBox[{"{", "3", "}"}]}], "]"}]}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output"]
}, Open  ]],

Cell["We also compute and store the Cartesian product. ", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"cartesianMembership", "=", 
  RowBox[{"Tuples", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", "1"}], "}"}], ",", "3"}], "]"}]}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "Now we use a ",
 StyleBox[ButtonBox["For",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/For"], "FunctionLink"],
 " loop with a loop variable ",
 StyleBox["rownum", "Input"],
 ". This variable corresponds to the row number in the membership table. The ",
 StyleBox["rownum", "Input"],
 " is also used as the index into the Cartesian product. Remember from the \
discussion above that the row number is added to those sets corresponding to \
1s in the appropriate position. Below, we have the loop print out the index, \
the tuple from the Cartesian product, and the current state of ",
 StyleBox["memberTableSets", "Input"],
 " to show the progress of the sets as they are built."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"rownum", "=", "1"}], ",", 
   RowBox[{"rownum", "\[LessEqual]", 
    RowBox[{"Length", "[", "cartesianMembership", "]"}]}], ",", 
   RowBox[{"rownum", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"currentTuple", "=", 
     RowBox[{"cartesianMembership", "[", 
      RowBox[{"[", "rownum", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"i", "=", "1"}], ",", 
      RowBox[{"i", "\[LessEqual]", "3"}], ",", 
      RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"currentTuple", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "\[Equal]", "1"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{
          RowBox[{"memberTableSets", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", "rownum"}], "]"}]}], 
       "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{
     "rownum", ",", "\"\< \>\"", ",", "currentTuple", ",", "\"\< \>\"", ",", 
      "memberTableSets"}], "]"}]}]}], "\[IndentingNewLine]", "]"}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"1", "\[InvisibleSpace]", "\<\" \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}], 
   "\[InvisibleSpace]", "\<\" \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "}"}], ",", 
     RowBox[{"{", "}"}], ",", 
     RowBox[{"{", "}"}]}], "}"}]}],
  SequenceForm[1, " ", {0, 0, 0}, " ", {{}, {}, {}}],
  Editable->False]], "Print"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"2", "\[InvisibleSpace]", "\<\" \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "1"}], "}"}], 
   "\[InvisibleSpace]", "\<\" \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "}"}], ",", 
     RowBox[{"{", "}"}], ",", 
     RowBox[{"{", "2", "}"}]}], "}"}]}],
  SequenceForm[2, " ", {0, 0, 1}, " ", {{}, {}, {2}}],
  Editable->False]], "Print"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"3", "\[InvisibleSpace]", "\<\" \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "0"}], "}"}], 
   "\[InvisibleSpace]", "\<\" \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "}"}], ",", 
     RowBox[{"{", "3", "}"}], ",", 
     RowBox[{"{", "2", "}"}]}], "}"}]}],
  SequenceForm[3, " ", {0, 1, 0}, " ", {{}, {3}, {2}}],
  Editable->False]], "Print"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"4", "\[InvisibleSpace]", "\<\" \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "1"}], "}"}], 
   "\[InvisibleSpace]", "\<\" \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}]}], "}"}]}],
  SequenceForm[4, " ", {0, 1, 1}, " ", {{}, {3, 4}, {2, 4}}],
  Editable->False]], "Print"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"5", "\[InvisibleSpace]", "\<\" \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "0"}], "}"}], 
   "\[InvisibleSpace]", "\<\" \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "5", "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}]}], "}"}]}],
  SequenceForm[5, " ", {1, 0, 0}, " ", {{5}, {3, 4}, {2, 4}}],
  Editable->False]], "Print"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"6", "\[InvisibleSpace]", "\<\" \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "1"}], "}"}], 
   "\[InvisibleSpace]", "\<\" \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"5", ",", "6"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "4", ",", "6"}], "}"}]}], "}"}]}],
  SequenceForm[6, " ", {1, 0, 1}, " ", {{5, 6}, {3, 4}, {2, 4, 6}}],
  Editable->False]], "Print"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"7", "\[InvisibleSpace]", "\<\" \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "0"}], "}"}], 
   "\[InvisibleSpace]", "\<\" \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"5", ",", "6", ",", "7"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "4", ",", "7"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "4", ",", "6"}], "}"}]}], "}"}]}],
  SequenceForm[7, " ", {1, 1, 0}, " ", {{5, 6, 7}, {3, 4, 7}, {2, 4, 6}}],
  Editable->False]], "Print"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"8", "\[InvisibleSpace]", "\<\" \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1"}], "}"}], 
   "\[InvisibleSpace]", "\<\" \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"5", ",", "6", ",", "7", ",", "8"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "4", ",", "7", ",", "8"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "4", ",", "6", ",", "8"}], "}"}]}], "}"}]}],
  SequenceForm[
  8, " ", {1, 1, 1}, " ", {{5, 6, 7, 8}, {3, 4, 7, 8}, {2, 4, 6, 8}}],
  Editable->False]], "Print"]
}, Open  ]],

Cell["\<\
We also need the universe represented. The universe, in this context, is the \
set of row numbers.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ex14U", "=", 
  RowBox[{"Range", "[", "8", "]"}]}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "1", ",", "2", ",", "3", ",", "4", ",", "5", ",", "6", ",", "7", ",", "8"}],
   "}"}]], "Output"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Evaluating the Identity", "Subsubsection"],

Cell[TextData[{
 "Once the list of sets is built up, all that remains is to evaluate the \
identity with these sets in place of the names. We do this with the same \
technique as in Section 1.3 of this manual. We use ",
 StyleBox[ButtonBox["MapThread",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/MapThread"], "FunctionLink"],
 " to turn the list of variables obtained by ",
 StyleBox["getVarsSets", "Input"],
 " and the list of sets stored as ",
 StyleBox["memberTableSets", "Input"],
 " into a list of rules."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"memberRules", "=", 
  RowBox[{"MapThread", "[", 
   RowBox[{"Rule", ",", 
    RowBox[{"{", 
     RowBox[{"ex14Vars", ",", "memberTableSets"}], "}"}]}], "]"}]}]], "Input",\

 InitializationCell->True],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"a", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"5", ",", "6", ",", "7", ",", "8"}], "}"}]}], ",", 
   RowBox[{"b", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"3", ",", "4", ",", "7", ",", "8"}], "}"}]}], ",", 
   RowBox[{"c", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"2", ",", "4", ",", "6", ",", "8"}], "}"}]}]}], "}"}]], "Output"]
}, Open  ]],

Cell["We add to this a rule for the universe.", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AppendTo", "[", 
  RowBox[{"memberRules", ",", 
   RowBox[{"U", "\[Rule]", "ex14U"}]}], "]"}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"a", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"5", ",", "6", ",", "7", ",", "8"}], "}"}]}], ",", 
   RowBox[{"b", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"3", ",", "4", ",", "7", ",", "8"}], "}"}]}], ",", 
   RowBox[{"c", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"2", ",", "4", ",", "6", ",", "8"}], "}"}]}], ",", 
   RowBox[{"U", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "1", ",", "2", ",", "3", ",", "4", ",", "5", ",", "6", ",", "7", ",", 
      "8"}], "}"}]}]}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "The question we\[CloseCurlyQuote]re trying to answer is whether the set \
expressions stored in ",
 StyleBox["ex14L", "Input"],
 " and ",
 StyleBox["ex14R", "Input"],
 " are identical. We use ",
 StyleBox[ButtonBox["ReplaceAll",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/ReplaceAll"], "FunctionLink"],
 " (",
 StyleBox["/.", "Input"],
 ") to substitute the lists in for the variables in the two expressions."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ex14L", "/.", "memberRules"}]], "Input"],

Cell[BoxData[
 RowBox[{"Hold", "[", 
  RowBox[{"Complement", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "1", ",", "2", ",", "3", ",", "4", ",", "5", ",", "6", ",", "7", ",", 
      "8"}], "}"}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"5", ",", "6", ",", "7", ",", "8"}], "}"}], "\[Union]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"3", ",", "4", ",", "7", ",", "8"}], "}"}], "\[Intersection]", 
      
      RowBox[{"{", 
       RowBox[{"2", ",", "4", ",", "6", ",", "8"}], "}"}]}]}]}], "]"}], 
  "]"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ex14R", "/.", "memberRules"}]], "Input"],

Cell[BoxData[
 RowBox[{"Hold", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Complement", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "1", ",", "2", ",", "3", ",", "4", ",", "5", ",", "6", ",", "7", ",", 
         "8"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "4", ",", "6", ",", "8"}], "}"}]}], "]"}], 
     "\[Union]", 
     RowBox[{"Complement", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "1", ",", "2", ",", "3", ",", "4", ",", "5", ",", "6", ",", "7", ",", 
         "8"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "4", ",", "7", ",", "8"}], "}"}]}], "]"}]}], ")"}], 
   "\[Intersection]", 
   RowBox[{"Complement", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "1", ",", "2", ",", "3", ",", "4", ",", "5", ",", "6", ",", "7", ",", 
       "8"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"5", ",", "6", ",", "7", ",", "8"}], "}"}]}], "]"}]}], 
  "]"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "Observe that the substitution happened within the ",
 StyleBox[ButtonBox["Hold",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Hold"], "FunctionLink"],
 ". To tell ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " that it should now evaluate the set, we apply ",
 StyleBox[ButtonBox["ReleaseHold",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/ReleaseHold"], "FunctionLink"],
 "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ReleaseHold", "[", 
  RowBox[{"ex14L", "/.", "memberRules"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3"}], "}"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ReleaseHold", "[", 
  RowBox[{"ex14R", "/.", "memberRules"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3"}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "The ",
 StyleBox[ButtonBox["Equal",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Equal"], "FunctionLink"],
 " (",
 StyleBox["==", "Input"],
 ") operator confirms the equality of the sets. To be safe, we apply ",
 StyleBox[ButtonBox["Union",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Union"], "FunctionLink"],
 " before using ",
 StyleBox[ButtonBox["Equal",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Equal"], "FunctionLink"],
 " (",
 StyleBox["==)", "Input"],
 " so as to ensure we do not get an incorrect result due to order or \
duplication."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Union", "[", 
   RowBox[{"ReleaseHold", "[", 
    RowBox[{"ex14L", "/.", "memberRules"}], "]"}], "]"}], "==", 
  RowBox[{"Union", "[", 
   RowBox[{"ReleaseHold", "[", 
    RowBox[{"ex14R", "/.", "memberRules"}], "]"}], "]"}]}]], "Input"],

Cell[BoxData["True"], "Output"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["The Function", "Subsubsection"],

Cell["\<\
Finally, we combine it all into a single function that accepts two held \
expressions as arguments and uses the technique of membership tables to \
determine if the expressions are a set identity.\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"membershipTable", "[", 
   RowBox[{"L_", ",", "R_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "vars", ",", "numvars", ",", "cartesian", ",", "setList", ",", "rownum", 
      ",", "currentTuple", ",", "i", ",", "universe", ",", "ruleList"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"vars", "=", 
      RowBox[{"getVarsSets", "[", 
       RowBox[{"{", 
        RowBox[{"L", ",", "R"}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"numvars", "=", 
      RowBox[{"Length", "[", "vars", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"cartesian", "=", 
      RowBox[{"Tuples", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", "numvars"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"setList", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", "}"}], ",", 
        RowBox[{"{", "numvars", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"rownum", "=", "1"}], ",", 
       RowBox[{"rownum", "\[LessEqual]", 
        RowBox[{"2", "^", "numvars"}]}], ",", 
       RowBox[{"rownum", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"currentTuple", "=", 
         RowBox[{"cartesian", "[", 
          RowBox[{"[", "rownum", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", "1"}], ",", 
          RowBox[{"i", "\[LessEqual]", "numvars"}], ",", 
          RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"currentTuple", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "\[Equal]", "1"}], ",", 
            RowBox[{"AppendTo", "[", 
             RowBox[{
              RowBox[{"setList", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", "rownum"}], "]"}]}], 
           "]"}]}], "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"universe", "=", 
      RowBox[{"Range", "[", 
       RowBox[{"2", "^", "numvars"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ruleList", "=", 
      RowBox[{"MapThread", "[", 
       RowBox[{"Rule", ",", 
        RowBox[{"{", 
         RowBox[{"vars", ",", "setList"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"ruleList", ",", 
       RowBox[{"U", "\[Rule]", "universe"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Union", "[", 
       RowBox[{"ReleaseHold", "[", 
        RowBox[{"L", "/.", "ruleList"}], "]"}], "]"}], "==", 
      RowBox[{"Union", "[", 
       RowBox[{"ReleaseHold", "[", 
        RowBox[{"R", "/.", "ruleList"}], "]"}], "]"}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input"],

Cell[TextData[{
 "We now use our function to check that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"A", "-", "B"}], ")"}], "-", "C"}], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"A", "-", "C"}], ")"}], "-", 
     RowBox[{"(", 
      RowBox[{"B", "-", "C"}], ")"}]}]}], TraditionalForm]]],
 ". Recall that ",
 StyleBox[ButtonBox["Complement",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Complement"], "FunctionLink"],
 " is in fact an implementation of set difference. "
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"membershipTable", "[", 
  RowBox[{
   RowBox[{"Hold", "[", 
    RowBox[{"Complement", "[", 
     RowBox[{
      RowBox[{"Complement", "[", 
       RowBox[{"a", ",", "b"}], "]"}], ",", "c"}], "]"}], "]"}], ",", 
   RowBox[{"Hold", "[", 
    RowBox[{"Complement", "[", 
     RowBox[{
      RowBox[{"Complement", "[", 
       RowBox[{"a", ",", "c"}], "]"}], ",", 
      RowBox[{"Complement", "[", 
       RowBox[{"b", ",", "c"}], "]"}]}], "]"}], "]"}]}], "]"}]], "Input"],

Cell[BoxData["True"], "Output"]
}, Open  ]],

Cell[TextData[{
 "However, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox[
     RowBox[{"A", "\[Union]", "B"}], "_"], "\[NotEqual]", 
    RowBox[{
     OverscriptBox["A", "_"], "\[Union]", 
     OverscriptBox["B", "_"]}]}], TraditionalForm]]],
 "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"membershipTable", "[", 
  RowBox[{
   RowBox[{"Hold", "[", 
    RowBox[{"Complement", "[", 
     RowBox[{"U", ",", 
      RowBox[{"Union", "[", 
       RowBox[{"a", ",", "b"}], "]"}]}], "]"}], "]"}], ",", 
   RowBox[{"Hold", "[", 
    RowBox[{"Union", "[", 
     RowBox[{
      RowBox[{"Complement", "[", 
       RowBox[{"U", ",", "a"}], "]"}], ",", 
      RowBox[{"Complement", "[", 
       RowBox[{"U", ",", "b"}], "]"}]}], "]"}], "]"}]}], "]"}]], "Input"],

Cell[BoxData["False"], "Output"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Holding the Argument Automatically", "Subsubsection"],

Cell[TextData[{
 "We have constructed the ",
 StyleBox["membershipTable", "Input"],
 " function with the restriction that the arguments must be manually held \
when the function is called. Here, we will remove this inconvenience. "
}], "Text"],

Cell[TextData[{
 "An important consequence of ",
 StyleBox[ButtonBox["Hold",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Hold"], "FunctionLink"],
 " is that we are able to manipulate the contents of an expression with head ",
 StyleBox["Hold", "Input"],
 " without it being evaluated. For example, we might want to change the head ",
 StyleBox["Union", "Input"],
 " to a ",
 StyleBox["List", "Input"],
 ". To achieve this, recall that we can use ",
 StyleBox[ButtonBox["Part",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Part"], "FunctionLink"],
 " (",
 StyleBox["[[\[Ellipsis]]]", "Input"],
 ") to access parts of any expression, not just lists. For example, consider \
the expression below."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"partExample", "=", 
  RowBox[{"f", "[", 
   RowBox[{"a", ",", "b", ",", 
    RowBox[{"{", 
     RowBox[{"c", ",", "d"}], "}"}], ",", "e"}], "]"}]}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{"f", "[", 
  RowBox[{"a", ",", "b", ",", 
   RowBox[{"{", 
    RowBox[{"c", ",", "d"}], "}"}], ",", "e"}], "]"}]], "Output"]
}, Open  ]],

Cell["\<\
By accessing the 0 position, we can examine the head of the expression.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"partExample", "[", 
  RowBox[{"[", "0", "]"}], "]"}]], "Input"],

Cell[BoxData["f"], "Output"]
}, Open  ]],

Cell["Positions 1 through 4 access the arguments.", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"partExample", "[", 
  RowBox[{"[", "1", "]"}], "]"}]], "Input"],

Cell[BoxData["a"], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"partExample", "[", 
  RowBox[{"[", "4", "]"}], "]"}]], "Input"],

Cell[BoxData["e"], "Output"]
}, Open  ]],

Cell[TextData[{
 "The third argument is itself an expression and consequently its head and \
arguments can be accessed by ",
 StyleBox["[[3,\[Ellipsis]]]", "Input"],
 ", where the comma is followed by the position within the subexpression, \
i.e., ",
 StyleBox["[[3,0]]", "Input"],
 " for the head, ",
 StyleBox["[[3,1]]", "Input"],
 " for the first argument, etc."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"partExample", "[", 
  RowBox[{"[", 
   RowBox[{"3", ",", "0"}], "]"}], "]"}]], "Input"],

Cell[BoxData["List"], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"partExample", "[", 
  RowBox[{"[", 
   RowBox[{"3", ",", "1"}], "]"}], "]"}]], "Input"],

Cell[BoxData["c"], "Output"]
}, Open  ]],

Cell[TextData[{
 "Recall the example ",
 StyleBox["holdExample", "Input"],
 " we created above."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData["holdExample"], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{"Hold", "[", 
  RowBox[{
   RowBox[{"a", "\[Intersection]", "b"}], "\[Union]", 
   RowBox[{"a", "\[Intersection]", "c"}]}], "]"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "In this held expression, the index ",
 StyleBox["[[1]]", "Input"],
 " refers to the set expression, while ",
 StyleBox["[[1,0]]", "Input"],
 " refers to the head of the set expression. So assigning that to the ",
 StyleBox["List", "Input"],
 " head will transform the union into a list. And this change is accomplished \
without any part of the held expression being evaluated."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"holdExample", "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "0"}], "]"}], "]"}], "=", "List"}], 
  ";"}], "\[IndentingNewLine]", "holdExample"}], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{"Hold", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"a", "\[Intersection]", "b"}], ",", 
    RowBox[{"a", "\[Intersection]", "c"}]}], "}"}], "]"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "The ",
 StyleBox[ButtonBox["Extract",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Extract"], "FunctionLink"],
 " function allows you to pull out a part of an expression and nearly \
simultaneously apply a head to the part accessed. To do this, the first \
argument is the main expression you wish to extract from, the second argument \
is a list specifying the position being extracted, and the third argument is \
the head you wish to apply to the extracted part. For example, we can extract \
the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "\[Intersection]", "c"}], TraditionalForm]]],
 " from ",
 StyleBox["holdExample", "Input"],
 " and ",
 StyleBox[ButtonBox["Hold",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Hold"], "FunctionLink"],
 " it, as follows. "
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Extract", "[", 
  RowBox[{"holdExample", ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", "Hold"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"Hold", "[", 
  RowBox[{"a", "\[Intersection]", "c"}], "]"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "While ",
 StyleBox[ButtonBox["Hold",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Hold"], "FunctionLink"],
 " acts on an expression to explicitly prevent its evaluation, ",
 StyleBox[ButtonBox["HoldAll",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/HoldAll"], "FunctionLink"],
 " is an attribute that tells a function to delay evaluation of its \
arguments. Ordinarily, when you evaluate an expression involving a function \
call, any arguments to the function are evaluated first, before they are sent \
to the function. Our ultimate goal in this section is to write functions that \
can operate on set expressions. In particular, we would like to be able to \
call expressions like the one shown below to create a membership table for a \
set."
}], "Text"],

Cell[BoxData[
 RowBox[{"membershipTable", "[", 
  RowBox[{
   RowBox[{"Complement", "[", 
    RowBox[{"U", ",", 
     RowBox[{"Union", "[", 
      RowBox[{"a", ",", "b"}], "]"}]}], "]"}], ",", "\n", "    ", 
   RowBox[{"Union", "[", 
    RowBox[{
     RowBox[{"Complement", "[", 
      RowBox[{"U", ",", "a"}], "]"}], ",", 
     RowBox[{"Complement", "[", 
      RowBox[{"U", ",", "b"}], "]"}]}], "]"}]}], "]"}]], "myCode",
 Evaluatable->False,
 InitializationCell->False],

Cell[TextData[{
 "In order for the above to work, either we must include a ",
 StyleBox[ButtonBox["Hold",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Hold"], "FunctionLink"],
 " as part of the argument each time we want to use the function, as we did \
above, or we have to prevent ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " from evaluating the argument long enough for us to explicitly place a ",
 StyleBox[ButtonBox["Hold",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Hold"], "FunctionLink"],
 " on the argument within the body of the function definition. Clearly, \
avoiding the need for including ",
 StyleBox[ButtonBox["Hold",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Hold"], "FunctionLink"],
 " with every function call is preferable. The ",
 StyleBox[ButtonBox["HoldAll",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/HoldAll"], "FunctionLink"],
 " attribute allows us to do this."
}], "Text"],

Cell[TextData[{
 "To see how this works, we will design a small function to use as an \
example. This function will print its argument as entered by applying ",
 StyleBox[ButtonBox["Hold",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Hold"], "FunctionLink"],
 " to the argument. ",
 "Here is the definition of the function."
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"printHold", "[", "x_", "]"}], ":=", 
  RowBox[{"Print", "[", 
   RowBox[{"Hold", "[", "x", "]"}], "]"}]}]], "Input",
 InitializationCell->True],

Cell[TextData[{
 "We expect this function to take an argument, for instance ",
 StyleBox["1+2", "Input"],
 ", and print ",
 StyleBox["1+2", "Input"],
 " (with the ",
 StyleBox["Hold", "Input"],
 " head). For the moment, however, it does not."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"printHold", "[", 
  RowBox[{"1", "+", "2"}], "]"}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{"Hold", "[", "3", "]"}]], "Print"]
}, Open  ]],

Cell[TextData[{
 "The problem is that ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " is evaluating the argument, ",
 StyleBox["1+2", "Input"],
 ", before actually applying the function. So when the body of the function \
is called, ",
 StyleBox["x", "Input"],
 " has value ",
 StyleBox["3", "Input"],
 ", not ",
 StyleBox["1+2", "Input"],
 ". To fix this, we assign the ",
 StyleBox[ButtonBox["HoldAll",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/HoldAll"], "FunctionLink"],
 " attribute to the function by calling ",
 StyleBox[ButtonBox["SetAttributes",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/SetAttributes"], "FunctionLink"],
 " with the function name and the name of the attribute as arguments."
}], "Text"],

Cell[BoxData[
 RowBox[{"SetAttributes", "[", 
  RowBox[{"printHold", ",", "HoldAll"}], "]"}]], "Input",
 InitializationCell->True],

Cell[TextData[{
 "Now when we execute the function, ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " does not evaluate the argument, so that the explicit ",
 StyleBox[ButtonBox["Hold",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Hold"], "FunctionLink"],
 " is able to be applied to the expression ",
 StyleBox["1+2", "Input"],
 "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"printHold", "[", 
  RowBox[{"1", "+", "2"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"Hold", "[", 
  RowBox[{"1", "+", "2"}], "]"}]], "Print"]
}, Open  ]],

Cell[TextData[{
 "Note that the ",
 StyleBox[ButtonBox["HoldAll",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/HoldAll"], "FunctionLink"],
 " attribute is a bit of a misnomer. It does not cause the arguments to the \
function to be held, in the sense of applying the ",
 StyleBox[ButtonBox["Hold",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Hold"], "FunctionLink"],
 " function to them. It is a temporary hold, and the first time the argument \
is used within the body of the function definition, it will be evaluated, \
unless it is explicitly held. In other words, the ",
 StyleBox[ButtonBox["Hold",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Hold"], "FunctionLink"],
 " within the ",
 StyleBox[ButtonBox["Print",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Print"], "FunctionLink"],
 " is required, or else 1+2 will be evaluated to 3 within the execution of ",
 StyleBox[ButtonBox["Print",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Print"], "FunctionLink"],
 "."
}], "Text"],

Cell[TextData[{
 "In addition to calling ",
 StyleBox["membershipTable", "Input"],
 " with set expressions, we also want to be able to apply the function to \
symbols that store set expressions. Using ",
 StyleBox[ButtonBox["SetDelayed",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/SetDelayed"], "FunctionLink"],
 " (",
 StyleBox[":=", "Input"],
 "), we can assign an expression to a symbol without the expression being \
evaluated."
}], "Text"],

Cell[BoxData[
 RowBox[{"delayedExample", ":=", 
  RowBox[{"Union", "[", 
   RowBox[{
    RowBox[{"Intersection", "[", 
     RowBox[{"a", ",", "b"}], "]"}], ",", 
    RowBox[{"Intersection", "[", 
     RowBox[{"a", ",", "c"}], "]"}]}], "]"}]}]], "Input",
 InitializationCell->True],

Cell[TextData[{
 "Because we used ",
 StyleBox[ButtonBox["SetDelayed",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/SetDelayed"], "FunctionLink"],
 " (",
 StyleBox[":=", "Input"],
 "), the symbol ",
 StyleBox["delayedExample", "Input"],
 " holds the unevaluated expression. However, if we evaluate the symbol, we \
are faced with the warnings and unwanted simplification that we saw before."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData["delayedExample"], "Input"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"Intersection", "::", "normal"}], "MessageName"], 
  RowBox[{
  ":", " "}], "\<\"Nonatomic expression expected at position \
\[NoBreak]\\!\\(1\\)\[NoBreak] in \[NoBreak]\\!\\(a \[Intersection] b\\)\
\[NoBreak]. \\!\\(\\*ButtonBox[\\\"\[RightSkeleton]\\\", \
ButtonStyle->\\\"Link\\\", ButtonFrame->None, \
ButtonData:>\\\"paclet:ref/message/General/normal\\\", ButtonNote -> \
\\\"Intersection::normal\\\"]\\)\"\>"}]], "Message", "MSG"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"Intersection", "::", "normal"}], "MessageName"], 
  RowBox[{
  ":", " "}], "\<\"Nonatomic expression expected at position \
\[NoBreak]\\!\\(1\\)\[NoBreak] in \[NoBreak]\\!\\(a \[Intersection] c\\)\
\[NoBreak]. \\!\\(\\*ButtonBox[\\\"\[RightSkeleton]\\\", \
ButtonStyle->\\\"Link\\\", ButtonFrame->None, \
ButtonData:>\\\"paclet:ref/message/General/normal\\\", ButtonNote -> \
\\\"Intersection::normal\\\"]\\)\"\>"}]], "Message", "MSG"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"Intersection", "::", "normal"}], "MessageName"], 
  RowBox[{
  ":", " "}], "\<\"Nonatomic expression expected at position \
\[NoBreak]\\!\\(1\\)\[NoBreak] in \[NoBreak]\\!\\(a \[Intersection] b \
\[Intersection] c\\)\[NoBreak]. \\!\\(\\*ButtonBox[\\\"\[RightSkeleton]\\\", \
ButtonStyle->\\\"Link\\\", ButtonFrame->None, \
ButtonData:>\\\"paclet:ref/message/General/normal\\\", ButtonNote -> \
\\\"Intersection::normal\\\"]\\)\"\>"}]], "Message", "MSG"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"General", "::", "stop"}], "MessageName"], 
  RowBox[{
  ":", " "}], "\<\"Further output of \
\[NoBreak]\\!\\(\\*StyleBox[\\(Intersection :: normal\\), \
\\\"MessageName\\\"]\\)\[NoBreak] will be suppressed during this calculation. \
\\!\\(\\*ButtonBox[\\\"\[RightSkeleton]\\\", ButtonStyle->\\\"Link\\\", \
ButtonFrame->None, ButtonData:>\\\"paclet:ref/message/General/stop\\\", \
ButtonNote -> \\\"General::stop\\\"]\\)\"\>"}]], "Message", "MSG"],

Cell[BoxData[
 RowBox[{"a", "\[Intersection]", "b", "\[Intersection]", "c"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "The ",
 StyleBox["printHold", "Input"],
 " function, applied to the symbol, does not print the expression."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"printHold", "[", "delayedExample", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"Hold", "[", "delayedExample", "]"}]], "Print"]
}, Open  ]],

Cell[TextData[{
 "We seem to have a conundrum. We cannot allow the symbol to be evaluated or \
it will produce errors, but if we do not evaluate it, all we see is the name \
of the symbol. To deal with this, we will use ",
 StyleBox[ButtonBox["OwnValues",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/OwnValues"], "FunctionLink"],
 ", a function that reveals the value assigned to a symbol, expressed as a \
list of transformation rules. Observe what happens when we apply ",
 StyleBox[ButtonBox["OwnValues",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/OwnValues"], "FunctionLink"],
 " to ",
 StyleBox["delayedExample", "Input"],
 "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"OwnValues", "[", "delayedExample", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"HoldPattern", "[", "delayedExample", "]"}], "\[RuleDelayed]", 
   RowBox[{
    RowBox[{"a", "\[Intersection]", "b"}], "\[Union]", 
    RowBox[{"a", "\[Intersection]", "c"}]}]}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s explain this output a bit. First, the ",
 StyleBox[ButtonBox["HoldPattern",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/HoldPattern"], "FunctionLink"],
 " function, which is applied to the name ",
 StyleBox["delayedExample", "Input"],
 ", can be thought of, in this context, as a hold for the left hand side of a \
rule. The \[RuleDelayed] symbol is for ",
 StyleBox[ButtonBox["RuleDelayed",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/RuleDelayed"], "FunctionLink"],
 ", indicating that our assignment was delayed. Finally, the right hand side \
of the \[RuleDelayed] is our original assignment."
}], "Text"],

Cell[TextData[{
 "By looking at this in ",
 ButtonBox["FullForm",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/FullForm"],
 ", we can more easily see how we can access the expression."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"OwnValues", "[", "delayedExample", "]"}], "//", 
  "FullForm"}]], "Input"],

Cell[BoxData[
 TagBox[
  StyleBox[
   RowBox[{"List", "[", 
    RowBox[{"RuleDelayed", "[", 
     RowBox[{
      RowBox[{"HoldPattern", "[", "delayedExample", "]"}], ",", 
      RowBox[{"Union", "[", 
       RowBox[{
        RowBox[{"Intersection", "[", 
         RowBox[{"a", ",", "b"}], "]"}], ",", 
        RowBox[{"Intersection", "[", 
         RowBox[{"a", ",", "c"}], "]"}]}], "]"}]}], "]"}], "]"}],
   ShowSpecialCharacters->False,
   ShowStringCharacters->True,
   NumberMarks->True],
  FullForm]], "Output"]
}, Open  ]],

Cell[TextData[{
 "This expression is a list containing a single element. That element has \
head ",
 StyleBox[ButtonBox["RuleDelayed",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/RuleDelayed"], "FunctionLink"],
 ", which itself has two arguments, the second of which is our expression. \
Consequently, we can access the expression by use of ",
 StyleBox["[[1,2]]", "Input"],
 "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"OwnValues", "[", "delayedExample", "]"}], "[", 
  RowBox[{"[", 
   RowBox[{"1", ",", "2"}], "]"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"Intersection", "::", "normal"}], "MessageName"], 
  RowBox[{
  ":", " "}], "\<\"Nonatomic expression expected at position \
\[NoBreak]\\!\\(1\\)\[NoBreak] in \[NoBreak]\\!\\(a \[Intersection] b \
\[Intersection] c\\)\[NoBreak]. \\!\\(\\*ButtonBox[\\\"\[RightSkeleton]\\\", \
ButtonStyle->\\\"Link\\\", ButtonFrame->None, \
ButtonData:>\\\"paclet:ref/message/General/normal\\\", ButtonNote -> \
\\\"Intersection::normal\\\"]\\)\"\>"}]], "Message", "MSG"],

Cell[BoxData[
 RowBox[{"a", "\[Intersection]", "b", "\[Intersection]", "c"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "Sadly, as soon as we access the expression, it is evaluated. So we use ",
 StyleBox[ButtonBox["Extract",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Extract"], "FunctionLink"],
 " instead."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Extract", "[", 
  RowBox[{
   RowBox[{"OwnValues", "[", "delayedExample", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", "Hold"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"Hold", "[", 
  RowBox[{
   RowBox[{"a", "\[Intersection]", "b"}], "\[Union]", 
   RowBox[{"a", "\[Intersection]", "c"}]}], "]"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "We now know how to handle the argument to our function, whether it is an \
expression or a symbol that is assigned to an expression. To distinguish \
between these, we only need to test whether the head of the input is ",
 StyleBox[ButtonBox["Symbol",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Symbol"], "FunctionLink"],
 " or not. Given the argument to a function with ",
 StyleBox[ButtonBox["HoldAll",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/HoldAll"], "FunctionLink"],
 " attribute, we can determine the head of the argument, while still \
preventing the argument from being evaluated, as follows: apply ",
 StyleBox[ButtonBox["Hold",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Hold"], "FunctionLink"],
 " explicitly and then access ",
 StyleBox["[[1,0]]", "Input"],
 ". This is the correct \
\[OpenCurlyDoubleQuote]address\[CloseCurlyDoubleQuote] for the ",
 StyleBox[ButtonBox["Part",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Part"], "FunctionLink"],
 " (",
 StyleBox["[[\[Ellipsis]]]", "Input"],
 ") operator because the 1 refers to the argument of the ",
 ButtonBox["Hold",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Hold"],
 ", and the 0 then refers to the head of what is being held."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Hold", "[", "delayedExample", "]"}], "[", 
  RowBox[{"[", 
   RowBox[{"1", ",", "0"}], "]"}], "]"}]], "Input"],

Cell[BoxData["Symbol"], "Output"]
}, Open  ]],

Cell[TextData[{
 "Here now is our improved version of the ",
 StyleBox["printHold", "Input"],
 " function. Recall that it was previously given the ",
 StyleBox[ButtonBox["HoldAll",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/HoldAll"], "FunctionLink"],
 " attribute."
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"printHold", "[", "x_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "y", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Hold", "[", "x", "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "0"}], "]"}], "]"}], "===", "Symbol"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"y", "=", 
        RowBox[{"Extract", "[", 
         RowBox[{
          RowBox[{"OwnValues", "[", "x", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}], ",", "Hold"}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"y", "=", 
        RowBox[{"Hold", "[", "x", "]"}]}]}], "\[IndentingNewLine]", "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "y", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input"],

Cell[TextData[{
 "If we pass a variable to ",
 StyleBox["printHold", "Input"],
 ", the if condition identifies it as a symbol and uses ",
 StyleBox[ButtonBox["Extract",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Extract"], "FunctionLink"],
 " and ",
 StyleBox[ButtonBox["OwnValues",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/OwnValues"], "FunctionLink"],
 " to get access to the definition."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"printHold", "[", "delayedExample", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"Hold", "[", 
  RowBox[{
   RowBox[{"a", "\[Intersection]", "b"}], "\[Union]", 
   RowBox[{"a", "\[Intersection]", "c"}]}], "]"}]], "Print"]
}, Open  ]],

Cell["\<\
On the other hand, if we give it an expression, then the argument is not a \
symbol and is held just as it was called.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"printHold", "[", 
  RowBox[{"1", "+", "2"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"Hold", "[", 
  RowBox[{"1", "+", "2"}], "]"}]], "Print"]
}, Open  ]],

Cell[TextData[{
 "We also want the function to behave properly if it is given a held \
expression. In particular, we want to avoid nesting holds. To do this, we\
\[CloseCurlyQuote]ll replace the ",
 StyleBox[ButtonBox["If",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/If"], "FunctionLink"],
 " statement with a ",
 StyleBox[ButtonBox["Switch",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Switch"], "FunctionLink"],
 ". The first argument of a ",
 StyleBox[ButtonBox["Switch",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Switch"], "FunctionLink"],
 " is evaluated. In this case, the first argument will evaluate to the head \
of the input. The ",
 StyleBox[ButtonBox["Switch",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Switch"], "FunctionLink"],
 " then looks at the even indexed arguments until it finds one that matches \
the result of the first argument and it evaluates the argument after the one \
that matches. We include a ",
 StyleBox[ButtonBox["Blank",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Blank"], "FunctionLink"],
 " (",
 StyleBox["_", "Input"],
 ") as the next to last argument, which means that the final argument will \
serve as a default."
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"printHold", "[", "x_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "y", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Switch", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Hold", "[", "x", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "0"}], "]"}], "]"}], ",", "\[IndentingNewLine]", 
       "Hold", ",", 
       RowBox[{"y", "=", "x"}], ",", "\[IndentingNewLine]", "Symbol", ",", 
       RowBox[{"y", "=", 
        RowBox[{"Extract", "[", 
         RowBox[{
          RowBox[{"OwnValues", "[", "x", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}], ",", "Hold"}], "]"}]}], ",", 
       "\[IndentingNewLine]", "_", ",", 
       RowBox[{"y", "=", 
        RowBox[{"Hold", "[", "x", "]"}]}]}], "\[IndentingNewLine]", "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "y", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 InitializationCell->True],

Cell["\<\
We\[CloseCurlyQuote]ll be using this technique several times in what follows, \
so we\[CloseCurlyQuote]ll encapsulate it as its own function.\
\>", "Text"],

Cell[BoxData[
 RowBox[{"SetAttributes", "[", 
  RowBox[{"holdArgument", ",", "HoldAll"}], "]"}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{
  RowBox[{"holdArgument", "[", "x_", "]"}], ":=", 
  RowBox[{"Switch", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Hold", "[", "x", "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", "0"}], "]"}], "]"}], ",", "\[IndentingNewLine]", 
    "Hold", ",", "x", ",", "\[IndentingNewLine]", "Symbol", ",", 
    RowBox[{"Extract", "[", 
     RowBox[{
      RowBox[{"OwnValues", "[", "x", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], ",", "Hold"}], "]"}], ",", 
    "\[IndentingNewLine]", "_", ",", 
    RowBox[{"Hold", "[", "x", "]"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 InitializationCell->True],

Cell[TextData[{
 "This allows us to embed this part of the argument processing into the \
declaration of the module variables, as shown in the following alternate \
version of ",
 StyleBox["printHold", "Input"],
 "."
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"printHold2", "[", "x_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"y", "=", 
      RowBox[{"holdArgument", "[", "x", "]"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Print", "[", "y", "]"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{"SetAttributes", "[", 
  RowBox[{"printHold2", ",", "HoldAll"}], "]"}]], "Input",
 InitializationCell->True],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"printHold2", "[", "delayedExample", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"Hold", "[", 
  RowBox[{
   RowBox[{"a", "\[Intersection]", "b"}], "\[Union]", 
   RowBox[{"a", "\[Intersection]", "c"}]}], "]"}]], "Print"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"printHold2", "[", 
  RowBox[{"1", "+", "2"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"Hold", "[", 
  RowBox[{"1", "+", "2"}], "]"}]], "Print"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"printHold2", "[", 
  RowBox[{"Hold", "[", 
   RowBox[{"p", "&&", "q"}], "]"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"Hold", "[", 
  RowBox[{"p", "&&", "q"}], "]"}]], "Print"]
}, Open  ]],

Cell[TextData[{
 "We now use the ",
 StyleBox["holdArgument", "Input"],
 " function to update ",
 StyleBox["membershipTable", "Input"],
 "."
}], "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{"membershipTable", ",", "HoldAll"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"membershipTable", "[", 
    RowBox[{"LS_", ",", "RS_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"L", "=", 
        RowBox[{"holdArgument", "[", "LS", "]"}]}], ",", 
       RowBox[{"R", "=", 
        RowBox[{"holdArgument", "[", "RS", "]"}]}], ",", "vars", ",", 
       "numvars", ",", "cartesian", ",", "setList", ",", "rownum", ",", 
       "currentTuple", ",", "i", ",", "universe", ",", "ruleList"}], "}"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vars", "=", 
       RowBox[{"getVarsSets", "[", 
        RowBox[{"{", 
         RowBox[{"L", ",", "R"}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"numvars", "=", 
       RowBox[{"Length", "[", "vars", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"cartesian", "=", 
       RowBox[{"Tuples", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "1"}], "}"}], ",", "numvars"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"setList", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", "}"}], ",", 
         RowBox[{"{", "numvars", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"rownum", "=", "1"}], ",", 
        RowBox[{"rownum", "\[LessEqual]", 
         RowBox[{"2", "^", "numvars"}]}], ",", 
        RowBox[{"rownum", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"currentTuple", "=", 
          RowBox[{"cartesian", "[", 
           RowBox[{"[", "rownum", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"i", "=", "1"}], ",", 
           RowBox[{"i", "\[LessEqual]", "numvars"}], ",", 
           RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"currentTuple", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "\[Equal]", "1"}], ",", 
             RowBox[{"AppendTo", "[", 
              RowBox[{
               RowBox[{"setList", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", "rownum"}], "]"}]}], 
            "]"}]}], "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"universe", "=", 
       RowBox[{"Range", "[", 
        RowBox[{"2", "^", "numvars"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ruleList", "=", 
       RowBox[{"MapThread", "[", 
        RowBox[{"Rule", ",", 
         RowBox[{"{", 
          RowBox[{"vars", ",", "setList"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"ruleList", ",", 
        RowBox[{"U", "\[Rule]", "universe"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Union", "[", 
        RowBox[{"ReleaseHold", "[", 
         RowBox[{"L", "/.", "ruleList"}], "]"}], "]"}], "==", 
       RowBox[{"Union", "[", 
        RowBox[{"ReleaseHold", "[", 
         RowBox[{"R", "/.", "ruleList"}], "]"}], "]"}]}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 InitializationCell->True],

Cell[TextData[{
 "Now, we can omit the explicit calls to ",
 StyleBox[ButtonBox["Hold",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Hold"], "FunctionLink"],
 "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"membershipTable", "[", 
  RowBox[{
   RowBox[{"Complement", "[", 
    RowBox[{
     RowBox[{"Complement", "[", 
      RowBox[{"a", ",", "b"}], "]"}], ",", "c"}], "]"}], ",", 
   RowBox[{"Complement", "[", 
    RowBox[{
     RowBox[{"Complement", "[", 
      RowBox[{"a", ",", "c"}], "]"}], ",", 
     RowBox[{"Complement", "[", 
      RowBox[{"b", ",", "c"}], "]"}]}], "]"}]}], "]"}]], "Input"],

Cell[BoxData["True"], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"membershipTable", "[", 
  RowBox[{
   RowBox[{"Complement", "[", 
    RowBox[{"U", ",", 
     RowBox[{"Union", "[", 
      RowBox[{"a", ",", "b"}], "]"}]}], "]"}], ",", 
   RowBox[{"Union", "[", 
    RowBox[{
     RowBox[{"Complement", "[", 
      RowBox[{"U", ",", "a"}], "]"}], ",", 
     RowBox[{"Complement", "[", 
      RowBox[{"U", ",", "b"}], "]"}]}], "]"}]}], "]"}]], "Input"],

Cell[BoxData["False"], "Output"]
}, Open  ]]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Computer Representation of Fuzzy Sets", "Subsection",
 CellTags->"Section2c"],

Cell[TextData[{
 "The textbook describes a way to represent sets as bit strings in order to \
efficiently store and compute with them. Here, we will explore this idea \
further in order to see how we can represent fuzzy sets in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ". Fuzzy sets are described in the preamble to Exercise 63 in Section 2.2."
}], "Text"],

Cell[CellGroupData[{

Cell["Two Representations of Fuzzy Sets", "Subsubsection"],

Cell["\<\
In a fuzzy set, every element has an associated degree of membership, which \
is a real number between 0 and 1. We will represent fuzzy sets in two \
different ways.\
\>", "Text"],

Cell[TextData[{
 "The first way we can represent a fuzzy set in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " is to combine the element with the degree of membership as a two-element \
list. For example, if the elements of our fuzzy set are the letters \
\[OpenCurlyDoubleQuote]a\[CloseCurlyDoubleQuote], \[OpenCurlyDoubleQuote]b\
\[CloseCurlyDoubleQuote], and \
\[OpenCurlyDoubleQuote]e\[CloseCurlyDoubleQuote], where \
\[OpenCurlyDoubleQuote]a\[CloseCurlyDoubleQuote] has degree of membership \
0.3, \[OpenCurlyDoubleQuote]b\[CloseCurlyDoubleQuote] has degree 0.7, and \
\[OpenCurlyDoubleQuote]e\[CloseCurlyDoubleQuote] has degree 0.1, then we \
would represent the set as:"
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"fuzzyRoster", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\"\<a\>\"", ",", "0.3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"\"\<b\>\"", ",", "0.7"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"\"\<e\>\"", ",", "0.1"}], "}"}]}], "}"}]}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\<\"a\"\>", ",", "0.3`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"b\"\>", ",", "0.7`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"e\"\>", ",", "0.1`"}], "}"}]}], "}"}]], "Output"]
}, Open  ]],

Cell["\<\
We refer to this as the \[OpenCurlyDoubleQuote]roster representation\
\[CloseCurlyDoubleQuote] of the fuzzy set.\
\>", "Text"],

Cell["\<\
The second approach is to use a \[OpenCurlyDoubleQuote]fuzzy-bit string\
\[CloseCurlyDoubleQuote] in essentially the same way as described in the \
text. First we need to specify the universe and impose an order on it. Let\
\[CloseCurlyQuote]s say the universe consists of the letters \
\[OpenCurlyDoubleQuote]a\[CloseCurlyDoubleQuote] through \
\[OpenCurlyDoubleQuote]g\[CloseCurlyDoubleQuote] ordered alphabetically. \
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"fuzzyU", "=", 
  RowBox[{"{", 
   RowBox[{
   "\"\<a\>\"", ",", "\"\<b\>\"", ",", "\"\<c\>\"", ",", "\"\<d\>\"", ",", 
    "\"\<e\>\"", ",", "\"\<f\>\"", ",", "\"\<g\>\""}], "}"}]}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"a\"\>", ",", "\<\"b\"\>", ",", "\<\"c\"\>", ",", "\<\"d\"\>", 
   ",", "\<\"e\"\>", ",", "\<\"f\"\>", ",", "\<\"g\"\>"}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "Then the fuzzy-bit string for the set ",
 StyleBox["fuzzyR", "Input"],
 " will be the list of the degrees of membership of each element of the \
universe with 0 indicating non-membership."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"fuzzyBitString", "=", 
  RowBox[{"{", 
   RowBox[{
   "0.3", ",", "0.7", ",", "0", ",", "0", ",", "0.1", ",", "0", ",", "0"}], 
   "}"}]}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "0.3`", ",", "0.7`", ",", "0", ",", "0", ",", "0.1`", ",", "0", ",", "0"}], 
  "}"}]], "Output"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Converting from Bit String to Roster Representation", "Subsubsection"],

Cell[TextData[{
 "Converting from a fuzzy-bit string to the roster representation is fairly \
straightforward. Use a ",
 StyleBox[ButtonBox["For",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/For"], "FunctionLink"],
 " loop with index running from 1 to the number of elements in the universe. \
For each index, if the entry in the fuzzy-bit string is non-zero, then we add \
to the roster the pair consisting of the element from the universe and the \
degree of membership."
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"bitToRoster", "[", 
   RowBox[{"bitstring_", ",", "universe_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"S", "=", 
       RowBox[{"{", "}"}]}], ",", "i"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "\[LessEqual]", 
        RowBox[{"Length", "[", "universe", "]"}]}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"bitstring", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "\[NotEqual]", "0"}], ",", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"S", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"universe", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", 
             RowBox[{"bitstring", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], "]"}]}], "]"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", "S"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True],

Cell[TextData[{
 "Note that we give ",
 StyleBox["S", "Input"],
 " as the last expression so that it will be the output of the function. \
Otherwise, the ",
 StyleBox[ButtonBox["For",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/For"], "FunctionLink"],
 " loop will produce no output."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"bitToRoster", "[", 
  RowBox[{"fuzzyBitString", ",", "fuzzyU"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\<\"a\"\>", ",", "0.3`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"b\"\>", ",", "0.7`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"e\"\>", ",", "0.1`"}], "}"}]}], "}"}]], "Output"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Converting from Roster to Bit String Representation", "Subsubsection"],

Cell[TextData[{
 "In the other direction, we initialize a bit string to the 0-string. Then we \
consider each member of the roster representation in turn, using a ",
 StyleBox[ButtonBox["Do",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Do"], "FunctionLink"],
 " loop over the elements of the roster. Recall that with second argument of \
the form ",
 Cell[BoxData[
  RowBox[{"{", 
   StyleBox["var", "CodeVar"], ",", 
   StyleBox["list", "CodeVar"], "}"}]], "myCode"],
 " the variable will be assigned to each element of the list in turn. In this \
case, ",
 Cell[BoxData[
  FormBox["list", CodeVar]], "myCode"],
 " will be the roster representation and so the variable will be assigned to \
each of the lists consisting of the element/membership pairs."
}], "Text"],

Cell[TextData[{
 "For every member of the set, we will need to determine the position of the \
set member in the universe in order to change the correct bit in the \
fuzzy-bit string.",
 " To do this, we will make use of the ",
 StyleBox[ButtonBox["Position",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Position"], "FunctionLink"],
 " function. Given two arguments, ",
 StyleBox[ButtonBox["Position",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Position"], "FunctionLink"],
 " will return a list of lists specifying all the positions at which the \
second argument appears in the first. The following illustrates using ",
 StyleBox[ButtonBox["Position",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Position"], "FunctionLink"],
 " to determine that 2 appears in locations 3 and 6 in the list."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Position", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "3", ",", "5", ",", "2", ",", "9", ",", "4", ",", "2", ",", "1", ",", 
     "8"}], "}"}], ",", "2"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "3", "}"}], ",", 
   RowBox[{"{", "6", "}"}]}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "The reason ",
 StyleBox[ButtonBox["Position",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Position"], "FunctionLink"],
 " returns a list of this form is in case of nesting in the first argument."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Position", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"9", ",", "7", ",", "1", ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "0", ",", "7"}], "}"}], ",", "5"}], "}"}], ",", "7"}],
   "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "2", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "3"}], "}"}]}], "}"}]], "Output"]
}, Open  ]],

Cell["\<\
The above shows that 7 appears in position 2 and in position 3 of the sublist \
at location 4.\
\>", "Text"],

Cell[TextData[{
 "In the current context, we will assume that our data is well formed, in \
which case when we apply ",
 StyleBox[ButtonBox["Position",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Position"], "FunctionLink"],
 " to the universe, there is only one instance of the sought-after object and \
there is no nesting. Therefore, we can access the appropriate index by \
applying the ",
 StyleBox[ButtonBox["Part",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Part"], "FunctionLink"],
 " (",
 StyleBox["[[\[Ellipsis]]]", "Input"],
 ") operator as follows."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Position", "[", 
   RowBox[{"fuzzyU", ",", "\"\<b\>\""}], "]"}], "[", 
  RowBox[{"[", 
   RowBox[{"1", ",", "1"}], "]"}], "]"}]], "Input"],

Cell[BoxData["2"], "Output"]
}, Open  ]],

Cell[TextData[{
 "Now we can write the ",
 StyleBox["rosterToBit", "Input"],
 " function."
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rosterToBit", "[", 
   RowBox[{"roster_", ",", "universe_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"B", ",", "e", ",", "position"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"B", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"Length", "[", "universe", "]"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"position", "=", 
         RowBox[{
          RowBox[{"Position", "[", 
           RowBox[{"universe", ",", 
            RowBox[{"e", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"B", "[", 
          RowBox[{"[", "position", "]"}], "]"}], "=", 
         RowBox[{"e", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"e", ",", "roster"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "B"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",\

 InitializationCell->True],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"rosterToBit", "[", 
  RowBox[{"fuzzyRoster", ",", "fuzzyU"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "0.3`", ",", "0.7`", ",", "0", ",", "0", ",", "0.1`", ",", "0", ",", "0"}], 
  "}"}]], "Output"]
}, Open  ]]
}, Open  ]]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["2.3 Functions", "Section",
 CellTags->"Section3"],

Cell[TextData[{
 "In this section we will see ways to represent functions in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " and explore a variety of the concepts described in the text relative to \
these different representations."
}], "Text"],

Cell[CellGroupData[{

Cell["Functions", "Subsection",
 CellTags->"Section3a"],

Cell[TextData[{
 "In this manual, we have already seen several examples of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " functions. In some ways, a computer program is the ultimate generalization \
of a mathematical function. As an example, consider the ",
 StyleBox["getVars", "Input"],
 " function. This function assigns to each valid input (a ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " logical expression) a unique output (a list of the symbols appearing in \
the expression). Setting ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]]],
 " equal to the set consisting of all logic expressions and ",
 Cell[BoxData[
  FormBox["B", TraditionalForm]]],
 " equal to the set of all possible lists of valid symbols, ",
 StyleBox["getVars", "Input"],
 " satisfies the definition of being a function from ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]]],
 " to ",
 Cell[BoxData[
  FormBox["B", TraditionalForm]]],
 "."
}], "Text"],

Cell["\<\
We discussed functions in some depth in the introductory chapter. Here, we \
will discuss the concept of domain as they relate to programs via the \
computer programming concept of type.\
\>", "Text"],

Cell[TextData[{
 "In Example 5 of Section 2.3, the text gives examples from Java and C++ \
showing how domain and codomain are specified in those programming languages. \
The function below illustrates how to specify the domain of a function in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "."
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"floor1", "[", "x_Real", "]"}], ":=", 
  RowBox[{"Floor", "[", "x", "]"}]}]], "Input",
 InitializationCell->True],

Cell[TextData[{
 "The body of our ",
 StyleBox["floor1", "Input"],
 " function is merely a call to ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "\[CloseCurlyQuote]s built-in ",
 StyleBox[ButtonBox["Floor",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Floor"], "FunctionLink"],
 " command. But the example illustrates how you can specify the domain (i.e., \
the type of a parameter) of a function."
}], "Text"],

Cell[TextData[{
 "In the example above, we declared the type of the parameter ",
 StyleBox["x", "Input"],
 " by following the blank (",
 StyleBox["_", "Input"],
 ") with the symbol ",
 StyleBox["Real", "Input"],
 ", which is the head used for floating-point numbers in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ". If the function is called with an argument whose head does not match, \
then the function definition is not applied. In this case, ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " merely returns the expression unevaluated."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"floor1", "[", "\"\<hello\>\"", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"floor1", "[", "\<\"hello\"\>", "]"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "There are four built-in numerical types in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ": ",
 StyleBox["Integer", "Input"],
 ", ",
 StyleBox["Rational", "Input"],
 ", ",
 StyleBox["Real", "Input"],
 ", and ",
 StyleBox["Complex", "Input"],
 ". But any head can be used in the same manner. For example, to create a \
function whose argument must be a list, you would define the function as \
below."
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"last", "[", "L_List", "]"}], ":=", 
  RowBox[{"L", "[", 
   RowBox[{"[", 
    RowBox[{"-", "1"}], "]"}], "]"}]}]], "Input",
 InitializationCell->True],

Cell["\<\
This function will determine the last element of any list, but will not \
execute if it is given an object that is not a list.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"last", "[", 
  RowBox[{"{", 
   RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "5"}], "}"}], 
  "]"}]], "Input"],

Cell[BoxData["5"], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"last", "[", "5", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"last", "[", "5", "]"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "The expressions ",
 StyleBox["x_Real", "Input"],
 " and ",
 StyleBox["L_List", "Input"],
 " are examples of patterns. When you define a function, you are providing ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " with a rule that tells it how to evaluate an expression matching the \
pattern. Specifically, the definition for ",
 StyleBox["last", "Input"],
 " creates an evaluation rule that tells ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " what to do with an expression that has head ",
 StyleBox["List", "Input"],
 ". "
}], "Text"],

Cell[TextData[{
 "You can further specify the allowed domain of a function by creating a \
pattern that uses a Boolean-valued function to determine whether the argument \
is allowable. For example, ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " contains a function ",
 StyleBox[ButtonBox["EvenQ",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/EvenQ"], "FunctionLink"],
 ", which returns true for even integers and false otherwise. The function \
below will apply only to even integers."
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"half", "[", 
   RowBox[{"x_", "?", "EvenQ"}], "]"}], ":=", 
  RowBox[{"x", "/", "2"}]}]], "Input",
 InitializationCell->True],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"half", "[", "8", "]"}]], "Input"],

Cell[BoxData["4"], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"half", "[", "9", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"half", "[", "9", "]"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "This is called a ",
 ButtonBox["PatternTest",
  BaseStyle->"Hyperlink",
  ButtonData->{
    FrontEnd`FileName[{"pacler:ref"}, "PatternTest", CharacterEncoding -> 
     "UTF-8"], None}],
 ". The blank is followed by a question mark which is followed by the name of \
a function. When the function returns true, then the argument is considered \
to match and otherwise it does not match. ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " includes several useful built-in functions, like ",
 StyleBox[ButtonBox["EvenQ",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/EvenQ"], "FunctionLink"],
 ", ",
 StyleBox[ButtonBox["OddQ",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/OddQ"], "FunctionLink"],
 ", ",
 StyleBox[ButtonBox["PrimeQ",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/PrimeQ"], "FunctionLink"],
 ", and ",
 StyleBox[ButtonBox["NumberQ",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/NumberQ"], "FunctionLink"],
 ", which matches any kind of number. You can also define your own functions \
to use as the test."
}], "Text"],

Cell[TextData[{
 "Specifying the allowable type in a function definition is useful because it \
helps to ensure that the function is never applied to invalid input, which \
may have undesirable consequences. For example, consider the functions below. \
First, we define a function ",
 StyleBox["posIntQ", "Input"],
 " that returns true only for positive integers, making use of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "\[CloseCurlyQuote]s ",
 StyleBox[ButtonBox["IntegerQ",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/IntegerQ"], "FunctionLink"],
 " and ",
 StyleBox[ButtonBox["Positive",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Positive"], "FunctionLink"],
 " functions. Then we define the function ",
 StyleBox["loopy", "Input"],
 ", which prints and then decreases its argument by 1 (using the ",
 StyleBox[ButtonBox["Decrement",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Decrement"], "FunctionLink"],
 " (",
 StyleBox["--", "Input"],
 ") operator) until it reaches 0."
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"posIntQ", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"IntegerQ", "[", "x", "]"}], "&&", 
   RowBox[{"Positive", "[", "x", "]"}]}]}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{
  RowBox[{"loopy", "[", 
   RowBox[{"n_", "?", "posIntQ"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"m", "=", "n"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"While", "[", 
     RowBox[{
      RowBox[{"m", "\[NotEqual]", "0"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", "m", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"m", "--"}]}]}], "]"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 InitializationCell->True],

Cell["\<\
Applying this function with a positive integer has the desired result.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"loopy", "[", "3", "]"}]], "Input"],

Cell[BoxData["3"], "Print"],

Cell[BoxData["2"], "Print"],

Cell[BoxData["1"], "Print"]
}, Open  ]],

Cell[TextData[{
 "If you call the function with a value that does not satisfy the ",
 StyleBox["posIntQ", "Input"],
 " function, i.e., a value not in the domain, the function is not evaluated."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"loopy", "[", 
  RowBox[{"-", "5"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"loopy", "[", 
  RowBox[{"-", "5"}], "]"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "Without the restriction that the parameter be a positive integer, applying ",
 StyleBox["loopy", "Input"],
 " to -5 would have resulted in an infinite loop."
}], "Text"],

Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " also provides a syntax for imposing conditions without the need to write \
additional functions like ",
 StyleBox["posIntQ", "Input"],
 ". A ",
 StyleBox[ButtonBox["Condition",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Condition"], "FunctionLink"],
 " (",
 StyleBox["/;", "Input"],
 ") can be used after any pattern and can make use of the named elements of \
the pattern to create a test. The syntax is to enter the pattern, followed by \
",
 StyleBox["/;", "Input"],
 " (read \[OpenCurlyDoubleQuote]provided\[CloseCurlyDoubleQuote]), followed \
by an expression that evaluates to true on valid input. In the case of a \
function definition, the ",
 StyleBox[ButtonBox["Condition",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Condition"], "FunctionLink"],
 " (",
 StyleBox["/;", "Input"],
 ") can be placed within the arguments, between the closing bracket ending \
the arguments and the ",
 StyleBox[ButtonBox["SetDelayed",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/SetDelayed"], "FunctionLink"],
 " (",
 StyleBox[":=", "Input"],
 ") operator, or at the end of the function definition. In this manual, we \
typically enter conditions immediately before the ",
 StyleBox[ButtonBox["SetDelayed",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/SetDelayed"], "FunctionLink"],
 " (",
 StyleBox[":=", "Input"],
 ") operator. "
}], "Text"],

Cell[TextData[{
 "We use this method to revise the loopy function without using the ",
 StyleBox["posIntQ", "Input"],
 " auxiliary function."
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"loopy2", "[", "n_", "]"}], "/;", 
   RowBox[{
    RowBox[{"IntegerQ", "[", "n", "]"}], "&&", 
    RowBox[{"Positive", "[", "n", "]"}]}]}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"m", "=", "n"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"While", "[", 
     RowBox[{
      RowBox[{"m", "\[NotEqual]", "0"}], ",", 
      RowBox[{
       RowBox[{"Print", "[", "m", "]"}], ";", 
       RowBox[{"m", "--"}]}]}], "]"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 InitializationCell->True],

Cell[TextData[{
 "You can provide alternative argument forms using the ",
 StyleBox[ButtonBox["Alternatives",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Alternatives"], "FunctionLink"],
 " (",
 StyleBox["|", "Input"],
 ") operator. For example, the function below accepts either a two-element \
list or a list of three elements where the third element must be a 1."
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"alternateEx", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_"}], "}"}], "|", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_", ",", "1"}], "}"}]}], "]"}], ":=", 
  RowBox[{"x", "+", "y"}]}]], "Input",
 InitializationCell->True],

Cell["\<\
This function applies when either pattern is matched, but not otherwise. Note \
that it is important that the same variable names are used in both \
alternatives.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"alternateEx", "[", 
  RowBox[{"{", 
   RowBox[{"3", ",", "2"}], "}"}], "]"}]], "Input"],

Cell[BoxData["5"], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"alternateEx", "[", 
  RowBox[{"{", 
   RowBox[{"3", ",", "2", ",", "1"}], "}"}], "]"}]], "Input"],

Cell[BoxData["5"], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"alternateEx", "[", 
  RowBox[{"{", 
   RowBox[{"3", ",", "2", ",", "7"}], "}"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"alternateEx", "[", 
  RowBox[{"{", 
   RowBox[{"3", ",", "2", ",", "7"}], "}"}], "]"}]], "Output"]
}, Open  ]],

Cell["\<\
This same effect can be created by giving multiple definitions, one for each \
argument pattern.\
\>", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"alternateEx2", "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_"}], "}"}], "]"}], ":=", 
   RowBox[{"x", "+", "y"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"alternateEx2", "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "1"}], "}"}], "]"}], ":=", 
  RowBox[{"x", "+", "y"}]}]}], "Input"],

Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " will apply whichever definition, if either, matches."
}], "Text"],

Cell[TextData[{
 "Sometimes, you may wish to give names to larger pieces of patterns. For \
this, ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " provides the name-colon-pattern syntax. For example, in the function \
below, ",
 StyleBox["p", "Input"],
 " refers to the list consisting of an integer and a string."
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"repeat", "[", 
   RowBox[{"p", ":", 
    RowBox[{"{", 
     RowBox[{"_Integer", ",", "_String"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"p", "[", 
     RowBox[{"[", "2", "]"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"p", "[", 
      RowBox[{"[", "1", "]"}], "]"}], "}"}]}], "]"}]}]], "Input",
 InitializationCell->True],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"repeat", "[", 
  RowBox[{"{", 
   RowBox[{"5", ",", "\"\<Hello\>\""}], "}"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Hello\"\>", ",", "\<\"Hello\"\>", ",", "\<\"Hello\"\>", 
   ",", "\<\"Hello\"\>", ",", "\<\"Hello\"\>"}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "While a single underscore matches a single expression, two underscores, \
called ",
 StyleBox[ButtonBox["BlankSequence",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/BlankSequence"], "FunctionLink"],
 " (",
 StyleBox["_\[ThinSpace]_", "Input"],
 "), matches a comma-separated sequence of one or more objects. If you follow \
a ",
 StyleBox[ButtonBox["BlankSequence",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/BlankSequence"], "FunctionLink"],
 " with a head or with a ",
 StyleBox["?", "Input"],
 " and function, then every element of the sequence must have the head or \
pass the test in order for the sequence to match. This provides, for example, \
a way to insist that a list have all integer members, as shown in the \
function below, which multiplies each integer by a power of 10 commensurate \
with its location in the list."
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"intshift", "[", 
   RowBox[{"L", ":", 
    RowBox[{"{", "__Integer", "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"result", "=", "0"}], ",", "i"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "\[LessEqual]", 
        RowBox[{"Length", "[", "L", "]"}]}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{"result", "=", 
        RowBox[{"result", "+", 
         RowBox[{
          RowBox[{"L", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "*", 
          RowBox[{"10", "^", 
           RowBox[{"(", 
            RowBox[{"i", "-", "1"}], ")"}]}]}]}]}]}], "\[IndentingNewLine]", 
      "]"}], ";", "\[IndentingNewLine]", "result"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 InitializationCell->True],

Cell["\<\
The result of this function is clearest to see when applied to individual \
digits.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"intshift", "[", 
  RowBox[{"{", 
   RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}], "]"}]], "Input"],

Cell[BoxData["4321"], "Output"]
}, Open  ]],

Cell["\<\
But if any element of the list is not an integer, it will not be applied.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"intshift", "[", 
  RowBox[{"{", 
   RowBox[{"2", ",", "7", ",", "1", ",", "3.4"}], "}"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"intshift", "[", 
  RowBox[{"{", 
   RowBox[{"2", ",", "7", ",", "1", ",", "3.4`"}], "}"}], "]"}]], "Output"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Pure Functions", "Subsection",
 CellTags->"Section3b"],

Cell[TextData[{
 "A pure ",
 StyleBox[ButtonBox["Function",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Function"], "FunctionLink"],
 " (",
 StyleBox["&", "Input"],
 ") in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " is a way to define a simple function and is typically used when you have a \
function that you will only use once or when you want to define the function \
within the body of another function."
}], "Text"],

Cell[TextData[{
 "The typical syntax for a pure function is to enter the function body \
followed by an ampersand (",
 StyleBox["&", "Input"],
 "). When the function accepts a single argument, the pound (",
 StyleBox["#", "Input"],
 ") symbol (called a ",
 StyleBox[ButtonBox["Slot",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Slot"], "Input"],
 ") is used as the name of the argument. For example, the following is the \
pure function for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "\[Rule]", 
    RowBox[{
     SuperscriptBox["x", "2"], "+", "1"}]}], TraditionalForm]]],
 "."
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"#", "^", "2"}], "+", "1"}], "&"}]], "myCode",
 Evaluatable->False,
 InitializationCell->False],

Cell[TextData[{
 "There are two main applications for a pure function. First, you can pass it \
a value for its argument by following the ampersand with the argument \
enclosed in brackets. The following computes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["3", "2"], "+", "1"}], TraditionalForm]]],
 "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"#", "^", "2"}], "+", "1"}], "&"}], "[", "3", "]"}]], "Input"],

Cell[BoxData["10"], "Output"]
}, Open  ]],

Cell[TextData[{
 "More usefully, you can use a pure function any place you would normally \
give the name of a function. For example, recall the discussion of ",
 StyleBox[ButtonBox["Map",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Map"], "FunctionLink"],
 " (",
 StyleBox["/@", "Input"],
 ") in Section 1.1 of this manual. Given a function and a list, ",
 StyleBox[ButtonBox["Map",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Map"], "FunctionLink"],
 " applies the function to each element of the list. The following computes \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "2"], "+", "1"}], TraditionalForm]]],
 " for each member of the given list."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Map", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"#", "^", "2"}], "+", "1"}], "&"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3", ",", "5", ",", "7", ",", "11", ",", "13"}], 
    "}"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"5", ",", "10", ",", "26", ",", "50", ",", "122", ",", "170"}], 
  "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "The following is identical, but using the ",
 StyleBox["/@", "Input"],
 " operator syntax."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"#", "^", "2"}], "+", "1"}], "&"}], "/@", 
  RowBox[{"{", 
   RowBox[{"2", ",", "3", ",", "5", ",", "7", ",", "11", ",", "13"}], 
   "}"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"5", ",", "10", ",", "26", ",", "50", ",", "122", ",", "170"}], 
  "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "If you need more than one argument, you can follow the ampersand by an \
index starting at 1: ",
 StyleBox["#1", "Input"],
 " for the first argument, ",
 StyleBox["#2", "Input"],
 " for the second, etc. The following expression uses ",
 StyleBox[ButtonBox["MapThread",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/MapThread"], "FunctionLink"],
 " to compute ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "2"], "+", 
    SuperscriptBox["y", "3"]}], TraditionalForm]]],
 " with values of ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]]],
 " coming from the two lists."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MapThread", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"#1", "^", "2"}], "+", 
     RowBox[{"#2", "^", "3"}]}], "&"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "4", ",", "6", ",", "8"}], "}"}]}], "}"}]}], 
  "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"9", ",", "68", ",", "225", ",", "528"}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "You can, if you wish, name pure functions, using ",
 StyleBox[ButtonBox["Set",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Set"], "FunctionLink"],
 " (",
 StyleBox["=", "Input"],
 ") just like you assign values to variables. Once the name is assigned, you \
evaluate the function as usual."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"pureExample", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"#1", "^", "2"}], "+", 
    RowBox[{"#1", "*", "#2"}], "+", 
    RowBox[{"#2", "^", "2"}]}], "&"}]}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SuperscriptBox["#1", "2"], "+", 
   RowBox[{"#1", " ", "#2"}], "+", 
   SuperscriptBox["#2", "2"]}], "&"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"pureExample", "[", 
  RowBox[{"2", ",", "3"}], "]"}]], "Input"],

Cell[BoxData["19"], "Output"]
}, Open  ]],

Cell["\<\
Also note that applying the pure function to symbols produces an expression \
for the function in terms of the given symbols.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"pureExample", "[", 
  RowBox[{"s", ",", "t"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["s", "2"], "+", 
  RowBox[{"s", " ", "t"}], "+", 
  SuperscriptBox["t", "2"]}]], "Output"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " also provides a functional syntax for defining pure functions with ",
 StyleBox[ButtonBox["Function",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Function"], "FunctionLink"],
 ". This syntax has more flexibility, but is used less frequently, so we will \
not discuss it here."
}], "Text"],

Cell[CellGroupData[{

Cell["Composition of Functions", "Subsubsection"],

Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "\[CloseCurlyQuote]s support for algebraic combination of functions is not \
as natural as you might hope, but pure functions provide a useful way to make \
exploring these ideas fairly easy. "
}], "Text"],

Cell[TextData[{
 "Consider two functions, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "x", ")"}], "=", 
    RowBox[{
     SuperscriptBox["x", "2"], "+", "1"}]}], TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", "(", "x", ")"}], "=", 
    SuperscriptBox["x", "3"]}], TraditionalForm]]],
 ". We define these two functions in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ", ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]]],
 " defined in the usual way and ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]]],
 " as a pure function."
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"x", "^", "2"}], "+", "1"}]}]], "Input",
 InitializationCell->True],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"g", "=", 
  RowBox[{
   RowBox[{"#", "^", "3"}], "&"}]}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["#1", "3"], "&"}]], "Output"]
}, Open  ]],

Cell["\<\
Note that you use exactly the same syntax to apply them to values.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"f", "[", "2", "]"}]], "Input"],

Cell[BoxData["5"], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"g", "[", "5", "]"}]], "Input"],

Cell[BoxData["125"], "Output"]
}, Open  ]],

Cell[TextData[{
 "To create a function that is the algebraic combination of these two, say ",
 Cell[BoxData[
  FormBox[
   RowBox[{"h", "=", 
    RowBox[{"f", "/", "g"}]}], TraditionalForm]]],
 ", we can define the combined function as a pure function obtained by \
evaluating ",
 StyleBox["f", "Input"],
 " and ",
 StyleBox["g", "Input"],
 " on the argument ",
 StyleBox["#", "Input"],
 "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"h", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", "#", "]"}], "/", 
    RowBox[{"g", "[", "#", "]"}]}], "&"}]}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{
  FractionBox[
   RowBox[{"f", "[", "#1", "]"}], 
   RowBox[{"g", "[", "#1", "]"}]], "&"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "Now we can evaluate ",
 StyleBox["h", "Input"],
 " at values or obtain a formula."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"h", "[", "3", "]"}]], "Input"],

Cell[BoxData[
 FractionBox["10", "27"]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"h", "[", "t", "]"}]], "Input"],

Cell[BoxData[
 FractionBox[
  RowBox[{"1", "+", 
   SuperscriptBox["t", "2"]}], 
  SuperscriptBox["t", "3"]]], "Output"]
}, Open  ]],

Cell[TextData[{
 "For composition of functions, ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " provides the ",
 StyleBox[ButtonBox["Composition",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Composition"], "FunctionLink"],
 " function. The following defines ",
 StyleBox["h1", "Input"],
 " to be ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "\[SmallCircle]", "g"}], TraditionalForm]]],
 " and ",
 StyleBox["h2", "Input"],
 " to be ",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", "\[SmallCircle]", "h"}], TraditionalForm]]],
 " and applies them both to the symbol ",
 StyleBox["t", "Input"],
 " to obtain formulas."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"h1", "=", 
   RowBox[{"Composition", "[", 
    RowBox[{"f", ",", "g"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"h1", "[", "t", "]"}]}], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{"1", "+", 
  SuperscriptBox["t", "6"]}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"h2", "=", 
   RowBox[{"Composition", "[", 
    RowBox[{"g", ",", "f"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"h2", "[", "t", "]"}]}], "Input",
 InitializationCell->True],

Cell[BoxData[
 SuperscriptBox[
  RowBox[{"(", 
   RowBox[{"1", "+", 
    SuperscriptBox["t", "2"]}], ")"}], "3"]], "Output"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "Note that the arguments of ",
 StyleBox[ButtonBox["Composition",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Composition"], "FunctionLink"],
 " can be pure functions."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Composition", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"#", "^", "2"}], "&"}], ",", 
    RowBox[{
     RowBox[{"#", "+", "3"}], "&"}]}], "]"}], "[", "x", "]"}]], "Input"],

Cell[BoxData[
 SuperscriptBox[
  RowBox[{"(", 
   RowBox[{"3", "+", "x"}], ")"}], "2"]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Plotting Graphs of Functions", "Subsubsection"],

Cell[TextData[{
 "You can have ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " draw the graph of a function by using the ",
 StyleBox[ButtonBox["Plot",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Plot"], "FunctionLink"],
 " function. The function requires two arguments: the first is the function \
to be graphed in terms of a variable, and the second is a list containing the \
variable and the minimum and maximum values of the domain of the variable. \
Typically, you provide the function as an algebraic expression as in the \
example below, which graphs ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "2"], "-", "x", "+", "2"}], TraditionalForm]]],
 " from ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "5"}], TraditionalForm]]],
 " to ",
 Cell[BoxData[
  FormBox["5", TraditionalForm]]],
 "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"x", "^", "2"}], "-", "x", "+", "2"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "5"}], ",", "5"}], "}"}]}], "]"}]], "Input"],

Cell[BoxData[
 GraphicsBox[{{}, {}, 
   {Hue[0.67, 0.6, 0.6], LineBox[CompressedData["
1:eJwtmHk01N//x2ds2bKNZURkqSyRMPZ63ZKlhaRIFCX5lESW7PTxISKtStlK
di0qylZ5TyEhkuzr2LfSGGt5z8x3fuf8/rrnce6957xer+fzvM7rXiV3X/uz
