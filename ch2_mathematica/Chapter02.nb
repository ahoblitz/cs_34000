           Scaled[0.999]}}, "ColumnsIndexed" -> {}, "Rows" -> {{1.}}, 
        "RowsIndexed" -> {}}]}
   },
   BaselinePosition->{Baseline, {1, 1}},
   GridBoxAlignment->{
    "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, "Rows" -> {{Baseline}}, 
     "RowsIndexed" -> {}}],
  Definition[$CellContext`fib2],
  Editable->False]], "Print",
 CellTags->"Info3580371083-5514480"]
}, Open  ]],

Cell["\<\
To illustrate the difference in performance, let\[CloseCurlyQuote]s see how \
long it takes to compute the 100th Fibonacci number.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Timing", "[", 
  RowBox[{"fib2", "[", "100", "]"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "0.00041699999999999999870589628692130191`2.6407359682533813", ",", 
   "218922995834555169026"}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "Note that if we repeat the computation using ",
 StyleBox["fib2", "Input"],
 ":"
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Timing", "[", 
  RowBox[{"fib2", "[", "100", "]"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "6.00000000000000015200514458246772`0.7987511636632681*^-6", ",", 
   "218922995834555169026"}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "The total time take drops dramatically. This is because ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " doesn\[CloseCurlyQuote]t need to compute the value again, it just looks it \
up."
}], "Text"],

Cell[TextData[{
 "In comparison, consider the ",
 StyleBox["fib", "Input"],
 " function applied to 30."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Timing", "[", 
  RowBox[{"fib", "[", "30", "]"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "1.35853700000000010561507224338129162788`6.15367138428308", ",", 
   "514229"}], "}"}]], "Output"]
}, Open  ]],

Cell["\<\
By storing the results of computations in a recursively generated sequence, \
we can get higher terms much more quickly.\
\>", "Text"],

Cell[TextData[{
 "Note that attempting to call ",
 StyleBox["fib2", "Input"],
 " with larger values, such as 1000, will raise an error, specifically:"
}], "Text"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"$RecursionLimit", "::", "reclim"}], "MessageName"], ":", 
  " ", "\<\"Recursion depth of \[NoBreak]\\!\\(256\\)\[NoBreak] exceeded. \\!\
\\(\\*ButtonBox[\\\"\[RightSkeleton]\\\", ButtonStyle->\\\"Link\\\", \
ButtonFrame->None, \
ButtonData:>\\\"paclet:ref/message/$RecursionLimit/reclim\\\", ButtonNote -> \
\\\"$RecursionLimit::reclim\\\"]\\)\"\>"}]], "Message", "MSG"],

Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " puts a limit on how far down a recursive definition it will go. This is to \
prevent ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " from crashing your computer by trying to exceed the machine\
\[CloseCurlyQuote]s stack space. To get around this, you can temporarily \
override the default recursion limit as in the following."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"$RecursionLimit", "=", "1000"}], "}"}], ",", 
   RowBox[{"fib2", "[", "1000", "]"}]}], "]"}]], "Input",
 Evaluatable->False],

Cell[BoxData[\
"26863810024485359386146727202142923967616609318986952340123175997617981700247\
881689338369654483356564191827856161443356312976673642210350324634850410377680\
367334151172899169723197082763985615764450078474174626"], "Output"]
}, Open  ]],

Cell[TextData[{
 "The ",
 StyleBox[ButtonBox["Block",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Block"], "FunctionLink"],
 " is similar to ",
 StyleBox[ButtonBox["Module",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Module"], "FunctionLink"],
 ", in that it defines a scope and the first argument declares the variables \
local to that scope. In the above, ",
 StyleBox[ButtonBox["Block",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Block"], "FunctionLink"],
 " is used to ensure that the change to the recursion limit is only \
temporary. The built-in recursion limit is there for a reason, and overriding \
it is inherently dangerous. If you were to change it permanently and then \
unwittingly execute an expression that caused a large recursive descent, you \
could crash your ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " session and lose your work. "
}], "Text"],

Cell[TextData[{
 "Note that the purely recursive implementation ",
 StyleBox["fib", "Input"],
 " cannot be used to compute the thousandth Fibonacci number. In fact, to \
compute the thousandth Fibonacci number, ",
 StyleBox["fib", "Input"],
 " would need to be invoked approximately"
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"fib2", "[", "999", "]"}]], "Input",
 Evaluatable->False],

Cell[BoxData[\
"16602747662452097049541800472897701834948051198384828062358553091918573717701\
170201065510185595898605104094736918879278462233015981029522997836311232618760\
539199036765399799926731433239718860373345088375054249"], "Output"]
}, Open  ]],

Cell["\<\
times in order to handle all the recursive sub-calls that are made. (The \
reader is encouraged to prove this fact.)\
\>", "Text"],

Cell["Even at a billion calls per second, this would require", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"fib2", "[", "999", "]"}], "/", "1000000000."}]], "Input",
 Evaluatable->False],

Cell[BoxData["1.6602747662452098`*^199"], "Output"]
}, Open  ]],

Cell["seconds, or", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"fib2", "[", "999", "]"}], "/", 
  RowBox[{"(", 
   RowBox[{"1000000000.", "*", "60", "*", "60", "*", "24", "*", "365"}], 
   ")"}]}]], "Input",
 Evaluatable->False],

Cell[BoxData["5.2646967473528974`*^191"], "Output"]
}, Open  ]],

Cell["years to complete.", "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["Summations", "Subsection",
 CellTags->"Section4e"],

Cell[TextData[{
 "Finally, we will see how ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " can be used to compute with summations, both numerically for finite sums \
and symbolically for infinite sums."
}], "Text"],

Cell[TextData[{
 "To add a finite list of values, we use the ",
 StyleBox[ButtonBox["Total",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Total"], "FunctionLink"],
 " function. Applied to a list, ",
 StyleBox[ButtonBox["Total",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Total"], "FunctionLink"],
 " returns the sum."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Total", "[", 
  RowBox[{"{", 
   RowBox[{
   "1", ",", "2", ",", "4", ",", "6", ",", "9", ",", "11", ",", "14"}], "}"}],
   "]"}]], "Input"],

Cell[BoxData["47"], "Output"]
}, Open  ]],

Cell[TextData[{
 "The argument to ",
 StyleBox[ButtonBox["Total",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Total"], "FunctionLink"],
 " can be a function that returns a list. For example, the following computes \
the sum of the integers from 1 to 100."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Total", "[", 
  RowBox[{"Range", "[", "100", "]"}], "]"}]], "Input"],

Cell[BoxData["5050"], "Output"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " also provides the function ",
 StyleBox[ButtonBox["Sum",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Sum"], "FunctionLink"],
 ", which can be used in place of composing ",
 StyleBox[ButtonBox["Total",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Total"], "FunctionLink"],
 " and ",
 StyleBox[ButtonBox["Table",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Table"], "FunctionLink"],
 ". ",
 StyleBox[ButtonBox["Sum",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Sum"], "FunctionLink"],
 " accepts arguments in the same form as ",
 StyleBox[ButtonBox["Table",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Table"], "FunctionLink"],
 ", but instead of producing the list, it provides you with the sum of the \
sequence."
}], "Text"],

Cell[TextData[{
 "The first argument to ",
 StyleBox[ButtonBox["Sum",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Sum"], "FunctionLink"],
 " should be an expression involving a variable (the index of summation). The \
second argument is generally a list, whose first element is the index of \
summation (e.g., ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]]],
 ") and whose other arguments specify the values that the index takes on, as \
detailed in the table below."
}], "Text"],

Cell[TextData[Cell[BoxData[GridBox[{
   {Cell[BoxData[
     RowBox[{"{", 
      StyleBox["i", "CodeVar"], ",", 
      StyleBox[
       SubscriptBox["i", "max"], "CodeVar"], "}"}]], "myCode"], Cell[TextData[{
     "sum from ",
     Cell[BoxData[
      FormBox[
       RowBox[{"i", "=", "1"}], TraditionalForm]]],
     " to ",
     Cell[BoxData[
      FormBox[
       SubscriptBox["i", "max"], TraditionalForm]]]
    }]]},
   {Cell[BoxData[
     RowBox[{"{", 
      StyleBox["i", "CodeVar"], ",", 
      StyleBox[
       SubscriptBox["i", "min"], "CodeVar"], ",", 
      StyleBox[
       SubscriptBox["i", "max"], "CodeVar"], "}"}]], "myCode"], 
    RowBox[{"sum", " ", "from", " ", Cell[TextData[{
      Cell[BoxData[
       FormBox[
        RowBox[{"i", "=", 
         SubscriptBox["i", "min"]}], TraditionalForm]]],
      " to ",
      Cell[BoxData[
       FormBox[
        SubscriptBox["i", "max"], TraditionalForm]]]
     }]]}]},
   {Cell[BoxData[
     RowBox[{"{", 
      StyleBox["i", "CodeVar"], ",", 
      StyleBox[
       SubscriptBox["i", "min"], "CodeVar"], ",", 
      StyleBox[
       SubscriptBox["i", "max"], "CodeVar"], ",", 
      StyleBox["step", "CodeVar"], "}"}]], "myCode"], 
    RowBox[{"sum", " ", "from", " ", Cell[TextData[{
      Cell[BoxData[
       FormBox[
        RowBox[{"i", "=", 
         SubscriptBox["i", "min"]}], TraditionalForm]]],
      " to ",
      Cell[BoxData[
       FormBox[
        SubscriptBox["i", "max"], TraditionalForm]]],
      " by ",
      Cell[BoxData[
       FormBox["step", TraditionalForm]]]
     }]]}]},
   {Cell[BoxData[
     RowBox[{"{", 
      StyleBox["i", "CodeVar"], ",", 
      StyleBox["list", "CodeVar"], "}"}]], "myCode"], 
    RowBox[{
    "sum", " ", "over", " ", Cell["i\[Element]list"], Cell[TextData[StyleBox[
     "", "Input"]]]}]}
  },
  GridBoxDividers->{
   "Columns" -> {{True}}, "ColumnsIndexed" -> {}, "Rows" -> {{True}}, 
    "RowsIndexed" -> {}}]],
 FontFamily->"Times"]], "Text",
 TextAlignment->Center],

Cell[TextData[{
 "For example, to compute the sum of the squares of the first ten positive \
integers, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{" ", 
      RowBox[{"i", "=", "1"}]}], 
     RowBox[{" ", "10"}]], 
    SuperscriptBox["i", "2"]}], TraditionalForm]]],
 ", we enter the following."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Sum", "[", 
  RowBox[{
   RowBox[{"i", "^", "2"}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "10"}], "}"}]}], "]"}]], "Input"],

Cell[BoxData["385"], "Output"]
}, Open  ]],

Cell[TextData[{
 "And to compute the sum ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{" ", 
      RowBox[{"i", "=", "10"}]}], 
     RowBox[{" ", "30"}]], 
    FractionBox["1", "i"]}], TraditionalForm]]],
 ", you enter:"
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Sum", "[", 
  RowBox[{
   RowBox[{"1", "/", "i"}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "10", ",", "30"}], "}"}]}], "]"}]], "Input"],

Cell[BoxData[
 FractionBox["2715762396337", "2329089562800"]], "Output"]
}, Open  ]],

Cell[TextData[{
 "Note that nested sums can be computed simply by providing additional \
specifications for the index of summation, just as is done with ",
 StyleBox[ButtonBox["Table",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Table"], "FunctionLink"],
 ". Also note that there is a similar command for products, with identical \
syntax, called ",
 StyleBox[ButtonBox["Product",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Product"], "FunctionLink"],
 "."
}], "Text"],

Cell[TextData[{
 "The ",
 StyleBox[ButtonBox["Sum",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Sum"], "FunctionLink"],
 " function can also be used for symbolic sums. For example, to compute the \
sum of the squares of the integers from 1 to ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 ", i.e., ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{" ", 
      RowBox[{"i", "=", "1"}]}], 
     RowBox[{" ", "n"}]], 
    SuperscriptBox["i", "2"]}], TraditionalForm]]],
 ", you simply give the maximum for the index of summation as ",
 StyleBox["n", "Input"],
 ", provided the symbol ",
 StyleBox["n", "Input"],
 " has not been assigned a value."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Sum", "[", 
  RowBox[{
   RowBox[{"i", "^", "2"}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "n"}], "}"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "6"], " ", "n", " ", 
  RowBox[{"(", 
   RowBox[{"1", "+", "n"}], ")"}], " ", 
  RowBox[{"(", 
   RowBox[{"1", "+", 
    RowBox[{"2", " ", "n"}]}], ")"}]}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "We also compute the sum of every other term from 0 to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "n"}], TraditionalForm]]],
 " in the general geometric series."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Sum", "[", 
  RowBox[{
   RowBox[{"a", "*", 
    RowBox[{"r", "^", "i"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "0", ",", 
     RowBox[{"2", "n"}], ",", "2"}], "}"}]}], "]"}]], "Input"],

Cell[BoxData[
 FractionBox[
  RowBox[{"a", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", 
     SuperscriptBox["r", 
      RowBox[{"2", "+", 
       RowBox[{"2", " ", 
        RowBox[{"Floor", "[", "n", "]"}]}]}]]}], ")"}]}], 
  RowBox[{
   RowBox[{"-", "1"}], "+", 
   SuperscriptBox["r", "2"]}]]], "Output"]
}, Open  ]],

Cell[TextData[{
 "You are also allowed to use the symbol ",
 StyleBox[ButtonBox["Infinity",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Infinity"], "FunctionLink"],
 " to compute infinite sums. The following computes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{" ", 
      RowBox[{"i", "=", "1"}]}], 
     RowBox[{" ", "\[Infinity]"}]], 
    SuperscriptBox["ix", 
     RowBox[{"i", "-", "1"}]]}], TraditionalForm]]],
 "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Sum", "[", 
  RowBox[{
   RowBox[{"i", "*", 
    RowBox[{"x", "^", 
     RowBox[{"(", 
      RowBox[{"i", "-", "1"}], ")"}]}]}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "Infinity"}], "}"}]}], "]"}]], "Input"],

Cell[BoxData[
 FractionBox["1", 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", "x"}], ")"}], "2"]]], "Output"]
}, Open  ]],

Cell["\<\
You can confirm that these results match the formulas given in Table 2 of \
Section 2.4.\
\>", "Text"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["2.5 Cardinality of Sets", "Section",
 PageBreakWithin->False,
 CellTags->"Section5"],

Cell[TextData[{
 "In this section we will explore the countability of the positive rational \
numbers. In Example 4 of Section 2.5 of the text, it is shown that the \
positive rationals are countable by describing how to list them all. Here, we \
will use ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " to implement this listing algorithm. We will also consider the following \
two questions. First, given a positive rational number, what is its position \
in the list? Second, given a positive integer, what fraction is located at \
that position within the list?"
}], "Text",
 PageBreakAbove->False,
 PageBreakWithin->False],

Cell[TextData[{
 "We begin by reviewing the description in Example 4. The first element of \
the list is the rational number ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "1"], TraditionalForm]]],
 ". Then we list the positive rationals ",
 Cell[BoxData[
  FormBox[
   FractionBox["p", "q"], TraditionalForm]]],
 " such that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"p", "+", "q"}], "=", "3"}], TraditionalForm]]],
 ". Then come the rationals with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"p", "+", "q"}], "=", "4"}], TraditionalForm]]],
 ", excluding ",
 Cell[BoxData[
  FormBox[
   FractionBox["2", "2"], TraditionalForm]]],
 ", which is already in the list, being equivalent to ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "1"], TraditionalForm]]],
 ". This continues for each ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 ": we list the fractions ",
 Cell[BoxData[
  FormBox[
   FractionBox["p", "q"], TraditionalForm]]],
 " such that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"p", "+", "q"}], "=", "n"}], TraditionalForm]]],
 ", excluding those equivalent to fractions already in the list."
}], "Text"],

Cell[TextData[{
 "In our function, we refer to ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " as the stage, so that in stage 5, for example, we\[CloseCurlyQuote]re \
listing the fractions ",
 Cell[BoxData[
  FormBox[
   FractionBox["p", "q"], TraditionalForm]]],
 " such that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"p", "+", "q"}], "=", "5"}], TraditionalForm]]],
 ". The stage ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " will range from ",
 Cell[BoxData[
  FormBox["2", TraditionalForm]]],
 " up to some maximum value. This maximum value of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " will be the parameter to the function. We\[CloseCurlyQuote]ll implement \
this as a loop with index variable ",
 StyleBox["n", "Input"],
 "."
}], "Text"],

Cell[TextData[{
 "Within each stage, i.e., within the loop, we need to generate the rational \
numbers ",
 Cell[BoxData[
  FormBox[
   FractionBox["p", "q"], TraditionalForm]]],
 " and add them to the list, provided they are not already in it. We can \
rewrite ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"p", "+", "q"}], "=", "n"}], TraditionalForm]]],
 " as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "=", 
    RowBox[{"n", "-", "q"}]}], TraditionalForm]]],
 ". By allowing ",
 Cell[BoxData[
  FormBox["q", TraditionalForm]]],
 " to range from ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]]],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "-", "1"}], TraditionalForm]]],
 " and calculating ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]]],
 ", we will produce all the potential rationals in stage ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 ". The ",
 StyleBox[ButtonBox["FreeQ",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/FreeQ"], "FunctionLink"],
 " function, which has the same syntax but opposite meaning of the ",
 StyleBox[ButtonBox["MemberQ",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/MemberQ"], "FunctionLink"],
 " function discussed in Section 2.1 in relation to sets, will be used to \
avoid duplicates. So, for each ",
 Cell[BoxData[
  FormBox["q", TraditionalForm]]],
 " from ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]]],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "-", "1"}], TraditionalForm]]],
 ", we will form the fraction ",
 Cell[BoxData[
  FormBox[
   FractionBox["p", "q"], TraditionalForm]]],
 " (with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "=", 
    RowBox[{"n", "-", "q"}]}], TraditionalForm]]],
 "), use ",
 StyleBox[ButtonBox["FreeQ",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/FreeQ"], "FunctionLink"],
 " to test whether this is already in our list of positive rationals, and, if \
not, add it to the list using ",
 StyleBox[ButtonBox["AppendTo",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/AppendTo"], "FunctionLink"],
 "."
}], "Text"],

Cell["Here is the complete function.", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"listRationals", "[", "max_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"L", "=", 
       RowBox[{"{", "}"}]}], ",", "n", ",", "p", ",", "q"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"n", "=", "2"}], ",", 
       RowBox[{"n", "\[LessEqual]", "max"}], ",", 
       RowBox[{"n", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"q", "=", "1"}], ",", 
         RowBox[{"q", "\[LessEqual]", 
          RowBox[{"n", "-", "1"}]}], ",", 
         RowBox[{"q", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"p", "=", 
           RowBox[{"n", "-", "q"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"FreeQ", "[", 
             RowBox[{"L", ",", 
              RowBox[{"p", "/", "q"}]}], "]"}], ",", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"L", ",", 
              RowBox[{"p", "/", "q"}]}], "]"}]}], "]"}]}]}], 
        "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}], ";", 
     "\[IndentingNewLine]", "L"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",\

 InitializationCell->True],

Cell[TextData[{
 "Applying this function with argument ",
 Cell[BoxData[
  FormBox["6", TraditionalForm]]],
 ", we obtain the list of rationals through stage ",
 Cell[BoxData[
  FormBox["6", TraditionalForm]]],
 "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"listRationals", "[", "6", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", 
   FractionBox["1", "2"], ",", "3", ",", 
   FractionBox["1", "3"], ",", "4", ",", 
   FractionBox["3", "2"], ",", 
   FractionBox["2", "3"], ",", 
   FractionBox["1", "4"], ",", "5", ",", 
   FractionBox["1", "5"]}], "}"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Finding the Position Given a Positive Rational", "Subsection",
 CellTags->"Section5a"],

Cell[TextData[{
 "Suppose we want to determine the position of a particular fraction within \
the list. Take for example ",
 Cell[BoxData[
  FormBox[
   FractionBox["29", "35"], TraditionalForm]]],
 ". Since ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"29", "+", "35"}], "=", "64"}], TraditionalForm]]],
 ", we know that this fraction would first appear in stage 64. So we compute \
the list up to stage 64."
}], "Text",
 PageBreakAbove->False,
 PageBreakWithin->False],

Cell[BoxData[
 RowBox[{
  RowBox[{"ratsTo64", "=", 
   RowBox[{"listRationals", "[", "64", "]"}]}], ";"}]], "Input",
 InitializationCell->True],

Cell["We suppress the output because this is a long list:", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Length", "[", "ratsTo64", "]"}]], "Input"],

Cell[BoxData["1259"], "Output"]
}, Open  ]],

Cell[TextData[{
 "Now we work backwards from the end of the list until we find the desired \
fraction. A simple loop will help with this. Recall that the third argument \
to ",
 StyleBox[ButtonBox["For",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/For"], "FunctionLink"],
 " allows us to specify how the index variable is changed each time. Using \
the decrement operator (",
 StyleBox["--", "Input"],
 ") causes the loop to step backwards by 1 each iteration. Once we find the \
location of the desired fraction, we want the loop to end and output the \
location of the fraction. We do this using a ",
 StyleBox[ButtonBox["Throw",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Throw"], "FunctionLink"],
 " and wrapping the entire loop in a ",
 StyleBox[ButtonBox["Catch",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Catch"], "FunctionLink"],
 "."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Catch", "[", "\[IndentingNewLine]", 
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"i", "=", "1259"}], ",", 
    RowBox[{"i", "\[GreaterEqual]", "1"}], ",", 
    RowBox[{"i", "--"}], ",", "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"ratsTo64", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "\[Equal]", 
       RowBox[{"29", "/", "35"}]}], ",", 
      RowBox[{"Throw", "[", "i", "]"}]}], "]"}]}], "\[IndentingNewLine]", 
   "]"}], "\[IndentingNewLine]", "]"}]], "Input"],

Cell[BoxData["1245"], "Output"]
}, Open  ]],

Cell[TextData[{
 "We can make this process into a function. Given a fraction, the ",
 StyleBox[ButtonBox["Numerator",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Numerator"], "FunctionLink"],
 " and ",
 StyleBox[ButtonBox["Denominator",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Denominator"], "FunctionLink"],
 " commands will extract the numerator and denominator, respectively."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Numerator", "[", 
  RowBox[{"29", "/", "35"}], "]"}]], "Input"],

Cell[BoxData["29"], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Denominator", "[", 
  RowBox[{"29", "/", "35"}], "]"}]], "Input"],

Cell[BoxData["35"], "Output"]
}, Open  ]],

Cell[TextData[{
 "Our function will accept a rational number as its argument. For the sake of \
robustness, we will ensure that the input is rational by insisting that the \
argument has head ",
 StyleBox["Rational", "Input"],
 ", and we will also check that it is positive using a ",
 StyleBox[ButtonBox["Condition",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Condition"], "FunctionLink"],
 " (",
 StyleBox["/;", "Input"],
 ")."
}], "Text"],

Cell[TextData[{
 "After confirming that the input is positive, we\[CloseCurlyQuote]ll sum the \
results of ",
 StyleBox[ButtonBox["Numerator",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Numerator"], "FunctionLink"],
 " and ",
 StyleBox[ButtonBox["Denominator",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Denominator"], "FunctionLink"],
 " to determine the stage. "
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"locateRational", "[", "r_Rational", "]"}], "/;", 
   RowBox[{"r", ">", "0"}]}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"stage", ",", "L", ",", "i"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"stage", "=", 
      RowBox[{
       RowBox[{"Numerator", "[", "r", "]"}], "+", 
       RowBox[{"Denominator", "[", "r", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"L", "=", 
      RowBox[{"listRationals", "[", "stage", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Catch", "[", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", 
         RowBox[{"Length", "[", "L", "]"}]}], ",", 
        RowBox[{"i", "\[GreaterEqual]", "1"}], ",", 
        RowBox[{"i", "--"}], ",", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"L", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "\[Equal]", "r"}], ",", 
          RowBox[{"Throw", "[", "i", "]"}]}], "]"}]}], "\[IndentingNewLine]", 
       "]"}], "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 InitializationCell->True],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"locateRational", "[", 
  RowBox[{"75", "/", "197"}], "]"}]], "Input"],

Cell[BoxData["22566"], "Output"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Finding the Rational in a Given Position", "Subsection",
 CellTags->"Section5b"],

Cell["\<\
On the other hand, suppose we want to know which fraction is at a particular \
position. For instance, say we want to know which is the hundredth fraction \
listed. If we knew which stage of the process would yield a list of at least \
100 rational numbers, we could just generate the list up to that stage. We \
can guess and check until we find a stage that produced a long enough list.\
\>", "Text"],

Cell[CellGroupData[{

Cell["Putting a Lower Bound on the Number of Stages", "Subsubsection"],

Cell[TextData[{
 "We can guide our guesses a bit, however. Remember that at stage 2, the \
process generates 1 fraction. At stage 3, it generates 2 fractions. At stage \
4, it generates 3 fractions, although one of them is discarded because it is \
a repeat. At stage ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 ", the process generates ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "-", "1"}], TraditionalForm]]],
 " rational numbers, some of which may be discarded as repeats. So we know \
that, after stage ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " is complete, the number of rational numbers in our list contains ",
 StyleBox["at most",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{" ", 
       RowBox[{"k", "=", "2"}]}], 
      RowBox[{" ", "n"}]], "k"}], "-", "1"}], TraditionalForm]]],
 " rational numbers. We can use the ",
 StyleBox[ButtonBox["Sum",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Sum"], "FunctionLink"],
 " function described in the previous section to find a formula for this \
summation."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Sum", "[", 
  RowBox[{
   RowBox[{"k", "-", "1"}], ",", 
   RowBox[{"{", 
    RowBox[{"k", ",", "2", ",", "n"}], "}"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "2"], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "n"}], "+", 
    SuperscriptBox["n", "2"]}], ")"}]}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "In other words, the number of rational numbers in the list produced by ",
 StyleBox["listRationals", "Input"],
 " at the conclusion of stage ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " is at most ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     SuperscriptBox["n", "2"], "-", "n"}], "2"], TraditionalForm]]],
 ". Define ",
 Cell[BoxData[
  FormBox[
   RowBox[{"F", "(", "n", ")"}], TraditionalForm]]],
 " to be the number of positive rational numbers produced by the ",
 StyleBox["listRationals", "Input"],
 " algorithm at the conclusion of stage ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 ". Equivalently, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"F", "(", "n", ")"}], TraditionalForm]]],
 " is the number of distinct positive rational numbers ",
 Cell[BoxData[
  FormBox[
   FractionBox["p", "q"], TraditionalForm]]],
 " such that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"p", "+", "q"}], "\[LessEqual]", "n"}], TraditionalForm]]],
 ". We have determined that"
}], "Text"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"F", "(", "n", ")"}], "\[LessEqual]", 
   FractionBox[
    RowBox[{
     SuperscriptBox["n", "2"], "-", "n"}], "2"]}], 
  TraditionalForm]], "Equation"],

Cell[TextData[{
 "Now we return to the question of how many stages we need to compute in \
order to find the 100th rational number. We can restate this as follows: find \
",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " such that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"F", "(", "n", ")"}], "\[GreaterEqual]", "100"}], 
   TraditionalForm]]],
 ". Combining our inequalities, we have that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{
      SuperscriptBox["n", "2"], "-", "n"}], "2"], "\[GreaterEqual]", "100"}], 
   TraditionalForm]]],
 ". ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "\[CloseCurlyQuote]s ",
 StyleBox[ButtonBox["Reduce",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Reduce"], "FunctionLink"],
 " command will solve the equation for us. The ",
 StyleBox[ButtonBox["Reduce",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Reduce"], "FunctionLink"],
 " function requires two arguments: the expression to be simplified and the \
variable. (Note that since an approximation is sufficient, we apply the \
function ",
 StyleBox[ButtonBox["N",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/N"], "FunctionLink"],
 ", so that the output will be given as decimals. It is common to apply ",
 StyleBox[ButtonBox["N",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/N"], "FunctionLink"],
 " in conjunction with the postfix operator (",
 StyleBox["//", "Input"],
 ").)"
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Reduce", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"n", "^", "2"}], "-", "n"}], ")"}], "/", "2"}], 
     "\[GreaterEqual]", "100"}], ",", "n"}], "]"}], "//", "N"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"n", "\[LessEqual]", 
   RowBox[{"-", "13.650971698084906`"}]}], "||", 
  RowBox[{"n", "\[GreaterEqual]", "14.650971698084906`"}]}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "This indicates that a stage of 14 is ",
 StyleBox["not enough",
  FontSlant->"Italic"],
 ". But it gives us a place to start guessing."
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ratsTo15", "=", 
   RowBox[{"listRationals", "[", "15", "]"}]}], ";"}]], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Length", "[", "ratsTo15", "]"}]], "Input"],

Cell[BoxData["71"], "Output"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"ratsto17", "=", 
   RowBox[{"listRationals", "[", "17", "]"}]}], ";"}]], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Length", "[", "ratsto17", "]"}]], "Input"],

Cell[BoxData["95"], "Output"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"ratsTo18", "=", 
   RowBox[{"listRationals", "[", "18", "]"}]}], ";"}]], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Length", "[", "ratsTo18", "]"}]], "Input"],

Cell[BoxData["101"], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ratsTo18", "[", 
  RowBox[{"[", "100", "]"}], "]"}]], "Input"],

Cell[BoxData[
 FractionBox["5", "13"]], "Output"]
}, Open  ]],

Cell[TextData[{
 "So the 100th rational, in the order specified by this particular algorithm, \
is ",
 Cell[BoxData[
  FormBox[
   FractionBox["5", "13"], TraditionalForm]]],
 "."
}], "Text"]
}, Open  ]],

Cell[CellGroupData[{

Cell["How Tight is the Bound?", "Subsubsection"],

Cell[TextData[{
 "We just saw how the formula ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     SuperscriptBox["n", "2"], "-", "1"}], "n"], TraditionalForm]]],
 " is an upper bound for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"F", "(", "n", ")"}], TraditionalForm]]],
 ", the number of positive rationals listed by the end of stage ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 ". We\[CloseCurlyQuote]ll conclude this section by exploring how good of a \
bound this is. In Section 2.3, we saw how to use the ",
 StyleBox[ButtonBox["Plot",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Plot"], "FunctionLink"],
 " function to graph functions. Let\[CloseCurlyQuote]s use that technique to \
graph the upper bound ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     SuperscriptBox["n", "2"], "-", "n"}], "2"], TraditionalForm]]],
 " from 1 to 100. Recall that the first argument to ",
 StyleBox[ButtonBox["Plot",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Plot"], "FunctionLink"],
 " is the function and the second is a list consisting of the name of the \
independent variable and the bounds."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"boundPlot", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"n", "^", "2"}], "-", "n"}], ")"}], "/", "2"}], ",", 
    RowBox[{"{", 
     RowBox[{"n", ",", "1", ",", "100"}], "}"}]}], "]"}]}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 GraphicsBox[{{}, {}, 
   {Hue[0.67, 0.6, 0.6], LineBox[CompressedData["
1:eJwVjHk41IkDhyfkijBuxi2EJtaRlnw/pNYxbtZXYmPVym5YyfFQJEcJRRQ6
