Cell["\<\
Functions for computing intersection and complement are similar and are left \
to the reader.\
\>", "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["Computer Projects 9", "Subsection",
 CellTags->"SolutionsCP9"],

Cell["Given a square matrix, determine whether it is symmetric.", "Problem"],

Cell[TextData[{
 StyleBox["Solution:",
  FontSlant->"Italic"],
 " We will create a function, ",
 StyleBox["symmetricQ", "Input"],
 ", that tests a matrix to see if it is symmetric. Recall that a matrix is \
symmetric when it is equal to its transpose. So we just need to use the ",
 StyleBox[ButtonBox["Equal",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Equal"], "FunctionLink"],
 " (",
 StyleBox["==", "Input"],
 ") operator to compare the matrix with the result of applying ",
 StyleBox[ButtonBox["Transpose",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Transpose"], "FunctionLink"],
 ". We will use ",
 StyleBox[ButtonBox["MatrixQ",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/MatrixQ"], "FunctionLink"],
 " to ensure that the argument to the function is in fact a matrix."
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"symmetricQ", "[", 
   RowBox[{"m_", "?", "MatrixQ"}], "]"}], ":=", 
  RowBox[{"m", "\[Equal]", 
   RowBox[{"Transpose", "[", "m", "]"}]}]}]], "Input",
 InitializationCell->True],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"symmetricExample", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "4", ",", "5"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "5", ",", "6"}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"symmetricExample", "//", "MatrixForm"}]}], "Input",
 InitializationCell->True],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"1", "2", "3"},
     {"2", "4", "5"},
     {"3", "5", "6"}
    },
    GridBoxAlignment->{
     "Columns" -> {{Center}}, "ColumnsIndexed" -> {}, "Rows" -> {{Baseline}}, 
      "RowsIndexed" -> {}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}, "RowsIndexed" -> {}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"symmetricQ", "[", "symmetricExample", "]"}]], "Input"],

Cell[BoxData["True"], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"notsymmetricExample", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "5", ",", "6"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"7", ",", "8", ",", "9"}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"notsymmetricExample", "//", "MatrixForm"}]}], "Input",
 InitializationCell->True],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"1", "2", "3"},
     {"4", "5", "6"},
     {"7", "8", "9"}
    },
    GridBoxAlignment->{
     "Columns" -> {{Center}}, "ColumnsIndexed" -> {}, "Rows" -> {{Baseline}}, 
      "RowsIndexed" -> {}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}, "RowsIndexed" -> {}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"symmetricQ", "[", "notsymmetricExample", "]"}]], "Input"],

Cell[BoxData["False"], "Output"]
}, Open  ]],

Cell[TextData[{
 "Note that ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " has a built-in function for checking whether a matrix is symmetric: ",
 StyleBox[ButtonBox["SymmetricMatrixQ",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/SymmetricMatrixQ"], "FunctionLink"],
 "."
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["Computations and Explorations 2", "Subsection",
 CellTags->"SolutionsCE2"],

Cell["Given a finite set, list all elements of its power set.", "Problem"],

Cell[TextData[{
 StyleBox["Solution:",
  FontSlant->"Italic"],
 " The ",
 StyleBox[ButtonBox["Subsets",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Subsets"], "FunctionLink"],
 " function was described in Section 2.1 above. We\[CloseCurlyQuote]ll write \
a function independent of this built-in command in order to see how such a \
command might be created."
}], "Text"],

Cell[TextData[{
 "Recall from Section 2.2 of the text that sets may be represented by bit \
strings. In particular, given a set, say ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "e"}], "}"}], 
   TraditionalForm]]],
 ", a subset may be represented by a string of 0s and 1s provided an order \
has been imposed on the set. For example, the string ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", ",", "1", ",", "1", ",", "0", ",", "0"}], TraditionalForm]]],
 " corresponds to the subset ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"b", ",", "c"}], "}"}], TraditionalForm]]],
 ". (Refer to the textbook for a complete explanation.)"
}], "Text"],

Cell["\<\
In terms of subsets, the bit string representation indicates that, for a \
given set, there is a one-to-one correspondence between subsets and bit \
strings. This means that we can solve the problem of listing all subsets of a \
given set by producing all corresponding bit strings.\
\>", "Text"],

Cell[TextData[{
 "To create the bit strings, we\[CloseCurlyQuote]ll follow the approach used \
in the function ",
 StyleBox["nextTA", "Input"],
 " from Section 1.3 of this manual. Given any bit string, the next string is \
obtained by working left to right: if a bit is 1, then it gets changed to a \
0. When you encounter a 0 bit, it is changed to a 1 and you stop the process. \
For example, suppose the current string is"
}], "Text"],

Cell[BoxData[
 FormBox[Cell["1,1,1,0,0,1,0"], TraditionalForm]], "Equation"],

Cell["\<\
You begin on the left changing the first three 1s to 0s. Then the fourth bit \
from the left is 0, so
this is changed to a 1 and the process stops. The new bit string is\
\>", "Text"],

Cell[BoxData[
 FormBox[Cell["0,0,0,1,0,1,0"], TraditionalForm]], "Equation"],

Cell[TextData[{
 "Here is the ",
 StyleBox["nextBitS", "Input"],
 " (next bit string) function. It accepts a bit string and implements the \
process described above to produce the next bit string. "
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"nextBitS", "[", "lastBitS_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"newBitS", ",", "i"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"newBitS", "=", "lastBitS"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Catch", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", 
         RowBox[{"i", "\[LessEqual]", 
          RowBox[{"Length", "[", "lastBitS", "]"}]}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"newBitS", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "\[Equal]", "1"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"newBitS", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "=", "0"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"newBitS", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "=", "1"}], ";", 
            RowBox[{"Throw", "[", "newBitS", "]"}]}]}], "\[IndentingNewLine]",
           "]"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"Throw", "[", "Null", "]"}]}], "\[IndentingNewLine]", 
      "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"nextBitS", "[", 
  RowBox[{"{", 
   RowBox[{"1", ",", "1", ",", "1", ",", "0", ",", "0", ",", "1", ",", "0"}], 
   "}"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0", ",", "0", ",", "1", ",", "0", ",", "1", ",", "0"}], 
  "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "Next we\[CloseCurlyQuote]ll need a way to convert a bit string into a \
subset of a given set. We can do this using a combination of the built-in \
function ",
 StyleBox[ButtonBox["Position",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Position"], "FunctionLink"],
 " and ",
 StyleBox[ButtonBox["Extract",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Extract"], "FunctionLink"],
 ". "
}], "Text"],

Cell[TextData[{
 "The ",
 StyleBox[ButtonBox["Position",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Position"], "FunctionLink"],
 " function accepts an expression (in this case the list representing the bit \
string) and a pattern (in this case 1) and returns a list of the positions \
within the expression at which you can find the pattern. For example, if we \
apply ",
 StyleBox[ButtonBox["Position",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Position"], "FunctionLink"],
 " to the bit string ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1", ",", "0", ",", "0", ",", "1", ",", "0"}],
     "}"}], TraditionalForm]]],
 " and 1, it indicates that the 1s occur in positions 1, 2, 3, and 6."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Position", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1", ",", "0", ",", "0", ",", "1", ",", "0"}],
     "}"}], ",", "1"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "1", "}"}], ",", 
   RowBox[{"{", "2", "}"}], ",", 
   RowBox[{"{", "3", "}"}], ",", 
   RowBox[{"{", "6", "}"}]}], "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "Note that the format of the output is designed to accommodate nesting in \
the expression being searched. Conveniently, the format is identical to what \
is expected by the function ",
 StyleBox[ButtonBox["Extract",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Extract"], "FunctionLink"],
 ". Recall that ",
 StyleBox[ButtonBox["Extract",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Extract"], "FunctionLink"],
 ", first described in Section 2.2 of this manual, will output the list of \
elements from the first argument specified by the second. (",
 StyleBox[ButtonBox["Extract",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Extract"], "FunctionLink"],
 " can also simultaneously apply a function to the result, but that feature \
is not needed here.)"
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Extract", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "\"\<a\>\"", ",", "\"\<b\>\"", ",", "\"\<c\>\"", ",", "\"\<d\>\"", ",", 
     "\"\<e\>\"", ",", "\"\<f\>\"", ",", "\"\<g\>\""}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"Position", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "1", ",", "1", ",", "1", ",", "0", ",", "0", ",", "1", ",", "0"}], 
      "}"}], ",", "1"}], "]"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"a\"\>", ",", "\<\"b\"\>", ",", "\<\"c\"\>", ",", "\<\"f\"\>"}],
   "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "We create a function, ",
 StyleBox["bitToSubset", "Input"],
 ", based on that approach."
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"bitToSubset", "[", 
   RowBox[{"bitS_", ",", "set_"}], "]"}], ":=", 
  RowBox[{"Extract", "[", 
   RowBox[{"set", ",", 
    RowBox[{"Position", "[", 
     RowBox[{"bitS", ",", "1"}], "]"}]}], "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{3.580645596974145*^9}],

Cell["\<\
We can now combine these two functions to compute the power set of a given \
set.\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"powerSet", "[", "set_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "bitS", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"bitS", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"Length", "[", "set", "]"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{"bitS", "=!=", "Null"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"bitToSubset", "[", 
          RowBox[{"bitS", ",", "set"}], "]"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"bitS", "=", 
         RowBox[{"nextBitS", "[", "bitS", "]"}]}], ";"}]}], 
      "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 InitializationCell->True],

Cell[TextData[{
 "We apply our function to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", "c"}], "}"}], TraditionalForm]]],
 " to confirm that it is functioning properly."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"powerSet", "[", 
  RowBox[{"{", 
   RowBox[{"\"\<a\>\"", ",", "\"\<b\>\"", ",", "\"\<c\>\""}], "}"}], 
  "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", "}"}]], "Print"],

Cell[BoxData[
 RowBox[{"{", "\<\"a\"\>", "}"}]], "Print"],

Cell[BoxData[
 RowBox[{"{", "\<\"b\"\>", "}"}]], "Print"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"a\"\>", ",", "\<\"b\"\>"}], "}"}]], "Print"],

Cell[BoxData[
 RowBox[{"{", "\<\"c\"\>", "}"}]], "Print"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"a\"\>", ",", "\<\"c\"\>"}], "}"}]], "Print"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"b\"\>", ",", "\<\"c\"\>"}], "}"}]], "Print"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"a\"\>", ",", "\<\"b\"\>", ",", "\<\"c\"\>"}], "}"}]], "Print"]
}, Open  ]]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Exercises", "Section",
 CellTags->"Exercises"],

Cell[TextData[{
 "Write a function ",
 StyleBox["disjointQ", "Input"],
 " that accepts two sets as arguments and returns true if the sets are \
disjoint and false otherwise."
}], "Item1Exercise"],

Cell[TextData[{
 "Write a function, ",
 StyleBox["cartesian", "Input"],
 ", to compute the Cartesian product of two sets as a single set."
}], "Item1Exercise"],

Cell[TextData[{
 "Write functions ",
 StyleBox["fuzzyIntersection", "Input"],
 " and ",
 StyleBox["fuzzyComplement", "Input"],
 " to complete Computer Project 3."
}], "Item1Exercise"],

Cell[TextData[{
 "Write procedures for computing the complement, union, intersection, \
difference, and sum for multisets. Represent a multiset as a set of pairs ",
 StyleBox["{a,m}", "Input"],
 " where ",
 StyleBox["m", "Input"],
 " is the multiplicity of the element ",
 StyleBox["a", "Input"],
 ". (Refer to the preamble to Exercise 61 in Section 2.2 for information \
about multisets.)"
}], "Item1Exercise"],

Cell["\<\
Write procedures to compute the image of a finite set under a function. \
Create one procedure for functions defined in the usual way and a second \
procedure for functions defined via indexed variables.\
\>", "Item1Exercise"],

Cell["\<\
Write a procedure to find the inverse of a function defined by an indexed \
variable.\
\>", "Item1Exercise"],

Cell["\<\
Write a procedure to find the composition of functions defined by indexed \
variables.\
\>", "Item1Exercise"],

Cell[TextData[{
 "Use computation to discover what the largest value of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " is for which ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "!"}], TraditionalForm]]],
 " has fewer than 1000 digits. (Hint: the ",
 StyleBox[ButtonBox["IntegerLength",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/IntegerLength"], "FunctionLink"],
 " command applied to an integer will return the number of digits of the \
integer.)"
}], "Item1Exercise"],

Cell[TextData[{
 "Write a function ",
 StyleBox["arithmeticSequence", "Input"],
 ", modelled on ",
 StyleBox["geometricSequence2", "Input"],
 " above, that produces an arithmetic sequence."
}], "Item1Exercise"],

Cell[CellGroupData[{

Cell["\<\
Find the first 20 terms of the sequences defined by the recurrence relations \
below\
\>", "Item1Exercise"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", "n"], "=", 
    RowBox[{
     RowBox[{"2", 
      SubscriptBox["a", 
       RowBox[{"n", "-", "1"}]]}], "+", 
     RowBox[{"3", 
      SubscriptBox["a", 
       RowBox[{"n", "-", "2"}]]}]}]}], TraditionalForm]]],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", "1"], "=", "1"}], TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", "2"], "=", "0"}], TraditionalForm]]],
 "."
}], "Item2Numbered"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", "n"], "=", 
    RowBox[{
     SubscriptBox["a", 
      RowBox[{"n", "-", "1"}]], "+", 
     RowBox[{"n", " ", 
      SubscriptBox["a", 
       RowBox[{"n", "-", "2"}]]}], "+", 
     RowBox[{
      SuperscriptBox["n", "2"], 
      SubscriptBox["a", 
       RowBox[{"n", "-", "3"}]]}]}]}], TraditionalForm]]],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", "1"], "=", "1"}], TraditionalForm]]],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", "2"], "=", "1"}], TraditionalForm]]],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", "3"], "=", "3"}], TraditionalForm]]],
 "."
}], "Item2Numbered"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", "n"], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["a", 
       RowBox[{"n", "-", "1"}]], "\[CenterDot]", 
      SubscriptBox["a", 
       RowBox[{"n", "-", "2"}]]}], "+", "1"}]}], TraditionalForm]]],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", "1"], "=", 
    RowBox[{
     SubscriptBox["a", "2"], "=", "1"}]}], TraditionalForm]]],
 "."
}], "Item2Numbered"]
}, Open  ]],

Cell[TextData[{
 "The Lucas numbers satisfy the recurrence ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["L", "n"], "=", 
    RowBox[{
     SubscriptBox["L", 
      RowBox[{"n", "-", "1"}]], "+", 
     SubscriptBox["L", 
      RowBox[{"n", "-", "2"}]]}]}], TraditionalForm]]],
 " and the initial conditions ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["L", "1"], "=", "2"}], TraditionalForm]]],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["L", "2"], "=", "2"}], TraditionalForm]]],
 ". Use ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " to gain evidence for conjectures about the divisibility of Lucas numbers \
by different integer divisors."
}], "Item1Exercise"],

Cell[TextData[{
 "Write a function to find the first ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " Ulam numbers and use the function to find as many Ulam numbers as you can. \
(Ulam numbers are defined in Exercise 28 of the Supplemental Exercises for \
Chapter 2.)"
}], "Item1Exercise"],

Cell[TextData[{
 "Use ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " to find formulas for the sum of the ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 "th powers of the first ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 " positive integers for ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 " up to 10."
}], "Item1Exercise"],

Cell[TextData[{
 "The calculation of ",
 StyleBox["dataTable", "Input"],
 " above is very inefficient, because ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " must calculate the entire list of rational numbers for each value from 2 \
to 100. Create a new function, ",
 StyleBox["listActuals", "Input"],
 ", that accepts a maximum stage as input and returns the list whose entries \
are the values of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"F", "(", "n", ")"}], TraditionalForm]]],
 ". You can do this by modifying ",
 StyleBox["listRationals", "Input"],
 " so that at the completion of each stage, the size of ",
 StyleBox["L", "Input"],
 ", i.e., the value ",
 Cell[BoxData[
  FormBox[
   RowBox[{"F", "(", "n", ")"}], TraditionalForm]]],
 ", is recorded in a list."
}], "Item1Exercise"],

Cell[TextData[{
 "Find a value ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]]],
 " so that the graph of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", "\[CenterDot]", 
    FractionBox[
     RowBox[{
      SuperscriptBox["n", "2"], "-", "n"}], "2"]}], TraditionalForm]]],
 " is just above the graph of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"F", "(", "n", ")"}], TraditionalForm]]],
 ". Use your ",
 StyleBox["listActuals", "Input"],
 " function to expand the data and refine the value of ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]]],
 "."
}], "Item1Exercise"],

Cell[TextData[{
 "Use ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " to find the hundredth positive rational number in the list generated by ",
 StyleBox["listRationals", "Input"],
 ". What about the thousandth? Ten thousandth? (If you completed it, the \
result of the previous exercise can be helpful.)"
}], "Item1Exercise"]
}, Closed]]
},
