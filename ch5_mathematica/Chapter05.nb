I9RjiH7EwCPUP3VV/Y9d1Xqmgcev4u9jwGfB565qvfNX9Xwy/9f/D6CaLx8=

        "]]}}, {}}, AspectRatio -> 
    NCache[GoldenRatio^(-1), 0.6180339887498948], Axes -> True, 
