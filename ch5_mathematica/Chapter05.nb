        "]]}}, {}}, AspectRatio -> 
    NCache[GoldenRatio^(-1), 0.6180339887498948], Axes -> True, 
    AxesLabel -> {None, None}, AxesOrigin -> {0, 0}, Method -> {}, 
    PlotRange -> {{0, 1500.}, {0, 0.004308}}, PlotRangeClipping -> True, 
    PlotRangePadding -> {{30., 30.}, {0.00008616, 0.00008616}}],
   TemplateBox[{"\"recursive\"", "\"iterative\""}, "PointLegend", 
    DisplayFunction -> (StyleBox[
      StyleBox[
       PaneBox[
        TagBox[
         GridBox[{{
            TagBox[
             GridBox[{{
